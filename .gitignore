# Build artifacts
*.obj
*.OBJ
*.o
*.lib
*.LIB
*.EXE
*.exe
# Exception: Clark's original reference binaries (tracked byte-exact)
!pcb1541/pcbic12/bin/*.EXE
!pcb1541/pcbic12/bin/*.exe
!pcb1541/install/reference/*.EXE
!toolkit/pplc/**/*.EXE
!toolkit/pplc/**/*.exe

# Local reverse-engineering scratch — one working folder at repo root,
# named by archive under /analysis/<archive>/. Never tracked.
# Explicit patterns cover the dir + everything under it (belt-and-suspenders).
/analysis/
/analysis/**
/analysis/*/
/analysis/*/*
*.MAP
*.map
*.ERR
*.err
*.i
*.lst

# Temp/backup
*~
*.bak
*.BAK
!attic/*.BAK
!attic/*.bak
*.tmp
*.TMP
*.swp
*.orig

# Third-party (clone separately)
OS2TK/
codebase-dbf/

# Large archives (available separately)
pcb153src0014.zip
pcb15everything.zip

# IDE/editor
.vscode/
.idea/
*.sublime-*

# Allow built binaries
!tools/qfront/bin/dos/*.exe
!tools/qfront/bin/dos/*.EXE
!bin/*.exe
!bin/*.EXE
!PCBSRC/MAIN/SOURCE/UTIL/*/*.exe
!PCBSRC/MAIN/SOURCE/UTIL/*/*.EXE
!dist/*.exe
!dist/*.EXE
!dist/*.ZIP
!dist/*.zip
!attic/*.exe
!attic/*.EXE
!attic/*.ZIP
!attic/*.zip


# Allow extracted-installer parity binaries under target/
!pcb1541/install/dist/target/**/*.EXE
!pcb1541/install/dist/target/**/*.exe
!pcb1541/install/dist/target/**/*.COM
!pcb1541/install/dist/target/**/*.com
!pcb1541/install/dist/target/**/*.DLL
!pcb1541/install/dist/target/**/*.dll
!pcb1541/install/dist/target/**/*.BIN
!pcb1541/install/dist/target/**/*.bin

# Allow extracted-installer parity list files under target/
# (needed because *.lst above matches case-insensitively on Windows/macOS Git,
#  which would otherwise silently drop BLT.LST, DIR.LST, DLPATH.LST files)
!pcb1541/install/dist/target/**/*.LST
!pcb1541/install/dist/target/**/*.lst
