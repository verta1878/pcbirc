@echo off
rem ============================================================================
rem  PCBoard 15.4 Source Build — DOS Build Script
rem  Builds 11 of 12 binaries using Borland C++ 3.1 under DOS/DOSBox
rem
rem  Prerequisites:
rem    - Borland C++ 3.1 installed at \B\C31
rem    - PCBoard 15.4 source tree at \PCBSRC
rem    - TASM 3.1 (included with BC31)
rem
rem  Usage: BUILD_DOS.BAT [target]
rem    Targets: ALL, PCBOARDM, LOCAL, PCBOARD, PPLC, PCBSM, MKPCBTXT,
rem             UUIN, UUOUT, UUUTIL, UUXFER, PCBSETUP
rem
rem  Output: \OUT\BIN\*.EXE
rem ============================================================================

if not exist \OUT\BIN mkdir \OUT\BIN

set BC31PATH=\B\C31
set BCROOT=\B\C31
set BCPGM=\B\C31\BIN
set INCLUDE=\B\C31\INCLUDE
set LIBPATH=\B\C31\LIB
set COMPILER=\B\C31\BIN\BCC.EXE
set LINKER=\B\C31\BIN\TLINK.EXE
set TLIB=\B\C31\BIN\TLIB.EXE
set MAKE=\B\C31\BIN\MAKE.EXE
set BCCOMPILER=bc31
set BC31=yes
set ASMROOT=\B\C31\BIN
set TASM=\B\C31\BIN\TASM.EXE
set LIBSDIR=..\..\LIB
set NODES=25
path=%path%;\B\C31\BIN

if "%1"=="" goto ALL
goto %1

:ALL
echo ============================================================================
echo  PCBoard 15.4 Full DOS Build
echo ============================================================================
call :PCBOARDM
call :LOCAL
call :PCBOARD
call :PPLC
call :PCBSM
call :MKPCBTXT
call :UUIN
call :UUOUT
call :UUUTIL
call :UUXFER
call :PCBSETUP
goto DONE

:PCBOARDM
echo.
echo --- PCBOARDM.EXE (Main BBS, 386+COMM) ---
cd \PCBSRC\MAIN
if exist 153\pcboard.cfg del 153\pcboard.cfg
if exist OBJ\BC31\*.OBJ del OBJ\BC31\*.OBJ
%MAKE% -f153\pcboard.mak -DNUMNODES=PCB_MAXNODES=%NODES% -DCOMM -DSTATS -DMP -D386 -DDBASE -DFIDO
if exist OBJ\BC31\PCBOARDM.EXE copy OBJ\BC31\PCBOARDM.EXE \OUT\BIN\PCBOARDM.EXE
goto :EOF

:LOCAL
echo.
echo --- LOCAL.EXE (Local Login, 386 no COMM) ---
cd \PCBSRC\MAIN
if exist 153\pcboard.cfg del 153\pcboard.cfg
if exist OBJ\BC31\*.OBJ del OBJ\BC31\*.OBJ
%MAKE% -f153\pcboard.mak -DNUMNODES=PCB_MAXNODES=%NODES% -DSTATS -DMP -D386 -DDBASE -DFIDO
if exist OBJ\BC31\PCBOARDM.EXE copy OBJ\BC31\PCBOARDM.EXE \OUT\BIN\LOCAL.EXE
goto :EOF

:PCBOARD
echo.
echo --- PCBOARD.EXE (Non-386 Overlay+COMM) ---
cd \PCBSRC\MAIN
if exist 153\pcboard.cfg del 153\pcboard.cfg
if exist OBJ\BC31\*.OBJ del OBJ\BC31\*.OBJ
%MAKE% -f153\pcboard.mak -DNUMNODES=PCB_MAXNODES=%NODES% -DCOMM -DSTATS -DMP -DDBASE -DFIDO
if exist OBJ\BC31\PCBOARDM.EXE copy OBJ\BC31\PCBOARDM.EXE \OUT\BIN\PCBOARD.EXE
goto :EOF

:PPLC
echo.
echo --- PPLC.EXE (PPL 3.40 Compiler) ---
cd \PCBSRC\MAIN
%MAKE% -f153\pplc.mak
if exist OBJ\PPL\PPLC.EXE copy OBJ\PPL\PPLC.EXE \OUT\BIN\PPLC.EXE
goto :EOF

:PCBSM
echo.
echo --- PCBSM.EXE (System Manager) ---
cd \PCBSRC\MAIN\SOURCE\UTIL\PCBSM
%MAKE% -fPCBSM.MAK
if exist BC31\PCBSM.EXE copy BC31\PCBSM.EXE \OUT\BIN\PCBSM.EXE
goto :EOF

:MKPCBTXT
echo.
echo --- MKPCBTXT.EXE (Text Generator) ---
cd \PCBSRC\MAIN\SOURCE\UTIL\PCBTEXT
%MAKE% -fPCBTEXT.MAK
if exist BC31\MKPCBTXT.EXE copy BC31\MKPCBTXT.EXE \OUT\BIN\MKPCBTXT.EXE
goto :EOF

:UUIN
echo.
echo --- UUIN.EXE (UUCP Import + REJECTS) ---
cd \PCBSRC\MAIN\SOURCE\UUCP\UUIN
if not exist BC31 mkdir BC31
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 UUIN.CPP
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 DECODE64.CPP
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 DECODEQ.CPP
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 DECODEM.CPP
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 REJECTS.CPP
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 ..\COMMON\PCBMSG.CPP
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 ..\COMMON\MSGBASE.CPP
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 ..\COMMON\UMWF.CPP
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 ..\COMMON\UUCP.CPP
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 ..\COMMON\EXPRTMSG.CPP
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 ..\COMMON\UUDECODE.CPP
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 ..\COMMON\UUSHWERR.CPP
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 ..\COMMON\VMDATA.CPP
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 ..\COMMON\VMDCLASS.CPP
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 ..\COMMON\DRESWORD.CPP
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 ..\COMMON\CI_OTHER.C
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 \PCBSRC\LIB\SOURCE\VMFUNCS.C
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 UUINSTUB.C
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 STBSTUB.CPP
\B\C31\BIN\BCC -c -ml -I\B\C31\INCLUDE;\PCBSRC\LIB\H -nBC31 \PCBSRC\MAIN\SOURCE\UTIL\PCBSM\EXTRAOBJ\KBDSTAT.C
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 \PCBSRC\LIB\SOURCE\MISC\STRIPB.C
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 \PCBSRC\LIB\SOURCE\MISC\STRIPA.C
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 \PCBSRC\LIB\SOURCE\MISC\VALIDATE.C
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 \PCBSRC\LIB\SOURCE\DOS\DOSFUGTS.C
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 \PCBSRC\LIB\SOURCE\MISC\DRIVEOK.C
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 \PCBSRC\LIB\SOURCE\MISC\VALIDSEM.C
\B\C31\BIN\BCC +UUIN154.CFG -c -ml -nBC31 \PCBSRC\LIB\SOURCE\MISC\SUBST.C
\B\C31\BIN\TASM /m /mx /ml PCBTHUNK.ASM,BC31\PCBTHUNK.OBJ
\B\C31\BIN\TLINK /c /x @UUIN_LNK.RSP
if exist BC31\UUIN.EXE copy BC31\UUIN.EXE \OUT\BIN\UUIN.EXE
goto :EOF

:UUOUT
echo.
echo --- UUOUT.EXE (UUCP Export) ---
cd \PCBSRC\MAIN\SOURCE\UUCP\UUOUT
if not exist BC31 mkdir BC31
\B\C31\BIN\BCC +UUOUT154.CFG -c -ml -nBC31 UUOUT.CPP
\B\C31\BIN\BCC +UUOUT154.CFG -c -ml -nBC31 ..\COMMON\PCBMSGS.CPP
\B\C31\BIN\BCC +UUOUT154.CFG -c -ml -nBC31 ..\COMMON\UUENCODE.CPP
\B\C31\BIN\BCC +UUOUT154.CFG -c -ml -nBC31 ..\COMMON\EXPRTMSG.CPP
\B\C31\BIN\BCC +UUOUT154.CFG -c -ml -nBC31 ..\COMMON\MSGBASE.CPP
\B\C31\BIN\BCC +UUOUT154.CFG -c -ml -nBC31 ..\COMMON\UMWF.CPP
\B\C31\BIN\BCC +UUOUT154.CFG -c -ml -nBC31 ..\COMMON\UUCP.CPP
\B\C31\BIN\BCC +UUOUT154.CFG -c -ml -nBC31 ..\COMMON\UUSHWERR.CPP
\B\C31\BIN\BCC +UUOUT154.CFG -c -ml -nBC31 ..\COMMON\VMDATA.CPP
\B\C31\BIN\BCC +UUOUT154.CFG -c -ml -nBC31 ..\COMMON\VMDCLASS.CPP
\B\C31\BIN\BCC +UUOUT154.CFG -c -ml -nBC31 ..\COMMON\DRESWORD.CPP
\B\C31\BIN\BCC +UUOUT154.CFG -c -ml -nBC31 \PCBSRC\LIB\SOURCE\VMFUNCS.C
\B\C31\BIN\BCC +UUOUT154.CFG -I..\UUIN -c -ml -nBC31 UUOUTSTB.CPP
\B\C31\BIN\TLINK /c /x @UUOUTLNK.RSP
if exist BC31\UUOUT.EXE copy BC31\UUOUT.EXE \OUT\BIN\UUOUT.EXE
goto :EOF

:UUUTIL
echo.
echo --- UUUTIL.EXE (UUCP Utilities) ---
cd \PCBSRC\MAIN\SOURCE\UUCP\UUUTIL
if not exist BC31 mkdir BC31
\B\C31\BIN\BCC +UTIL154.CFG -c -ml -nBC31 UUUTIL.CPP
\B\C31\BIN\BCC +UTIL154.CFG -c -ml -nBC31 FIDOCFG.CPP
\B\C31\BIN\BCC +UTIL154.CFG -c -ml -nBC31 ..\COMMON\CI_BUILD.C
\B\C31\BIN\BCC +UTIL154.CFG -c -ml -nBC31 ..\COMMON\CI_OTHER.C
\B\C31\BIN\BCC +UTIL154.CFG -c -ml -nBC31 ..\COMMON\UUCP.CPP
\B\C31\BIN\BCC +UTIL154.CFG -c -ml -nBC31 \PCBSRC\LIB\SOURCE\DOS\SHOWERR2.C
\B\C31\BIN\TLINK /c /x @UTILLNK.RSP
if exist BC31\UUUTIL.EXE copy BC31\UUUTIL.EXE \OUT\BIN\UUUTIL.EXE
goto :EOF

:UUXFER
echo.
echo --- UUXFER.EXE (UUCP Transfer) ---
cd \PCBSRC\MAIN\SOURCE\UUCP\UUXFER
if not exist BC31 mkdir BC31
\B\C31\BIN\BCC +XFER154.CFG -c -ml -nBC31 UUXFER.CPP
\B\C31\BIN\BCC +XFER154.CFG -c -ml -nBC31 GPROT.CPP
\B\C31\BIN\BCC +XFER154.CFG -c -ml -nBC31 COMMBUF.CPP
\B\C31\BIN\BCC +XFER154.CFG -c -ml -nBC31 ..\COMMON\UUCP.CPP
\B\C31\BIN\BCC +XFER154.CFG -c -ml -nBC31 ..\COMMON\UUSHWERR.CPP
\B\C31\BIN\BCC +XFER154.CFG -c -ml -nBC31 ..\COMMON\DRESWORD.CPP
\B\C31\BIN\BCC +XFER154.CFG -c -ml -nBC31 \PCBSRC\LIB\SOURCE\TOOLKIT\NOLOG.C
\B\C31\BIN\BCC +XFER154.CFG -c -ml -nBC31 \PCBSRC\LIB\SOURCE\TOOLKIT\NOSTATUS.C
\B\C31\BIN\BCC +XFER154.CFG -c -ml -nBC31 \PCBSRC\LIB\SOURCE\TOOLKIT\NODISP.C
\B\C31\BIN\BCC +XFER154.CFG -c -ml -nBC31 \PCBSRC\LIB\SOURCE\TOOLKIT\NOANSI.C
\B\C31\BIN\BCC +XFER154.CFG -c -ml -nBC31 NOTXT.C
\B\C31\BIN\BCC +XFER154.CFG -c -ml -nBC31 \PCBSRC\LIB\SOURCE\TOOLKIT\NOCHAT.C
\B\C31\BIN\BCC +XFER154.CFG -c -ml -nBC31 \PCBSRC\LIB\SOURCE\TOOLKIT\NOLANG.C
\B\C31\BIN\BCC +XFER154.CFG -c -ml -nBC31 \PCBSRC\LIB\SOURCE\TOOLKIT\NOPCBSYS.C
\B\C31\BIN\BCC +XFER154.CFG -c -ml -nBC31 \PCBSRC\LIB\SOURCE\TOOLKIT\NOSCREEN.C
\B\C31\BIN\BCC +XFER154.CFG -c -ml -nBC31 \PCBSRC\LIB\SOURCE\TOOLKIT\NOSHELL.C
\B\C31\BIN\BCC +XFER154.CFG -c -ml -nBC31 \PCBSRC\LIB\SOURCE\TOOLKIT\NOSYS.C
\B\C31\BIN\TLINK /c /x @XFERLNK.RSP
if exist BC31\UUXFER.EXE copy BC31\UUXFER.EXE \OUT\BIN\UUXFER.EXE
goto :EOF


:PCBSETUP
echo.
echo --- PCBSETUP.EXE (Setup Utility) ---
cd \PCBSRC\MAIN\SOURCE\UTIL\PCBSETUP
if not exist BC31 mkdir BC31
if not exist BC31\PCB mkdir BC31\PCB
if exist PCBSETUP.CFG del PCBSETUP.CFG
%MAKE% -fPCBSETUP.MAK
if exist BC31\PCBSETUP.EXE copy BC31\PCBSETUP.EXE \OUT\BIN\PCBSETUP.EXE
goto :EOF

:DONE
echo.
echo ============================================================================
echo  Build complete. 11 binaries in \OUT\BIN\
echo ============================================================================
dir \OUT\BIN\*.EXE
