; ====================================================================
; VSIO.DEF — Module definition for VSIO.SYS (OS/2 VDD)
; ====================================================================

LIBRARY VSIO

DESCRIPTION 'VSIO — Virtual Serial I/O Driver for OS/2 VDMs'

PROTMODE

SEGMENTS
    _TEXT   CLASS 'CODE'
    _DATA   CLASS 'DATA'

EXPORTS
    VDDInit
