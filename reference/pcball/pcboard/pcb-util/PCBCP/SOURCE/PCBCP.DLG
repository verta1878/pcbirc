DLGINCLUDE 1 "dlg.h"

BITMAP IDR_BITMAP "prodinfo.bmp"

DLGTEMPLATE IDD_PRODUCTINFO
BEGIN
  DIALOG "Product information", IDD_PRODUCTINFO, 9, 17, 276, 137, FS_NOBYTEALIGN | FS_DLGBORDER |
         WS_VISIBLE | WS_CLIPSIBLINGS | WS_SAVEBITS, FCF_TITLEBAR | FCF_SYSMENU
  BEGIN
    CONTROL IDR_BITMAP, IDC_BITMAP, 111, 76, 21, 21, WC_STATIC, SS_BITMAP | WS_GROUP | WS_VISIBLE
    CTEXT "Copyright (C) 1996 Clark Development Company, Inc", 256, 7, 54, 255, 8
    CTEXT "PCBoard is a registered trademark of", 258, 7, 44, 255, 8
    CTEXT "Clark Development Company, Inc.", 257, 7, 34, 255, 8
    DEFPUSHBUTTON "OK", IDC_OK, 111, 8, 45, 15
  END
END
