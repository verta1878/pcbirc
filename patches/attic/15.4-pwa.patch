+
+  {
+    cPTINFO PT;
+      PT.updateUsers();
+      PT.delOldUsers();
+  }
+
+  fillMans();
+  while(user > 0)
+  {
+    cls();
+    user = selectuser();
+    if(user > 0) regUser(user-1);
+  }
+
+}
