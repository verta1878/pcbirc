+#ifdef BOUNCE
+
+static char * near pascal getMsgLine(char * b, int s)
+{
+    static char * buf  = NULL;
+    static int    size = 0;
+           char * p    = NULL;
+
+    if (b)
+        p = buf = b,
+        size = s;
+    else if (!buf)
+        return NULL;
+    else
+        *buf = LineSeparator,
+        p = buf+1;
+
+    buf = (char *) memchr(p,LineSeparator,size);
+
+    if (buf)
+    {
+        *buf = NUL;
+        size -= int(buf-p+1);
+    }
+    else
+        p = NULL;
+
+    return p;
+}
+
+static char * near pascal getMsgLine(cTMPMSG * m)
+{
+    static cTMPMSG * _m = NULL;
+    if (m)
+    {
+        _m = m;
+        _m->resetLine();
+    }
+    char * p = (_m ? _m->getLine() : NULL);
+    if (!p) _m = NULL;
+    return p;
+}
