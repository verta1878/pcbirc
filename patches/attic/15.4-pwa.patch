+#define bigger(x,y) if (x < y) x = y;
+
+static void near pascal fixnum(double *x) {
+  char *p = (char *) x;
+
+  // the following pattern has been spotted a few times, the code below
+  // detects it and resets it to 0.
+  if (memcmp(p,"\0\0\0\0\0\0\xF8\xFF",8) == 0) {
+    *x = 0;
+    DataChanged = TRUE;
+  }
+
+  if (*x > 10000000000.0) {
+    *x = 0;
+    DataChanged = TRUE;
+  }
+}
