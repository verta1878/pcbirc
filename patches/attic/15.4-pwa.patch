+
+    va_list args;
+    va_start(args,str);
+
+    do {
+
+        rv = puts(str?str:"");
+        str = va_arg(args,const char *);
+
+    } while ((rv == 0) && (str != NULL));
+
+    va_end(args);
+
+    return rv;
+}
