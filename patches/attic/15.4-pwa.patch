+static int near pascal chksum(unsigned char * s, int n)
+{
+    short sum;
+    unsigned short t;
+    short x;
+
+    sum = -1;
+    x = 0;
+
+    do {
+
+        if (sum < 0)
+        {
+            sum <<= 1;
+            ++sum;
+        }
+        else
+        {
+            sum <<= 1;
+        }
+
+        t = sum;
+        sum += *(s++) & 0377;
+        x += sum ^ n;
+        if ((unsigned short)sum <= t)
+            sum ^= x;
+
+    } while (--n > 0);
+
+    return sum;
+}
