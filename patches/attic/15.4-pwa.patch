+void static near pascal processArgs(int numargs, char ** args)
+{
+
+  unsigned int i = 0;
+
+  for(i=0;i<numargs;i++)
+  {
+        if(strcmpi("/CONVERT",args[i]) == 0) convert();
+  }
+
+  for(i=0;i<numargs;i++)
+  {
