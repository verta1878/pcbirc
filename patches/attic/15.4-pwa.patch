+         editclass(Title,Size,Top,Bottom,Left,Right,Columns,NumKeys) { }
+
+    void pascal newrecord(void *Rec) { editclass::newrecord(Rec); }
+    void pascal loadrecords(DOSFILE *File);
+    void pascal saverecords(DOSFILE *File);
