+struct sMSGINFO
+{
+    char     processed;
+    unsigned date;
+    char     all;
+    char     stat;
+    char     fileName        [  12 + 1 ];
+    char     isEncoded;
+    char     beginFound;
+    char     endFound;
+    char     subject         [ 120 + 1 ];
+    int      subjLen;
+    int      partNum;
+    int      totParts;
+ // char     nhapparentlyto  [ 120 + 1 ];
+ // char     nhdate          [ 120 + 1 ];
