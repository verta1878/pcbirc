+static void near pascal runprogram(char *Program) {
+  char Path[66];
+  char Params[256];
+
+  sprintf(Params,"/FILE:%s /RELOAD:%s",DatFile,_argv[0]);
+
+  strcpy(Path,Program);
+  if (srchpath(Path) != -1) {
+    exitfunctions();
+    execl(Path,Path,Params,NULL); //lint !e534
+    exit(1);
+  }
+}
