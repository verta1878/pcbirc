+$(OBJDIR)\$(PROGNAME)
+                # no map file
+$(LIBLIB)\dos_$(MDL).lib+
+$(LIBLIB)\doscls_$(MDL).lib+
+$(LIBLIB)\pcb_$(MDL).lib+
