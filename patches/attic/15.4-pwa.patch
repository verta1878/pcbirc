+        /*------------------------------------------------------------*/
+
+/*
+XQT
+~~~
+U uucp lcars
+F D.lcars0014
+I D.lcars0014
+C rnews
+*/
+
+    file.open(xqtName,OPEN_WRIT|OPEN_DENYRDWR|OPEN_CREATE);
+
+    buildstr(buf,"U uucp ",PcbData.uucpName,NULL);
+    file.putuln(buf);
+    sprintf(buf,"F D.%1.7s%s",PcbData.uucpName,base);
+    file.putuln(buf);
+    buf[0] = 'I';
+    file.putuln(buf);
+
+    strcpy(buf,"C ");
