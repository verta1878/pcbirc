+class editmodclass : public editclass {
+  public:
+    editmodclass(char *Title, unsigned Size, int Top, int Bottom, int Left, int Right, int Columns, int NumKeys) :
+         editclass(Title,Size,Top,Bottom,Left,Right,Columns,NumKeys) { }
