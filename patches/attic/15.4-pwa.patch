+    /*--------------------------------------------------------------------*/
+
+#if defined(LIB) && !defined(QUIET_BUILD)
+
+#include    <conio.h>
+#include <screen.h>
+
+void pascal fastprint(int x, int y, char * s, int a)
+{
+    int tx = wherex();
+    int ty = wherey();
+    gotoxy(x+1,y+1);
+    textattr(a);
+    cputs(s);
+    gotoxy(tx,ty);
+}
+
+#endif
