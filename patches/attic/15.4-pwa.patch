+long pascal calcconfsize(unsigned NumAreas) {
+  ConfByteLen = (NumAreas >> 3) + ((NumAreas & 0x07) != 0 ? 1 : 0);
+  if (ConfByteLen < 5)
+    ConfByteLen = 5;
+  ExtConfLen = ConfByteLen - 5;
+
+  if (NumAreas > 40)
+    NumAreas -= 40;
+  else
+    NumAreas = 0;
+
+  return(((long) sizeof(long) * NumAreas) + (long)ExtConfLen*3 + ConfByteLen + ConfByteLen);
+}
