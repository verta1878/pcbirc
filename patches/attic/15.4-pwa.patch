diff -ruN p153full/SOURCE/MISC/HELP/MAKEHELP.C p154full/SOURCE/MISC/HELP/MAKEHELP.C
--- p153full/SOURCE/MISC/HELP/MAKEHELP.C	1970-01-01 00:00:00.000000000 +0000
+++ p154full/SOURCE/MISC/HELP/MAKEHELP.C	2026-08-25 15:07:35.903365312 +0000
@@ -0,0 +1,250 @@
+/*!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!*/
+/* The source code in this module is proprietary software belonging to       */
+/* Clark Development Company and is part of the PCBoard source code library. */
+/* You are granted the right to use this source code for the building of any */
+/* of the PCBoard products you have licensed.  Any other usage is forbidden  */
