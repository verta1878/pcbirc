+void pascal addpcboardtpa(void) {
+  Removed    = FALSE;
+  AddingPSAs = TRUE;
+  menusel(8,PSAMENU,SMALL,0,TRUE);
+  AddingPSAs = FALSE;
+  setpsaorder();
+}
+
+
+void pascal removepcboardtpa(void) {
+  Removed    = FALSE;
+  AddingPSAs = FALSE;
+  menusel(8,PSAMENU,SMALL,0,TRUE);
+  setpsaorder();
+}
