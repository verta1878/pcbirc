+        if(strcmpi("/MAINT",args[i])   == 0) maintain();
+        if(strcmpi("/ANALIZE",args[i]) == 0) analize();
+        if(strcmpi("/HELP",args[i])== 0 || strcmpi("?",args[i])== 0 || strcmpi("/?",args[i])==0) printCommandHelp();
