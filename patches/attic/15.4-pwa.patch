+  if (PortNum <= 2 || Driver == 'C' || Driver == 'F' || Driver == 'O')
+    return(0);
+
+  if (PortNum >= 3 && PortNum <= 8) {
+    boxcls(44,7,77,9,Colors[OUTBOX],SINGLE);
