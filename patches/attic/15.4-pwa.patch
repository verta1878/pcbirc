+    if (LastFind == SEARCHNAM)
+      Temp = finduser(SrchName);
+    else
+      Temp = searchforrec(LastFind,FALSE);
+
+    #ifdef DEMO
+      if (Temp > 10)
+        Temp = -1;
+    #endif
+
+    if (Temp > 0)
+      RecNum = Temp;
+    else
+      beep();
+  }
+
+  return(LastFind == SEARCHNAM && Temp != 0 && RecNum == Temp);
+}
