+static int near pascal doSystem(char * cmd)
+{
+    text_info ti;
+    gettextinfo(&ti);
+
+    gettext(1,1,ti.screenwidth,ti.screenheight,buf);
+
+    conscr << setattr(0x07);
+    conscr.clrscr();
+    conscr << "Swapping: " << cmd << endl;
+
+    uninstallhandlers();
+    VMEMSStateSave();
+    system(cmd);
+    VMEMSStateRestore();
+    reinstallhandlers();
+
+    conout3 << setxy(ti.curx,ti.cury);
+    puttext(1,1,ti.screenwidth,ti.screenheight,buf);
+
+    return 0;
+}
