+*
+*  Desc    :
+*
+*  Calls   :
+*/
+
+void near pascal checkname(char *Dest, char *Name, char *Ext) {
+  char Temp[66];
+  char *p;
+
+  strcpy(Dest,Name);
+  strcat(Dest,Ext);
+  strcpy(Temp,Dest);
+  if (srchpath(Temp) != -1)
+    strcpy(Dest,Temp);
+  else {
+    strcpy(Dest,_argv[0]);
+    if ((p = strrchr(Dest,'\\')) != NULL)
+      strcpy(p+1,Temp);
+    else {
+      strcpy(Dest,Name);
+      strcat(Dest,Ext);
+    }
+  }
+}
