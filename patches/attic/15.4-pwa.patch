+  _AL = Srce[7];
+  _CH = Srce[0];
+  _CL = Srce[1];
+  _DH = Srce[3];
+  _DL = Srce[4];
+  Dest[0] = _AH;
+  Dest[1] = _AL;
+  Dest[2] = _CH;
+  Dest[3] = _CL;
+  Dest[4] = _DH;
+  Dest[5] = _DL;
