+/****************************************************************************
+* CONVERT.CPP
+* Written by:Stan Paulsen
+* Copyright Clark Development 1995
+* This is a utility to convert the file PCBFIDO.CFG into component parts
+* March 1995: Convert from version 2 to version 3
+*****************************************************************************/
+#include <iostream.h>
+#include <string.h>
+// #include <conio.h>
+#include <stdio.h>
+
+#include <types.hpp>
