+#if defined(_MSC_VER) || defined(__WATCOMC__)
+  #include <direct.h>
+  #define df_bsec   bytes_per_sector
+  #define df_sclus  sectors_per_cluster
+  #define df_total  total_clusters
+  #define df_avail  avail_clusters
