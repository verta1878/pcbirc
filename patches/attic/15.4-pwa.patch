+static void near pascal getindexname(char *IndexFileName, char Letter) {
+  if (Letter <= 'A')
+    FileName[7] = 'A';
+  else if (Letter >= 'Z')
+    FileName[7] = 'Z';
+  else
+    FileName[7] = Letter;
+
+  strcpy(IndexFileName,PcbData.NdxLoc);
+  strcat(IndexFileName,FileName);
+}
