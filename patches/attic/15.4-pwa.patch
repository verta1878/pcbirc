+        if (rec.Name[0] == NUL)
+        {
+            cout << endl << "Inserting (" << f.field[0] <<
+                ") as conference " << conf << " ...";
+
+            getconfrecord(tConf,&rec);
+
+            memset(rec.Name,0,sizeof(rec.Name));
+            strcpy(rec.Name,name);
+
+         // rec.PublicConf       = TRUE;
+         // rec.AutoRejoin       = FALSE;
+         // rec.ViewMembers      = FALSE;
