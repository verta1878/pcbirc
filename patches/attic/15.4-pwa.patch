         qint ( void );
 
+#if !defined(__386__) && !defined(__FLAT__)
         qint ( int           i );
         qint ( unsigned int  u );
+#endif
         qint ( long          l );
         qint ( unsigned long u );
 
@@ -58,13 +60,16 @@
         int  operator >= ( qint & tr ) { return (!(*this < tr)); }
 #endif
 
+#if !defined(__386__) && !defined(__FLAT__)
         int  operator == ( int tr ) { return (*this == qint(tr)); }
