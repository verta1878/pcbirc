+*/
+
+void pascal yymmddtostr(char Dest[], const char Srce[]) {
+  _AH = Srce[2];
+  _AL = Srce[3];
+  _CH = Srce[4];
+  _CL = Srce[5];
+  _DH = Srce[0];
+  _DL = Srce[1];
+  Dest[0] = _AH;
+  Dest[1] = _AL;
+  Dest[3] = _CH;
+  Dest[4] = _CL;
+  Dest[6] = _DH;
+  Dest[7] = _DL;
+  Dest[5] = '-';
+  Dest[2] = '-';
+  Dest[8] = 0;
+}
