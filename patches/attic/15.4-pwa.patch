+/******************************************************************************/
+
+#include    <stdio.h>
+#include    <string.h>
+
+#include    <dosfunc.h>
+#include    <misc.h>
+
+#include    <newdata.h>
+#include    <cnameidx.h>
+
+#ifdef DEBUG
+#include    <memcheck.h>
