+static void _NEAR_ LIBENTRY getdays2(char *Days, char *Str) {
+  int X;
+
+  for (X = 0, *Days = 0; *Str != 0 && X < 7; X++, Str++) {
+    if (*Str == 'Y')
+      *Days += (char) (1 << X);
+  }
