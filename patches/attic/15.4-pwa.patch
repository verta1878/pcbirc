+
+        int  pascal readrec  ( void ) { return getln(line,sizeof(line)); }
+ //     void pascal unfmt    ( void ) = 0;
+ //     void pascal fmt      ( void ) = 0;
+        int  pascal writerec ( void ) { return putln(line); }
