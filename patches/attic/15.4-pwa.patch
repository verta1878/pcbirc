+    maxDataSize >> 5, // kDBSTable[ k128] =  128
+    maxDataSize >> 4, // kDBSTable[ k256] =  256
+    maxDataSize >> 3, // kDBSTable[ k512] =  512
+    maxDataSize >> 2, // kDBSTable[k1024] = 1024
+    maxDataSize >> 1, // kDBSTable[k2048] = 2048
+    maxDataSize >> 0, // kDBSTable[k4096] = 4096
+    0
+};
