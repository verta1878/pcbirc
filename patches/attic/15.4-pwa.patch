+         // rec.MsgBlocks        = 1;
+
+            if (!fidoSetNames)
+                mangleFNameToPath(f.field[0],rec.MsgFile);
+
+         // char UserMenu[32];
+         // char SysopMenu[32];
+         // char NewsFile[32];
