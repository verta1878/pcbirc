+   #ifdef S4LOCK_HASH
+   class Lock4 : public Single4lock, public Single4hash
+   #else
+   class Lock4 : public Single4lock
+   #endif
+   {
+   public:
+      #ifdef S4SERVER
+         long clientId ;
+      #endif
+      struct DATA4St *data ;
+      long recNum ;
+      #ifndef S4CLIENT
+         Lock4type lockType ;   // either LOCK4READ or LOCK4WRITE
+      #endif
+   } ;
