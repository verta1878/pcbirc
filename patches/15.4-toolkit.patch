+ * pcbrevival Phase 0, August 2026
+ */
+
+#ifndef D4ALL_INC
+#define D4ALL_INC
+
+#include <stdlib.h>
+#include <string.h>
+
+/* Opaque structs — internal layout not needed by PCBoard code */
+typedef struct CODE4_s {
+    int  errorCode;
+    int  accessMode;
+    int  readOnly;
+    int  safety;
+    int  autoOpen;
+    int  exclusive;
+    char reserved[256];
+} CODE4;
+
+typedef struct DATA4_s {
+    char alias[64];
+    int  recCount;
+    int  recNo;
+    int  bof_flag;
+    int  eof_flag;
+    char reserved[256];
+} DATA4;
+
+typedef struct FIELD4_s {
+    char name[11];
+    char type;
+    int  len;
+    int  dec;
+    char reserved[32];
+} FIELD4;
+
+typedef struct {
+    char  *name;
+    short type;
+    short len;
+    short dec;
+} FIELD4INFO;
+
+typedef struct {
+    char *name;
+    char *expression;
+    char *filter;
+    char *descending;
