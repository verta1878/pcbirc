+// AS Jan 19/07 - create a u4sleep() which will delay a short period (fix problem when CodeBase run as a high-priority thread)
+// always wait at least 1/100th of a second (value of 10)
+// AS Apr 5/07 - adjust...if the calling thread is not high priority we don't need to sleep
+// #define u4sleep( duration ) (Sleep(( (duration) == 0 ) ? 10 : ( duration )))
+// if c4 is not put in, just assume don't need to delay
+// AS Apr 13/07 - fix for non-win32
+#ifdef S4WIN32
+   #define u4sleep( c4 ) (((c4) == 0 ) ? Sleep( 0 ) : ( ((c4)->highPriority == 1 ) ? Sleep( 10 ) : Sleep( 0 ) ))
+#else
+   #define u4sleep( c4 ) Sleep( 0 )
+#endif
