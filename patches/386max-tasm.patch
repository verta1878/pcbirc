-FLEXROMINT_SRC	 dw	 ?	; Segment of ROM before being FLEXed
-
-FLEXROMINT_STR	 ends		; End FLEXROMINT_STR structure
-
-@FLEXROMINT_STRLEN equ	 size FLEXROMINT_STR ; Size of above structure
-
