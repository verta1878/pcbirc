-	 mov	 es:[ebx].DPMI_FLT32A_REIP,PMFLPM ; Our return EIP
-	 push	 DPMI_IDEF	; Get our interrupt selector
-	 pop	 es:[ebx].DPMI_FLT32A_RCS.ELO ; ... CS
-
