-
-FLEXROMINT_STR	 struc		; Structure for interrupt relocation
-
-FLEXROMINT_NUM	 dw	 ?	; Interrupt # times 4
-FLEXROMINT_FLAG  dw	 ?	; Flags
-FLEXROMINT_FIND  dd	 ?	; Action routine to find BIOS entry point
