-	 mov	 eax,es:[ebx].DPMI_FLT10_EIP ; Get EIP
-
-	 cmp	 eax,[esp+(size DPMI_FLTRET_STR)].INTDPF_EIP ; Izit the same?
-	 je	 short @F	; Jump if so
