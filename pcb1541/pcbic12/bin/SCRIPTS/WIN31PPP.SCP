# Script file for Trumpet Winsock, Version 2.x
#
# Design:  This script is designed to dial into a PCBoard system and select
#          either the SLIP language or the PPP option.  The option selected
#          depends on the variable set at the top of this file.
#
# Variables:  Since the bulk of this script is ready to go except for your
#             information, we have put those variables at the top of the
#             script for you to find and change quickly.
#

  $username = "first last"
  $password = "password"
  $phonenum = "555-1212"
  $langnum  = "3"

#The prompts we watch for are also set in variables in case those need to
#be changed too.

$langprompt = "anguage"
$userprompt = "name"
$passprompt = "assword"
$grafprompt = "graphics"
$addrtarg   = "IP address"
#
# Display information about who we are trying to connect and under what account.
#
display ****************************************************\n
display Calling $phonenum\n
display Using the name $username\n
display ****************************************************\n
#
# initialize modem and dial the BBS number
#
output atz\r
input 10 OK
output atdt$phonenum\r
#
# wait for the modems to connect
#
if ![input 60 CONNECT]
   display \n
   display ****************************************\n
   display * Unable to connect with the provider. *\n
   display ****************************************\n
   abort
end
#
#  wait till it's safe to send because some modem's hang up
#  if you transmit during the connection phase
#
wait 60 dcd
#
#  wait for language prompt
#
input 30 $langprompt
output $langnum\13
#
#  wait for: "Do you want graphics (Enter)=default?"
#
input 45 $grafprompt
output n;q;ns\r
#
# wait for first name prompt (send name and password)
#
input 30 $userprompt
output $username $password\r
#
# wait for pasword prompt
#
#input 10 $passprompt
#output $password\r
#
#
# wait for the SLIP door header information to be displayed.
#
# send an "N<cr>" to take care of any More or press Enter to continue prompts.
#

%attempts = 1
%maxattempts = 4

while ![input 10 Reserved.]
      
   output n\n
   
   if %attempts = %maxattempts - 1
     
     display \n
     display ******************************************************\n
     display * The SLIP/PPP door is not functioning.  Aborting... *\n
     display ******************************************************\n
     
     # drop carrier     
     
     set dtr off
     sleep 1
     set dtr on
   
   end
   
   %attempts = %attempts + 1

end

# If SLIP (not PPP) is selected, parse the input for the address and go online.
   
if !%ppp
  #
  # wait for: the word "address"
  # then grab the IP address that follows.
  #
  display \nWaiting for SLIP Address Information\n
  input 30 $addrtarg
  address 30
  online
end
