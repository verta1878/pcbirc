@echo off
REM MKLIB.BAT <LIBNAME> <CC> <COMPDIR>
REM   e.g. MKLIB PCBKBC BC bc31
REM        MKLIB PCBKIT TC tc201
REM        MKLIB PCBKMS MS msc70
REM Builds each model lib from 8.3-named response files (2 chunks each),
REM then copies to OUT\LIB\PWA153\<COMPDIR>\ (Clark convention: LIB at compiler root).
set LIBNAME=%1
set CC=%2
set COMPDIR=%3
set PATH=C:\BC31\BIN;%PATH%
set OUTDIR=C:\OUT\LIB\PWA153\%COMPDIR%
if not exist %OUTDIR% md %OUTDIR%
echo   Building %LIBNAME%S.LIB ...
if exist C:\TMPLIB.LIB del C:\TMPLIB.LIB
TLIB.EXE C:\TMPLIB.LIB @C:\BUILD\SCRIPTS\%CC%SA.RSP
TLIB.EXE C:\TMPLIB.LIB @C:\BUILD\SCRIPTS\%CC%SB.RSP
if exist %OUTDIR%\%LIBNAME%S.LIB del %OUTDIR%\%LIBNAME%S.LIB
copy C:\TMPLIB.LIB %OUTDIR%\%LIBNAME%S.LIB > NUL
del C:\TMPLIB.LIB
echo   Building %LIBNAME%M.LIB ...
if exist C:\TMPLIB.LIB del C:\TMPLIB.LIB
TLIB.EXE C:\TMPLIB.LIB @C:\BUILD\SCRIPTS\%CC%MA.RSP
TLIB.EXE C:\TMPLIB.LIB @C:\BUILD\SCRIPTS\%CC%MB.RSP
if exist %OUTDIR%\%LIBNAME%M.LIB del %OUTDIR%\%LIBNAME%M.LIB
copy C:\TMPLIB.LIB %OUTDIR%\%LIBNAME%M.LIB > NUL
del C:\TMPLIB.LIB
echo   Building %LIBNAME%C.LIB ...
if exist C:\TMPLIB.LIB del C:\TMPLIB.LIB
TLIB.EXE C:\TMPLIB.LIB @C:\BUILD\SCRIPTS\%CC%CA.RSP
TLIB.EXE C:\TMPLIB.LIB @C:\BUILD\SCRIPTS\%CC%CB.RSP
if exist %OUTDIR%\%LIBNAME%C.LIB del %OUTDIR%\%LIBNAME%C.LIB
copy C:\TMPLIB.LIB %OUTDIR%\%LIBNAME%C.LIB > NUL
del C:\TMPLIB.LIB
echo   Building %LIBNAME%L.LIB ...
if exist C:\TMPLIB.LIB del C:\TMPLIB.LIB
TLIB.EXE C:\TMPLIB.LIB @C:\BUILD\SCRIPTS\%CC%LA.RSP
TLIB.EXE C:\TMPLIB.LIB @C:\BUILD\SCRIPTS\%CC%LB.RSP
if exist %OUTDIR%\%LIBNAME%L.LIB del %OUTDIR%\%LIBNAME%L.LIB
copy C:\TMPLIB.LIB %OUTDIR%\%LIBNAME%L.LIB > NUL
del C:\TMPLIB.LIB
echo   Libraries built in %OUTDIR%:
dir %OUTDIR%\%LIBNAME%?.LIB
