@echo off
REM MKLIB.BAT <LIBNAME> <CC>   where CC = BC (Borland), TC (Turbo C), MS (MSC)
REM   e.g. MKLIB PCBKIT TC
REM Builds each model lib from 8.3-named response files (2 chunks each),
REM then copies to OUT\LIB\PWA153.
set LIBNAME=%1
set CC=%2
set PATH=C:\BC31\BIN;%PATH%
set OUTDIR=C:\OUT\LIB\PWA153
echo   Building %LIBNAME%_S.LIB ...
if exist C:\TMPLIB.LIB del C:\TMPLIB.LIB
TLIB.EXE C:\TMPLIB.LIB @C:\BUILD\SCRIPTS\%CC%SA.RSP
TLIB.EXE C:\TMPLIB.LIB @C:\BUILD\SCRIPTS\%CC%SB.RSP
if exist %OUTDIR%\%LIBNAME%_S.LIB del %OUTDIR%\%LIBNAME%_S.LIB
copy C:\TMPLIB.LIB %OUTDIR%\%LIBNAME%_S.LIB > NUL
del C:\TMPLIB.LIB
echo   Building %LIBNAME%_M.LIB ...
if exist C:\TMPLIB.LIB del C:\TMPLIB.LIB
TLIB.EXE C:\TMPLIB.LIB @C:\BUILD\SCRIPTS\%CC%MA.RSP
TLIB.EXE C:\TMPLIB.LIB @C:\BUILD\SCRIPTS\%CC%MB.RSP
if exist %OUTDIR%\%LIBNAME%_M.LIB del %OUTDIR%\%LIBNAME%_M.LIB
copy C:\TMPLIB.LIB %OUTDIR%\%LIBNAME%_M.LIB > NUL
del C:\TMPLIB.LIB
echo   Building %LIBNAME%_C.LIB ...
if exist C:\TMPLIB.LIB del C:\TMPLIB.LIB
TLIB.EXE C:\TMPLIB.LIB @C:\BUILD\SCRIPTS\%CC%CA.RSP
TLIB.EXE C:\TMPLIB.LIB @C:\BUILD\SCRIPTS\%CC%CB.RSP
if exist %OUTDIR%\%LIBNAME%_C.LIB del %OUTDIR%\%LIBNAME%_C.LIB
copy C:\TMPLIB.LIB %OUTDIR%\%LIBNAME%_C.LIB > NUL
del C:\TMPLIB.LIB
echo   Building %LIBNAME%_L.LIB ...
if exist C:\TMPLIB.LIB del C:\TMPLIB.LIB
TLIB.EXE C:\TMPLIB.LIB @C:\BUILD\SCRIPTS\%CC%LA.RSP
TLIB.EXE C:\TMPLIB.LIB @C:\BUILD\SCRIPTS\%CC%LB.RSP
if exist %OUTDIR%\%LIBNAME%_L.LIB del %OUTDIR%\%LIBNAME%_L.LIB
copy C:\TMPLIB.LIB %OUTDIR%\%LIBNAME%_L.LIB > NUL
del C:\TMPLIB.LIB
echo   Libraries built:
dir %OUTDIR%\%LIBNAME%_?.LIB
