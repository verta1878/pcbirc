@ECHO OFF
REM MAXBLD1.BAT - Preprocess only (Phases 0-5). Run first.
SET MAX_SRC=C:\386MAX_S
SET MAX_KERN=%MAX_SRC%\KERNEL
SET MAX_INC=%MAX_SRC%\INC
SET MAX_XFORM=%MAX_SRC%\XFORM
SET MAX_XINC=%MAX_SRC%\XINC
SET MAX_OBJ=%MAX_SRC%\OBJ
SET AWK=C:\FDOS\BIN\GAWK.EXE
SET SED=C:\FDOS\BIN\SED.EXE
SET SYMPATH=C:/386MAX_S/XFORM/SYMSIZE.TXT

IF EXIST %MAX_XFORM%\NUL DEL %MAX_XFORM%\*.* < C:\FDOS\BIN\YES.TXT > NUL
IF NOT EXIST %MAX_XFORM%\NUL MKDIR %MAX_XFORM%
IF EXIST %MAX_XINC%\NUL DEL %MAX_XINC%\*.* < C:\FDOS\BIN\YES.TXT > NUL
IF NOT EXIST %MAX_XINC%\NUL MKDIR %MAX_XINC%
IF EXIST %MAX_OBJ%\NUL DEL %MAX_OBJ%\*.* < C:\FDOS\BIN\YES.TXT > NUL
IF NOT EXIST %MAX_OBJ%\NUL MKDIR %MAX_OBJ%

ECHO P0: building symsize table (kernel + shared INC)...
CD %MAX_KERN%
%AWK% -f C:\SCRIPTS\XFORM-BT.AWK -v mode=scan *.ASM *.INC > %MAX_XFORM%\SYMSIZE.TXT
CD %MAX_INC%
%AWK% -f C:\SCRIPTS\XFORM-BT.AWK -v mode=scan *.INC >> %MAX_XFORM%\SYMSIZE.TXT
CD %MAX_KERN%

ECHO P1: transforming .ASM (sed + bt-annotate + label expand)...
FOR %%F IN (*.ASM) DO %SED% -f C:\SCRIPTS\XFORM.SED %%F | %AWK% -f C:\SCRIPTS\XFORM-BT.AWK -v mode=rewrite -v symtab=%SYMPATH% | %AWK% -f C:\SCRIPTS\XFORM.AWK > %MAX_XFORM%\%%F

ECHO P2: kernel .INC (sed + label expand)...
FOR %%F IN (*.INC) DO %SED% -f C:\SCRIPTS\XFORM.SED %%F | %AWK% -f C:\SCRIPTS\XFORM.AWK > %MAX_XFORM%\%%F

ECHO P3: shared .INC + .MAC ...
CD %MAX_INC%
FOR %%F IN (*.INC) DO %SED% -f C:\SCRIPTS\XFORM.SED %%F | %AWK% -f C:\SCRIPTS\XFORM.AWK > %MAX_XINC%\%%F
FOR %%F IN (*.MAC) DO %SED% -f C:\SCRIPTS\XFORM.SED %%F | %AWK% -f C:\SCRIPTS\XFORM.AWK > %MAX_XINC%\%%F

ECHO P4: prepend ?VERSION ...
%AWK% "BEGIN{print \"?VERSION equ 510\"} {print}" %MAX_XINC%\MASM.INC > %MAX_XINC%\MASM.NEW
COPY %MAX_XINC%\MASM.NEW %MAX_XINC%\MASM.INC > NUL
DEL %MAX_XINC%\MASM.NEW

ECHO P5: pass-through + OEM ...
CD %MAX_KERN%
COPY *.OEM %MAX_XFORM%\ > NUL
COPY *.WSG %MAX_XFORM%\ > NUL
COPY *.ALL %MAX_XFORM%\ > NUL
COPY %MAX_XFORM%\QMAX@BCF.OEM %MAX_XFORM%\QMAX_OEM.INC > NUL

ECHO P5a: skip QMAX_FLX.ASM (include-only, has no `end` directive)...
IF EXIST %MAX_XFORM%\QMAX_FLX.ASM DEL %MAX_XFORM%\QMAX_FLX.ASM > NUL

ECHO P5b: prepend LOADHI equ 1 to HILO.ASM (BCF variant defaults to high-load)...
%AWK% "BEGIN{print \"LOADHI equ 1\"} {print}" %MAX_XFORM%\HILO.ASM > %MAX_XFORM%\HILO.NEW
COPY %MAX_XFORM%\HILO.NEW %MAX_XFORM%\HILO.ASM > NUL
DEL %MAX_XFORM%\HILO.NEW

ECHO P5c: comment out UTIL_LOD's TOPDOS block (conflicts with QMAX_I21)...
%SED% "/^[ 	]*NPPROC[ 	]\{1,\}TOPDOS/,/^TOPDOS[ 	]\{1,\}endp/{s/^/;/}" %MAX_XFORM%\UTIL_LOD.ASM > %MAX_XFORM%\UTIL_LOD.NEW
COPY %MAX_XFORM%\UTIL_LOD.NEW %MAX_XFORM%\UTIL_LOD.ASM > NUL
DEL %MAX_XFORM%\UTIL_LOD.NEW

ECHO P5d: add extrn TOPDOS:near to UTIL_LOD.ASM (used but commented out above)...
%AWK% "BEGIN{print \"		 extrn	TOPDOS:near\"} {print}" %MAX_XFORM%\UTIL_LOD.ASM > %MAX_XFORM%\UTIL_LOD.NEW
COPY %MAX_XFORM%\UTIL_LOD.NEW %MAX_XFORM%\UTIL_LOD.ASM > NUL
DEL %MAX_XFORM%\UTIL_LOD.NEW

ECHO P5e: skip QMAX_DIF.ASM (100 catstr/textmacro errors, TASM incompat)...
IF EXIST %MAX_XFORM%\QMAX_DIF.ASM DEL %MAX_XFORM%\QMAX_DIF.ASM > NUL

ECHO P1 DONE > C:\TMP\P1_DONE.TXT
