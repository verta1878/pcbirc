@ECHO OFF
REM ===========================================================================
REM  MAXBUILD.BAT - Build 386MAX 8.03 (sudleyplace GPLv3) under TASM 3.1
REM  Part of pcbirc. Runs inside DOSBox-X guest booting PCBBLDBT.IMG.
REM  Reads clean sudleyplace source, transforms on the fly, assembles + links.
REM  See MAIN/build/386MAX-BUILD.md for the sysop guide.
REM ===========================================================================

SET MAX_SRC=C:\386MAX_S
SET MAX_KERN=%MAX_SRC%\KERNEL
SET MAX_INC=%MAX_SRC%\INC
SET MAX_INCL=%MAX_SRC%\INCLUDE
SET MAX_XFORM=%MAX_SRC%\XFORM
SET MAX_XINC=%MAX_SRC%\XINC
SET MAX_OBJ=%MAX_SRC%\OBJ
SET MAX_BIN=%MAX_SRC%\BIN

SET AWK=C:\FDOS\BIN\GAWK.EXE
SET SED=C:\FDOS\BIN\SED.EXE
SET TASMX=C:\BC31\BIN\TASMX.EXE
SET TLINK=C:\BC31\BIN\TLINK.EXE

REM Fresh build dirs
IF EXIST %MAX_XFORM%\NUL DEL %MAX_XFORM%\*.* < C:\FDOS\BIN\YES.TXT > NUL
IF NOT EXIST %MAX_XFORM%\NUL MKDIR %MAX_XFORM%
IF EXIST %MAX_XINC%\NUL DEL %MAX_XINC%\*.* < C:\FDOS\BIN\YES.TXT > NUL
IF NOT EXIST %MAX_XINC%\NUL MKDIR %MAX_XINC%
IF EXIST %MAX_OBJ%\NUL DEL %MAX_OBJ%\*.* < C:\FDOS\BIN\YES.TXT > NUL
IF NOT EXIST %MAX_OBJ%\NUL MKDIR %MAX_OBJ%
IF NOT EXIST %MAX_BIN%\NUL MKDIR %MAX_BIN%

ECHO Phase 0: building bt/bts/btr symbol size table...
CD %MAX_KERN%
%AWK% -f C:\SCRIPTS\XFORM-BT.AWK -v mode=scan *.ASM *.INC > %MAX_XFORM%\SYMSIZE.TXT

ECHO Phase 1: transforming .ASM (sed + bt-annotate + gawk label expand)...
FOR %%F IN (*.ASM) DO %SED% -f C:\SCRIPTS\XFORM.SED %%F | %AWK% -f C:\SCRIPTS\XFORM-BT.AWK -v mode=rewrite -v symtab=%MAX_XFORM%\SYMSIZE.TXT | %AWK% -f C:\SCRIPTS\XFORM.AWK > %MAX_XFORM%\%%F

ECHO Phase 2: transforming kernel .INC (sed patches)...
FOR %%F IN (*.INC) DO %SED% -f C:\SCRIPTS\XFORM.SED %%F > %MAX_XFORM%\%%F

ECHO Phase 3: transforming shared .INC and .MAC...
CD %MAX_INC%
FOR %%F IN (*.INC) DO %SED% -f C:\SCRIPTS\XFORM.SED %%F > %MAX_XINC%\%%F
FOR %%F IN (*.MAC) DO %SED% -f C:\SCRIPTS\XFORM.SED %%F > %MAX_XINC%\%%F

ECHO Phase 4: prepending ?VERSION equ 510 to MASM.INC...
%AWK% "BEGIN{print \"?VERSION equ 510\"} {print}" %MAX_XINC%\MASM.INC > %MAX_XINC%\MASM.NEW
COPY %MAX_XINC%\MASM.NEW %MAX_XINC%\MASM.INC > NUL
DEL %MAX_XINC%\MASM.NEW

ECHO Phase 5: copying pass-through files + selecting BCF OEM variant...
CD %MAX_KERN%
COPY *.OEM %MAX_XFORM%\ > NUL
COPY *.WSG %MAX_XFORM%\ > NUL
COPY *.ALL %MAX_XFORM%\ > NUL
COPY %MAX_XFORM%\QMAX@BCF.OEM %MAX_XFORM%\QMAX_OEM.INC > NUL

ECHO Phase 6: loading HDPMI16 for TASMX...
C:\HX\HDPMI16.EXE -r > NUL

ECHO Phase 7: assembling with TASMX...
CD %MAX_XFORM%
DEL C:\TMP\BLD_ASM.TXT > NUL
FOR %%F IN (*.ASM) DO %TASMX% /JMASM51 /M9 /I%MAX_XINC% /I%MAX_INCL% /I%MAX_XFORM% %%F %MAX_OBJ%\ >> C:\TMP\BLD_ASM.TXT

ECHO Phase 7b: unloading HDPMI16 so gawk/sed can run again...
C:\HX\HDPMI16.EXE -u > NUL

ECHO Phase 8: building response file from ACTUAL .OBJ files + linking...
CD %MAX_OBJ%
IF EXIST UTIL_AR2.OBJ DEL UTIL_AR2.OBJ > NUL
IF EXIST UTIL_MSG.OBJ DEL UTIL_MSG.OBJ > NUL
IF EXIST UTIL_OFF.OBJ DEL UTIL_OFF.OBJ > NUL
IF EXIST UTIL_EMS.OBJ DEL UTIL_EMS.OBJ > NUL
IF EXIST UTIL_POS.OBJ DEL UTIL_POS.OBJ > NUL
IF EXIST UTIL_PTE.OBJ DEL UTIL_PTE.OBJ > NUL
IF EXIST UTIL_ROM.OBJ DEL UTIL_ROM.OBJ > NUL
IF EXIST UTIL_STK.OBJ DEL UTIL_STK.OBJ > NUL
IF EXIST UTIL_SUM.OBJ DEL UTIL_SUM.OBJ > NUL
IF EXIST UTIL_MAC.OBJ DEL UTIL_MAC.OBJ > NUL
IF EXIST UTIL_LOD.OBJ DEL UTIL_LOD.OBJ > NUL
IF EXIST UTIL_TIM.OBJ DEL UTIL_TIM.OBJ > NUL
IF EXIST UTIL_LST.OBJ DEL UTIL_LST.OBJ > NUL
IF EXIST UTIL_USE.OBJ DEL UTIL_USE.OBJ > NUL
DEL _LINK.TMP > NUL
FOR %%F IN (*.OBJ) DO ECHO %%F+ >> _LINK.TMP
%SED% "s/[ 	]*+[ 	]*$/+/; $s/[ 	]*+[ 	]*$//" _LINK.TMP > _LINK.RSP
ECHO ,386MAX.SYS >> _LINK.RSP
ECHO ,386MAX.MAP >> _LINK.RSP
DEL _LINK.TMP > NUL
IF EXIST 386MAX.SYS DEL 386MAX.SYS > NUL
IF EXIST 386MAX.MAP DEL 386MAX.MAP > NUL
IF EXIST %MAX_BIN%\386MAX.SYS DEL %MAX_BIN%\386MAX.SYS > NUL
IF EXIST %MAX_BIN%\386MAX.MAP DEL %MAX_BIN%\386MAX.MAP > NUL
DEL C:\TMP\BLD_LNK.TXT > NUL
%TLINK% /3 @_LINK.RSP > C:\TMP\BLD_LNK.TXT
IF EXIST 386MAX.SYS COPY 386MAX.SYS %MAX_BIN%\386MAX.SYS > NUL
IF EXIST 386MAX.SYS DEL 386MAX.SYS > NUL
IF EXIST 386MAX.MAP COPY 386MAX.MAP %MAX_BIN%\386MAX.MAP > NUL
IF EXIST 386MAX.MAP DEL 386MAX.MAP > NUL

ECHO Phase 9: reporting...
DIR %MAX_OBJ%\*.OBJ > C:\TMP\BLD_OBJS.TXT
DIR %MAX_BIN%\*.* > C:\TMP\BLD_BIN.TXT
ECHO === MAXBUILD DONE === > C:\TMP\BLD_DONE.TXT
CD C:\
