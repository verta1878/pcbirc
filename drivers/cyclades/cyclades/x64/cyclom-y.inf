; ====================================================================
; cyclom-y.inf — Cyclades Cyclom-Y Bus Enumerator
; ====================================================================
; Installs cyport.sys as the bus enumerator for Cyclom-Y multiport
; serial cards. The bus enumerator detects CD1400 chips and creates
; child PDOs for each serial port.
;
; Device class: MultiportSerial
; PCI Vendor:   0x120E (Cyclades Corporation)
; Devices:      Cyclom-Y, Cyclom-4Y, Cyclom-8Y (above 1MB only)
;
; The "above 1MB" variants (DEV_0101, 0103, 0105) are PCI cards.
; The "below 1MB" variants (DEV_0100, 0102, 0104) are ISA or legacy
; PCI and are NOT supported by this INF (no PnP detection).
;
; Based on original Cyclades cyclom-y.inf from Windows XP SP3.
; ====================================================================

[Version]
Signature   = "$Windows NT$"
Class       = MultiportSerial
ClassGUID   = {50906cb8-ba12-11d1-bf5d-0000f805f530}
Provider    = %Provider%
DriverVer   = 08/08/2026,1.0.0.0
CatalogFile = cyport.cat

[Manufacturer]
%Cyclades% = CycladesDevices

; ---- PCI Device Matching ----
; Only match "above 1MB" PCI variants with subsystem + revision.
; These are the PCI cards that support PnP auto-detection.
; The subsystem vendor 0x120E and device 0x0100 identify genuine
; Cyclades cards (not third-party clones).

[CycladesDevices]
%CyclomY.Desc%  = CyclomY_Install, PCI\VEN_120E&DEV_0101&SUBSYS_0100120E&REV_01
%CyclomY.Desc%  = CyclomY_Install, PCI\VEN_120E&DEV_0101
%Cyclom4Y.Desc% = CyclomY_Install, PCI\VEN_120E&DEV_0103&SUBSYS_0100120E&REV_01
%Cyclom4Y.Desc% = CyclomY_Install, PCI\VEN_120E&DEV_0103
%Cyclom8Y.Desc% = CyclomY_Install, PCI\VEN_120E&DEV_0105&SUBSYS_0100120E&REV_01
%Cyclom8Y.Desc% = CyclomY_Install, PCI\VEN_120E&DEV_0105

[CyclomY_Install]
CopyFiles = CyclomY_CopyFiles

; Tell PnP manager to also install the port driver INF.
; When our bus enumerator creates child PDOs, the PnP manager
; needs cyyport.inf to know what driver to load for them.
CopyINF = cyyport.inf

[CyclomY_CopyFiles]
cyport.sys

[CyclomY_Install.Services]
AddService = cyport, 0x00000002, CyclomY_Service

; 0x00000002 = SPSVCINST_ASSOCSERVICE
; Associates this service with the device. Without this flag,
; the device won't start because it has no associated driver.

; IMPORTANT: Both cyclom-y.inf and cyyport.inf register the SAME
; service name "cyport" pointing to the SAME binary cyport.sys.
; This is correct — one .sys serves both roles (bus enumerator
; and port driver) using the IsFDO flag. If you change the service
; name or binary in one INF, you MUST change the other to match.
; (Audit B7 note)

[CyclomY_Service]
DisplayName   = %Service.Desc%
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START (PnP loads us)
ErrorControl  = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary = %12%\cyport.sys
LoadOrderGroup = ExtendedBase

; %12% = %SystemRoot%\System32\Drivers

[DestinationDirs]
DefaultDestDir    = 12          ; System32\Drivers
CyclomY_CopyFiles = 12

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
cyport.sys = 1

[Strings]
Provider        = "Cyclades CD1400 Open Source Project"
Cyclades        = "Cyclades Corporation"
CyclomY.Desc    = "Cyclades Cyclom-Y Multiport Serial Adapter"
Cyclom4Y.Desc   = "Cyclades Cyclom-4Y Multiport Serial Adapter"
Cyclom8Y.Desc   = "Cyclades Cyclom-8Y Multiport Serial Adapter"
Service.Desc    = "Cyclades Cyclom-Y Serial Port Driver"
DiskName        = "Cyclades Cyclom-Y Driver Disk"

; ================================================================
; ISA Card Support — LogConfig Resource Definitions
; ================================================================
; For ISA Cyclom-Y cards that don't have PnP resources,
; Windows uses these LogConfig sections to try different
; memory addresses. The user selects one in Device Manager
; → Resources tab.

[CyclomY.LogConfig]
ConfigPriority=HARDRECONFIG
MemConfig=D0000-D3FFF
IRQConfig=10,11,12,15

[CyclomY.LogConfig2]
ConfigPriority=HARDRECONFIG
MemConfig=D4000-D7FFF
IRQConfig=10,11,12,15

[CyclomY.LogConfig3]
ConfigPriority=HARDRECONFIG
MemConfig=D8000-DBFFF
IRQConfig=10,11,12,15

[CyclomY.LogConfig4]
ConfigPriority=HARDRECONFIG
MemConfig=DC000-DFFFF
IRQConfig=10,11,12,15
