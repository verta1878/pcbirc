# ====================================================================
# CHECKED (DEBUG) BUILD — cyport.sys with full debug output
# This build enables:
#   - All CyDbgPrint output (levels 0-5)
#   - CYPORT_ASSERT macros (bugcheck on invariant violations)
#   - IRQL validation asserts
#   - Register access tracing at VERBOSE level
#   - Full KdPrint debug spew
#
# The checked build is LARGER and SLOWER due to debug code.
# Use for development, testing, and debugging only.
# For production, use the Free build in ../free/
# Build command:
#   Open "Windows XP Checked Build Environment" from WDK menu
#   cd to this directory
#   build -cef

TARGETNAME=cyport
TARGETTYPE=DRIVER
DRIVERTYPE=WDM
TARGETPATH=obj
INCLUDES=..\..\inc
SOURCES=\
    ..\..\src\cyenum.c    \
    ..\..\src\cypdo.c     \
    ..\..\src\cyisr.c     \
    ..\..\src\cyserial.c  \
    ..\..\src\cyread.c    \
    ..\..\src\cywrite.c   \
    ..\..\src\cyioctl.c   \
    ..\..\src\cypower.c   \
    ..\..\src\cylog.c
TARGETLIBS=$(DDK_LIB_PATH)\csq.lib
# DBG=1 is set automatically by the Checked Build Environment.
# CY_DEBUG enables our additional verbose tracing beyond KdPrint.
# CY_DEBUG_REGS enables per-register read/write tracing (very noisy).
C_DEFINES=-DUNICODE -D_UNICODE -DCY_DEBUG=1 -DCY_DEBUG_REGS=0
MSC_WARNING_LEVEL=/W4

# WPP Tracing — generates .tmh files from source
# The WDK build system processes this automatically.
# For OW cross-compilation, WPP is disabled (no tracewpp.exe).
RUN_WPP=$(SOURCES) \
    -km \
    -func:TraceEvents(LEVEL,FLAGS,MSG,...) \
    -gen:{km-default.tpl}*.tmh
