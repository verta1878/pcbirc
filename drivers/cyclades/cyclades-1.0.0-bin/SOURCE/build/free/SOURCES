# ====================================================================
# FREE (RELEASE) BUILD — cyport.sys production binary
# This build:
#   - Compiles out all CYPORT_ASSERT macros (zero overhead)
#   - Compiles out CY_DEBUG tracing (zero overhead)
#   - Keeps CyError output only (critical errors always logged)
#   - Optimized for size and speed
#
# Build command:
#   Open "Windows XP Free Build Environment" from WDK menu
#   cd to this directory
#   build -cef

TARGETNAME=cyport
TARGETTYPE=DRIVER
DRIVERTYPE=WDM
TARGETPATH=obj
INCLUDES=..\..\inc
SOURCES=\
    ..\..\src\cyenum.c    \
    ..\..\src\cypdo.c     \
    ..\..\src\cyisr.c     \
    ..\..\src\cyserial.c  \
    ..\..\src\cyread.c    \
    ..\..\src\cywrite.c   \
    ..\..\src\cyioctl.c   \
    ..\..\src\cypower.c   \
    ..\..\src\cylog.c
TARGETLIBS=$(DDK_LIB_PATH)\csq.lib
C_DEFINES=-DUNICODE -D_UNICODE -DCY_DEBUG=0
MSC_WARNING_LEVEL=/W4

# WPP Tracing — generates .tmh files from source
# The WDK build system processes this automatically.
# For OW cross-compilation, WPP is disabled (no tracewpp.exe).
RUN_WPP=$(SOURCES) \
    -km \
    -func:TraceEvents(LEVEL,FLAGS,MSG,...) \
    -gen:{km-default.tpl}*.tmh
