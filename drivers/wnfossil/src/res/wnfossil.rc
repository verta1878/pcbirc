#include <windows.h>

100 ICON "wnfossil.ico"
101 ICON "comports.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName",      "FPC264IRC Contributors"
            VALUE "FileDescription",  "WinFOSSIL FOSSIL Driver"
            VALUE "FileVersion",      "2.0.0"
            VALUE "InternalName",     "wnfossil"
            VALUE "LegalCopyright",   "GPLv3 — Recreated from Bryan Woodruff's WinFOSSIL (1996)"
            VALUE "OriginalFilename", "WNFOSSIL.EXE"
            VALUE "ProductName",      "WinFOSSIL"
            VALUE "ProductVersion",   "2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04E4
    END
END
