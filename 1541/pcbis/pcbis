#!/bin/bash
# pcbis — PCBoard Installation System
# Menu-driven configuration utility (MCFG-style)
# Part of pcbrevival (GPL v3.0)

PCBIS_VERSION="0.2.0"
PCBIS_ROOT="${PCBIS_ROOT:-$HOME/pcboard}"
PCBIS_CFG="$PCBIS_ROOT/pcbis.cfg"

# --- TUI helpers ---

init_term() {
    tput smcup 2>/dev/null  # save screen
    tput civis 2>/dev/null  # hide cursor
    stty -echo 2>/dev/null
    COLS=$(tput cols)
    ROWS=$(tput lines)
    trap cleanup EXIT
}

cleanup() {
    tput cnorm 2>/dev/null  # show cursor
    tput rmcup 2>/dev/null  # restore screen
    stty echo 2>/dev/null
}

# Colors
C_TITLE="\033[1;37;44m"    # white on blue
C_MENU="\033[0;37;40m"     # white on black
C_HIGH="\033[1;33;44m"     # yellow on blue (highlight)
C_STATUS="\033[0;30;47m"   # black on white
C_FIELD="\033[1;36;40m"    # cyan on black
C_LABEL="\033[0;37;40m"    # white on black
C_BORDER="\033[1;34;40m"   # blue on black
C_RESET="\033[0m"

goto() { printf "\033[%d;%dH" "$1" "$2"; }

draw_box() {
    local y=$1 x=$2 h=$3 w=$4
    local i
    goto $y $x; printf "${C_BORDER}┌"
    for ((i=0; i<w-2; i++)); do printf "─"; done; printf "┐"
    for ((i=1; i<h-1; i++)); do
        goto $((y+i)) $x; printf "│"
        goto $((y+i)) $((x+w-1)); printf "│"
    done
    goto $((y+h-1)) $x; printf "└"
    for ((i=0; i<w-2; i++)); do printf "─"; done; printf "┘${C_RESET}"
}

draw_title() {
    local title="$1"
    local w=${2:-60}
    goto 1 1
    printf "${C_TITLE}"
    printf "%-${COLS}s" ""
    goto 1 $(( (COLS - ${#title}) / 2 ))
    printf "%s" "$title"
    printf "${C_RESET}"
}

draw_status() {
    goto $ROWS 1
    printf "${C_STATUS}%-${COLS}s${C_RESET}" " $1"
}

clear_area() {
    local y=$1 h=$2
    local i
    for ((i=0; i<h; i++)); do
        goto $((y+i)) 1
        printf "${C_MENU}%-${COLS}s" ""
    done
}

# --- Config file I/O ---

load_config() {
    # Defaults
    CFG_BBSNAME="PCBoard BBS"
    CFG_SYSOP="SYSOP"
    CFG_PORT=23
    CFG_NODES=1
    CFG_COMPORT=1
    CFG_BAUD=115200
    CFG_FOSSIL="ADF"
    CFG_FIDOADDR=""
    CFG_NODELIST=""
    CFG_ANSI="YES"
    CFG_ROWS=25
    CFG_SYSPASS=""
    CFG_PCBPATH="$PCBIS_ROOT/data"
    CFG_DOSBOX="dosbox"
    CFG_NETMODEM=""

    if [ -f "$PCBIS_CFG" ]; then
        while IFS='=' read -r key val; do
            key=$(echo "$key" | tr -d ' ')
            val=$(echo "$val" | sed 's/^ *//')
            case "$key" in
                bbs_name)    CFG_BBSNAME="$val" ;;
                sysop)       CFG_SYSOP="$val" ;;
                listen_port) CFG_PORT="$val" ;;
                nodes)       CFG_NODES="$val" ;;
                com_port)    CFG_COMPORT="$val" ;;
                baud_rate)   CFG_BAUD="$val" ;;
                fossil)      CFG_FOSSIL="$val" ;;
                fido_addr)   CFG_FIDOADDR="$val" ;;
                nodelist)    CFG_NODELIST="$val" ;;
                ansi)        CFG_ANSI="$val" ;;
                screen_rows) CFG_ROWS="$val" ;;
                sysop_pass)  CFG_SYSPASS="$val" ;;
                pcb_path)    CFG_PCBPATH="$val" ;;
                dosbox)      CFG_DOSBOX="$val" ;;
                netmodem)    CFG_NETMODEM="$val" ;;
            esac
        done < <(grep -v '^#\|^$' "$PCBIS_CFG" 2>/dev/null)
    fi
}

save_config() {
    mkdir -p "$(dirname "$PCBIS_CFG")"
    cat > "$PCBIS_CFG" << CFGEOF
# pcbis.cfg — PCBoard Installation System configuration
# Generated by pcbis $PCBIS_VERSION

# System
bbs_name=$CFG_BBSNAME
sysop=$CFG_SYSOP
pcb_path=$CFG_PCBPATH

# Network
listen_port=$CFG_PORT
nodes=$CFG_NODES

# Modem/FOSSIL
com_port=$CFG_COMPORT
baud_rate=$CFG_BAUD
fossil=$CFG_FOSSIL

# FidoNet
fido_addr=$CFG_FIDOADDR
nodelist=$CFG_NODELIST

# Display
ansi=$CFG_ANSI
screen_rows=$CFG_ROWS

# Security
sysop_pass=$CFG_SYSPASS

# Programs
dosbox=$CFG_DOSBOX
netmodem=$CFG_NETMODEM
CFGEOF
}

# --- Field editor ---

edit_field() {
    local label="$1"
    local value="$2"
    local y=$3 x=$4 w=$5
    
    tput cnorm 2>/dev/null
    stty echo 2>/dev/null
    
    goto $y $x
    printf "${C_FIELD}%-${w}s${C_RESET}" "$value"
    goto $y $x
    
    local new_val
    read -e -i "$value" -n $w new_val
    
    stty -echo 2>/dev/null
    tput civis 2>/dev/null
    
    echo "$new_val"
}

# --- Menu system ---

draw_menu() {
    local title="$1"
    shift
    local items=("$@")
    local count=${#items[@]}
    local sel=${MENU_SEL:-0}
    local top_y=3
    local left_x=3
    local menu_w=$((COLS - 6))
    
    clear
    draw_title "pcbis $PCBIS_VERSION — $title"
    draw_box $((top_y-1)) $((left_x-1)) $((count+2)) $((menu_w+2))
    
    local i
    for ((i=0; i<count; i++)); do
        goto $((top_y+i)) $left_x
        if [ $i -eq $sel ]; then
            printf "${C_HIGH}  %-$((menu_w-2))s${C_RESET}" "${items[$i]}"
        else
            printf "${C_MENU}  %-$((menu_w-2))s${C_RESET}" "${items[$i]}"
        fi
    done
    
    draw_status "↑↓ Navigate  Enter=Select  Esc=Back  Q=Quit"
}

run_menu() {
    local title="$1"
    shift
    local items=("$@")
    local count=${#items[@]}
    MENU_SEL=0
    
    while true; do
        draw_menu "$title" "${items[@]}"
        
        read -rsn1 key
        case "$key" in
            $'\x1b')  # escape sequence
                read -rsn2 -t 0.1 seq
                case "$seq" in
                    '[A') ((MENU_SEL > 0)) && ((MENU_SEL--)) ;;  # up
                    '[B') ((MENU_SEL < count-1)) && ((MENU_SEL++)) ;;  # down
                    '')   return 255 ;;  # plain Esc
                esac
                ;;
            '')  # Enter
                return $MENU_SEL
                ;;
            'q'|'Q')
                return 254
                ;;
        esac
    done
}

# --- Settings screens ---

screen_system() {
    while true; do
        clear
        draw_title "pcbis — System Settings"
        
        local y=4
        goto $y 4;  printf "${C_LABEL}BBS Name:       ${C_FIELD}%-40s${C_RESET}" "$CFG_BBSNAME"
        goto $((y+1)) 4; printf "${C_LABEL}Sysop Name:     ${C_FIELD}%-40s${C_RESET}" "$CFG_SYSOP"
        goto $((y+2)) 4; printf "${C_LABEL}PCBoard Path:   ${C_FIELD}%-40s${C_RESET}" "$CFG_PCBPATH"
        goto $((y+3)) 4; printf "${C_LABEL}DOSBox Path:    ${C_FIELD}%-40s${C_RESET}" "$CFG_DOSBOX"
        goto $((y+4)) 4; printf "${C_LABEL}NetModem Path:  ${C_FIELD}%-40s${C_RESET}" "$CFG_NETMODEM"
        
        goto $((y+6)) 4; printf "${C_LABEL}[1] Edit BBS Name    [2] Edit Sysop    [3] Edit PCB Path"
        goto $((y+7)) 4; printf "${C_LABEL}[4] Edit DOSBox      [5] Edit NetModem"
        goto $((y+8)) 4; printf "${C_LABEL}[S] Save             [Esc] Back"
        
        draw_status "Press number to edit, S to save, Esc to go back"
        
        read -rsn1 key
        case "$key" in
            1) CFG_BBSNAME=$(edit_field "BBS Name" "$CFG_BBSNAME" $y 20 40) ;;
            2) CFG_SYSOP=$(edit_field "Sysop" "$CFG_SYSOP" $((y+1)) 20 40) ;;
            3) CFG_PCBPATH=$(edit_field "Path" "$CFG_PCBPATH" $((y+2)) 20 40) ;;
            4) CFG_DOSBOX=$(edit_field "DOSBox" "$CFG_DOSBOX" $((y+3)) 20 40) ;;
            5) CFG_NETMODEM=$(edit_field "NetModem" "$CFG_NETMODEM" $((y+4)) 20 40) ;;
            's'|'S') save_config; draw_status "Configuration saved to $PCBIS_CFG" ; sleep 1 ;;
            $'\x1b') return ;;
        esac
    done
}

screen_network() {
    while true; do
        clear
        draw_title "pcbis — Network Settings"
        
        local y=4
        goto $y 4;      printf "${C_LABEL}Telnet Port:    ${C_FIELD}%-20s${C_RESET}" "$CFG_PORT"
        goto $((y+1)) 4; printf "${C_LABEL}Max Nodes:      ${C_FIELD}%-20s${C_RESET}" "$CFG_NODES"
        
        goto $((y+3)) 4; printf "${C_LABEL}[1] Edit Port   [2] Edit Nodes"
        goto $((y+4)) 4; printf "${C_LABEL}[S] Save        [Esc] Back"
        
        draw_status "Press number to edit, S to save, Esc to go back"
        
        read -rsn1 key
        case "$key" in
            1) CFG_PORT=$(edit_field "Port" "$CFG_PORT" $y 20 10) ;;
            2) CFG_NODES=$(edit_field "Nodes" "$CFG_NODES" $((y+1)) 20 10) ;;
            's'|'S') save_config; draw_status "Saved." ; sleep 1 ;;
            $'\x1b') return ;;
        esac
    done
}

screen_modem() {
    while true; do
        clear
        draw_title "pcbis — Modem/FOSSIL Settings"
        
        local y=4
        goto $y 4;      printf "${C_LABEL}COM Port:       ${C_FIELD}COM%-17s${C_RESET}" "$CFG_COMPORT"
        goto $((y+1)) 4; printf "${C_LABEL}Baud Rate:      ${C_FIELD}%-20s${C_RESET}" "$CFG_BAUD"
        goto $((y+2)) 4; printf "${C_LABEL}FOSSIL Driver:  ${C_FIELD}%-20s${C_RESET}" "$CFG_FOSSIL"
        
        goto $((y+4)) 4; printf "${C_LABEL}[1] COM Port   [2] Baud Rate   [3] FOSSIL Driver"
        goto $((y+5)) 4; printf "${C_LABEL}[S] Save       [Esc] Back"
        
        draw_status "Press number to edit, S to save, Esc to go back"
        
        read -rsn1 key
        case "$key" in
            1) CFG_COMPORT=$(edit_field "COM" "$CFG_COMPORT" $y 20 5) ;;
            2) CFG_BAUD=$(edit_field "Baud" "$CFG_BAUD" $((y+1)) 20 10) ;;
            3) CFG_FOSSIL=$(edit_field "FOSSIL" "$CFG_FOSSIL" $((y+2)) 20 20) ;;
            's'|'S') save_config; draw_status "Saved." ; sleep 1 ;;
            $'\x1b') return ;;
        esac
    done
}

screen_fidonet() {
    while true; do
        clear
        draw_title "pcbis — FidoNet Settings"
        
        local y=4
        goto $y 4;      printf "${C_LABEL}FidoNet Addr:   ${C_FIELD}%-30s${C_RESET}" "${CFG_FIDOADDR:-(not set)}"
        goto $((y+1)) 4; printf "${C_LABEL}Nodelist Path:  ${C_FIELD}%-30s${C_RESET}" "${CFG_NODELIST:-(not set)}"
        
        goto $((y+3)) 4; printf "${C_LABEL}[1] FidoNet Address (e.g. 1:234/56)"
        goto $((y+4)) 4; printf "${C_LABEL}[2] Nodelist Path"
        goto $((y+5)) 4; printf "${C_LABEL}[S] Save       [Esc] Back"
        
        draw_status "Press number to edit, S to save, Esc to go back"
        
        read -rsn1 key
        case "$key" in
            1) CFG_FIDOADDR=$(edit_field "Addr" "$CFG_FIDOADDR" $y 20 30) ;;
            2) CFG_NODELIST=$(edit_field "Path" "$CFG_NODELIST" $((y+1)) 20 30) ;;
            's'|'S') save_config; draw_status "Saved." ; sleep 1 ;;
            $'\x1b') return ;;
        esac
    done
}

screen_display() {
    while true; do
        clear
        draw_title "pcbis — Display Settings"
        
        local y=4
        goto $y 4;      printf "${C_LABEL}ANSI Graphics:  ${C_FIELD}%-20s${C_RESET}" "$CFG_ANSI"
        goto $((y+1)) 4; printf "${C_LABEL}Screen Rows:    ${C_FIELD}%-20s${C_RESET}" "$CFG_ROWS"
        
        goto $((y+3)) 4; printf "${C_LABEL}[1] Toggle ANSI   [2] Screen Rows"
        goto $((y+4)) 4; printf "${C_LABEL}[S] Save          [Esc] Back"
        
        draw_status "Press number to edit, S to save, Esc to go back"
        
        read -rsn1 key
        case "$key" in
            1) [ "$CFG_ANSI" = "YES" ] && CFG_ANSI="NO" || CFG_ANSI="YES" ;;
            2) CFG_ROWS=$(edit_field "Rows" "$CFG_ROWS" $((y+1)) 20 5) ;;
            's'|'S') save_config; draw_status "Saved." ; sleep 1 ;;
            $'\x1b') return ;;
        esac
    done
}

screen_security() {
    while true; do
        clear
        draw_title "pcbis — Security Settings"
        
        local y=4
        local masked
        [ -n "$CFG_SYSPASS" ] && masked="********" || masked="(not set)"
        goto $y 4; printf "${C_LABEL}Sysop Password: ${C_FIELD}%-20s${C_RESET}" "$masked"
        
        goto $((y+2)) 4; printf "${C_LABEL}[1] Set Sysop Password"
        goto $((y+3)) 4; printf "${C_LABEL}[S] Save       [Esc] Back"
        
        draw_status "Press number to edit, S to save, Esc to go back"
        
        read -rsn1 key
        case "$key" in
            1) CFG_SYSPASS=$(edit_field "Password" "" $y 20 20) ;;
            's'|'S') save_config; draw_status "Saved." ; sleep 1 ;;
            $'\x1b') return ;;
        esac
    done
}

# --- Main menu ---

main_menu() {
    load_config
    init_term
    
    while true; do
        run_menu "Main Menu" \
            "S  System Settings         BBS name, sysop, paths" \
            "N  Network Settings        Telnet port, nodes" \
            "M  Modem/FOSSIL Settings   COM port, baud, driver" \
            "F  FidoNet Settings        Address, nodelist" \
            "D  Display Settings        ANSI, screen rows" \
            "P  Security Settings       Passwords" \
            "─────────────────────────────────────────────" \
            "I  Run First-Time Setup    (pcbis_initv)" \
            "T  Start BBS               (pcbis_startup)" \
            "H  Stop BBS                (pcbis_shutdown)" \
            "─────────────────────────────────────────────" \
            "Q  Quit"
        
        case $? in
            0) screen_system ;;
            1) screen_network ;;
            2) screen_modem ;;
            3) screen_fidonet ;;
            4) screen_display ;;
            5) screen_security ;;
            7) cleanup; "$(dirname "$0")/pcbis_initv"; init_term ;;
            8) cleanup; "$(dirname "$0")/pcbis_startup"; echo "Press any key..."; read -rsn1; init_term ;;
            9) cleanup; "$(dirname "$0")/pcbis_shutdown"; echo "Press any key..."; read -rsn1; init_term ;;
            11|254|255) break ;;
        esac
    done
}

# --- Entry point ---

case "$1" in
    -cfg|--config|"")
        main_menu
        ;;
    -status|--status)
        echo "pcbis $PCBIS_VERSION — status"
        if [ -f "$PCBIS_ROOT/logs/dosbox.pid" ] && kill -0 "$(cat "$PCBIS_ROOT/logs/dosbox.pid" 2>/dev/null)" 2>/dev/null; then
            echo "  DOSBox:       RUNNING (PID $(cat "$PCBIS_ROOT/logs/dosbox.pid"))"
        else
            echo "  DOSBox:       STOPPED"
        fi
        if [ -f "$PCBIS_ROOT/logs/netmodem.pid" ] && kill -0 "$(cat "$PCBIS_ROOT/logs/netmodem.pid" 2>/dev/null)" 2>/dev/null; then
            echo "  netmodem2irc: RUNNING (PID $(cat "$PCBIS_ROOT/logs/netmodem.pid"))"
        else
            echo "  netmodem2irc: STOPPED"
        fi
        ;;
    -version|--version)
        echo "pcbis $PCBIS_VERSION — PCBoard Installation System"
        echo "Part of pcbrevival (GPL v3.0)"
        ;;
    -help|--help|*)
        echo "pcbis $PCBIS_VERSION — PCBoard Installation System"
        echo ""
        echo "Usage:"
        echo "  pcbis              Launch configuration UI"
        echo "  pcbis -cfg         Same as above"
        echo "  pcbis -status      Show running status"
        echo "  pcbis -version     Show version"
        echo ""
        echo "Lifecycle:"
        echo "  pcbis_initv        First-time setup"
        echo "  pcbis_startup      Start BBS"
        echo "  pcbis_shutdown     Stop BBS"
        echo ""
        echo "Config: $PCBIS_CFG"
        ;;
esac

# Backup & Upgrade
backup_pcb() {
    echo "Backing up PCBoard installation..."
    if [ -x "$(dirname "$0")/../tools/upgrade1541" ]; then
        "$(dirname "$0")/../tools/upgrade1541" -b -v "$PCBIS_ROOT"
    else
        echo "upgrade1541 not found — manual backup recommended"
    fi
}

upgrade_pcb() {
    backup_pcb
    echo "Upgrading to PCBoard 15.41..."
    if [ -x "$(dirname "$0")/../tools/upgrade1541" ]; then
        "$(dirname "$0")/../tools/upgrade1541" "$PCBIS_ROOT"
    fi
}
