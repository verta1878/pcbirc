Main Functions
==============
Starting and Stopping
---------------------
int pascal initdoor(char *     Name,
                    int        SessionLimit,
                    int        KbdTimeout,
                    openstatus OpenStatus);

  OpenStatus values:
    WATCHKBD  WATCHSESSION  READUSERSYS  SHOWSTATUSLINE  LMRS  CONFFLAGS  TPA
    NOCLS

void pascal closedoor(bool UpdateUserSys);
void pascal goodbye(bool UpdateUserSys);
void pascal atclosing(void);


Display Functions
-----------------
void pascal backup(int NumColumns);
void pascal backupcleareol(int NumColumns);
void pascal bell(void);
void pascal checkdisplaystatus(void);
void pascal checkstatus(void);
void pascal cleareol(void);
void pascal displayfile(char * Name, displayfiletype Type);

  Type values:
    NOALTERNATE  GRAPHICS  SECURITY  LANGUAGE

void pascal displayhelpfile(int HelpNum);
void pascal forward(int NumColumns);
void pascal freshline(void);
void pascal moreprompt(moretype Type);

  Type values:
    MOREPROMPT  PRESSENTER

void pascal movecursor(int X, int Y);
void pascal newline(void);
void pascal print(char *Str);
void pascal println(char *Str);
void pascal printcls(void);
void pascal printcolor(int ColorNum);
void pascal printdefcolor(void);
void pascal printxlated(char *Str);
void pascal startdisplay(startdisplaytype Action);

  Action values:
    NOCHANGE  FORCENONSTOP  FORCECOUNTLINES

Input Functions
---------------
void pascal inputfield(char *      Buffer,
                       int         PcbTextNum,
                       int         MaxLen,
                       displaytype Display,
                       int         HelpNum,
                       char *      Mask);

  Display values:
    DEFAULTS  ECHODOTS  FIELDLEN  GUIDE  UPCASE  STACKED  ERASELINE  NEWLINE
    LFBEFORE  LFAFTER  WORDWRAP  NOCLEAR  BELL  HIGHASCII  AUTO

  Mask format:
    char mask_atoz[] = {3,0,'A','z'};

int pascal inputfieldint(int         Default,
                         char *      Prompt,
                         int         Color,
                         int         MaxLen,
                         displaytype Display,
                         int         HelpNum);

long pascal inputfieldlong(long        Default,
                           char *      Prompt,
                           int         Color,
                           int         MaxLen,
                           displaytype Display,
                           int         HelpNum);

void pascal inputfieldstr(char *      Buffer,
                          char *      Prompt,
                          int         Color,
                          int         MaxLen,
                          displaytype Display,
                          int         HelpNum,
                          char *      Mask);

void pascal inputfieldreqstr(char *      Buffer,
                             char *      Prompt,
                             int         Color,
                             int         MaxLen,
                             int         MinLen,
                             displaytype Display,
                             int         HelpNum,
                             char *      Mask);

