+	/*------------------------------------------------------------------*/
+
+void LIBENTRY cSCRIPT::readChan(int chan, char * strBuf, int & size)
+{
+	if (!fileArr[chan].inUse)
+	{
+		fileArr[chan].errStat = TRUE;
+		return;
+	}
+
+	int br = dosfread(strBuf,size,&fileArr[chan].hand);
+
+	if ((br < 0) || (br < size)) fileArr[chan].errStat = TRUE;
+
+	size = br;
+}
