+bool LIBENTRY pcbtextspaces(int TextNum) {
+  int Len;
+  pcbtexttype Spaces;
+
+  getpcbtext(TextNum,&Spaces);
+  Len = strlen(Spaces.Str) + 1;
+  if (Spaces.Str[Len-2] == TXT_STOPCHAR)
+    return(TRUE);
+
+  memset(Spaces.Str,' ',Len);
+  Spaces.Str[Len] = 0;
+  print(Spaces.Str);
+  return(FALSE);
+}
