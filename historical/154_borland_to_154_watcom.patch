+type LNK.OUT >>BUILD.LOG
+if exist MKPCBTXT.EXE echo Link OK - MKPCBTXT.EXE built >>BUILD.LOG
+if not exist MKPCBTXT.EXE echo LINK FAIL >>BUILD.LOG
+:end
+del BCC.OUT >nul 2>nul
+del LNK.OUT >nul 2>nul
