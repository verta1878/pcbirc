+#define wrChBuf(f)               \
+    int rv = 0;                  \
+    char * buf = new char[size]; \
+    if (buf)                     \
+    {                            \
+        memset(buf,c,size);      \
+        rv = write(buf,size);    \
+        delete [] buf;           \
+    }                            \
+    else                         \
+    {                            \
+        rv = -1;                 \
+    }                            \
+    return rv
+
