+        sprintf(Str,"%s %s (%s)",Buf.Str,Stats.LastCaller,Stats.Time);
+      }
+      Str[71] = 0;  /* make sure it fits on screen */
+      showselection(4,20,Str,71,ScrnColors->BarColor);
