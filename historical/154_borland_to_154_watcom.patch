+    case F3     : if (PcbData.ParallelPortNum > 0) {
+                    Status.PrintLog = (bool) (! Status.PrintLog);
+                    redisplaystatusline();
+                    makepcboardsys();
+                    #ifdef __OS2__
+                      updatelinesnow();
+                    #endif
