+#ifdef __WATCOMC__
+/*
+ * QINT.CPP â€” Watcom replacement for 64-bit integer math
+ * Original uses Borland inline ASM; this uses __int64 arithmetic
+ * qibuf[8] stores the 64-bit value in little-endian byte order
+ */
+
+#include <qint.hpp>
+#include <string.h>
+#include <stdlib.h>
+
+static __int64 qi_get(const char *buf) {
+    __int64 v;
+    memcpy(&v, buf, 8);
+    return v;
+}
+
+static void qi_set(char *buf, __int64 v) {
+    memcpy(buf, &v, 8);
+}
+
+qint::qint(void) { memset(qibuf, 0, 8); }
+qint::qint(int i) { __int64 v = i; qi_set(qibuf, v); }
+qint::qint(unsigned int u) { __int64 v = u; qi_set(qibuf, v); }
+#if !defined(__WATCOMC__) || defined(__I86__)
+qint::qint(long l) { __int64 v = l; qi_set(qibuf, v); }
+qint::qint(unsigned long u) { __int64 v = u; qi_set(qibuf, v); }
+#endif
+qint::qint(char *s, int radix) { fromstr(s, radix); }
+
+char * qint::tostr(char *s, int radix) {
+    __int64 v = qi_get(qibuf);
+    int neg = 0;
+    char tmp[72];
+    int pos = 0;
+    unsigned __int64 uv;
+    int i, len;
+
+    if (v == 0) { s[0] = '0'; s[1] = '\0'; return s; }
+    if (v < 0 && radix == 10) { neg = 1; uv = (unsigned __int64)(-v); }
+    else { uv = (unsigned __int64)v; }
+
+    while (uv > 0) {
+        int d = (int)(uv % radix);
+        tmp[pos++] = (char)((d < 10) ? ('0' + d) : ('A' + d - 10));
+        uv /= radix;
+    }
+    i = 0;
+    if (neg) s[i++] = '-';
+    while (pos > 0) s[i++] = tmp[--pos];
+    s[i] = '\0';
+    return s;
+}
+
+void qint::fromstr(char *s, int radix) {
+    __int64 v = 0;
+    int neg = 0;
+    int i = 0;
+
+    if (s[0] == '-') { neg = 1; i = 1; }
+    else if (s[0] == '+') { i = 1; }
+
+    for (; s[i]; i++) {
+        int d;
+        char c = s[i];
+        if (c >= '0' && c <= '9') d = c - '0';
+        else if (c >= 'A' && c <= 'Z') d = c - 'A' + 10;
+        else if (c >= 'a' && c <= 'z') d = c - 'a' + 10;
+        else break;
+        if (d >= radix) break;
+        v = v * radix + d;
+    }
+    if (neg) v = -v;
+    qi_set(qibuf, v);
+}
+
+qint::operator int(void)           { return (int)qi_get(qibuf); }
+qint::operator unsigned int(void)  { return (unsigned int)qi_get(qibuf); }
+#if !defined(__WATCOMC__) || defined(__I86__)
+qint::operator long(void)          { return (long)qi_get(qibuf); }
+qint::operator unsigned long(void) { return (unsigned long)qi_get(qibuf); }
+#endif
+
+qint qint::operator + (qint &tr) { qint r; qi_set(r.qibuf, qi_get(qibuf) + qi_get(tr.qibuf)); return r; }
+qint qint::operator - (qint &tr) { qint r; qi_set(r.qibuf, qi_get(qibuf) - qi_get(tr.qibuf)); return r; }
+qint qint::operator * (qint &tr) { qint r; qi_set(r.qibuf, qi_get(qibuf) * qi_get(tr.qibuf)); return r; }
+qint qint::operator / (qint &tr) { qint r; qi_set(r.qibuf, qi_get(qibuf) / qi_get(tr.qibuf)); return r; }
+qint qint::operator % (qint &tr) { qint r; qi_set(r.qibuf, qi_get(qibuf) % qi_get(tr.qibuf)); return r; }
+
+int qint::operator == (qint &tr) { return qi_get(qibuf) == qi_get(tr.qibuf); }
+int qint::operator <  (qint &tr) { return qi_get(qibuf) <  qi_get(tr.qibuf); }
+
+void qint::divmod(qint &l, qint &r, qint &m) {
+    __int64 lv = qi_get(l.qibuf);
+    __int64 rv = qi_get(r.qibuf);
+    if (rv == 0) { qi_set(qibuf, 0); qi_set(m.qibuf, 0); return; }
+    qi_set(qibuf, lv / rv);
+    qi_set(m.qibuf, lv % rv);
+}
+
+#endif /* __WATCOMC__ */
