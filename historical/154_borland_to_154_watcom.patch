+
+char * LIBENTRY timestr1(char *TStr) {
+  systimetype SysTime;
+
+  getsystime(&SysTime);
+  if (SysTime.Hours > 12 && ! Scrn_24Hour)
+    SysTime.Hours -= (char) 12;
+
+  #ifdef __OS2__
+
+    sprintf(TStr,"%02d:%02d:%02d",
