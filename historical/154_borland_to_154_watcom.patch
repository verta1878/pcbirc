+      sprintf(Str,"[%5u%-13s%8ld%8ld%8ld%c]",
+              ConfNum,
+              Status.CurConf.Name,
+              MsgStats.LowMsgNum,
+              MsgStats.HighMsgNum,
+              LastMsgRead,
+              isset(&ConfReg[USR],ConfNum) ? 'Y' : 'N');
+    }
+  }
+
+  tersemodechecksum(Str,43);
+  getconfrecord(Status.Conference,&Status.CurConf);
+}
