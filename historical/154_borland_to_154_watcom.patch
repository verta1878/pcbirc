+void do_fido_menu(void)
+{
+char            input[6];
+int             sel=0;
+const int       ESC   = 27;
+int             screen;
+
+  checkstack();
+  memset(input,0,sizeof(input));
+  Status.FileXfer = TRUE;
+
+  setcursor(CUR_BLANK);
+  screen=memsavescreen();
+
+  sel = 0;
+
+/*
+  /// Make sure no other nodes are processing mail
+  if(!okaytohandlemail())
+  {
+    clsbox(MNU_TOPX,MNU_TOPY,MNU_BOTX,MNU_BOTY,0x11);
