+  #ifdef COMM
+    if (Asy.Online == REMOTE) {
+      clearoutbuf();
+      clearinbuf();
+      waitcomm(ONESECOND);
+      sendstr("        ",32);
+      waitcomm(ONESECOND);
+    }
+  #endif
+}
