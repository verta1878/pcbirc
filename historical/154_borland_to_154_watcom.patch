+  if (Status.ActStatus != ACT_DISABLED) {
+    MinutesUsed = minutesused(Status.ConfJoinTime);
+    if (MinutesUsed != 0) {
+      recordusage("CONF TIME","",Status.CurConf.ChargeTime,MinutesUsed,&UsersData.Account.DebitTime);
+      checkaccountbalance();
+    }
+  }
+  Status.ConfJoinTime = dosgetlongtime();
+}
