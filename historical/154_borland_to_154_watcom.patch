+  asm  Add  Si,Ax
+
+NextY:
+
+ForX:
+  asm  Push Cx
+  asm  Mov  Cx,X2
+  asm  Mov  Di,X1
+  asm  Shl  Di,1
+  asm  Add  Di,Si
+
+
+NextX:
+  asm  Cmp  Scrn_Rtrc,0
+  asm  Je   J2
+  asm  Mov  Dx,03DAh
+
+J1:
+  asm  In   Al,Dx
+  asm  Test Al,01
+  asm  Jz   J1
+
+J2:
+  asm  Mov  Al,Color
+  asm  Stosb
+  asm  Inc  Di
+  asm  Loop NextX
+
+  asm  Pop  Cx
+  asm  Add  Si,160
+  asm  Loop NextY
+#endif  /* ifdef BIOS */
+
+  NEEDSEGPOPDS;
+
+#endif  /* ifdef __OS2__ */
+}
