+#ifdef COMM
+static void _NEAR_ LIBENTRY lostcarrierinchat(void) {
+  char        Str[80];
+  char        Temp[80];
+  pcbtexttype Buf;
+
+  getsystext(TXT_CARRIERLOST,&Buf);
+  xlatetext(Temp,Buf.Str);
+  sprintf(Str,"%s: %s",MyHandle,Temp);
+  postmessageinqueue(Channel,ALLNODES,Str);
+  showexit(Channel);
+  chatcleanup(FALSE);
+  loguseroff(ALOGOFF);
+}
