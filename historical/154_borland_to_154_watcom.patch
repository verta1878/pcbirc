+  #ifdef __OS2__
+    // Control.NetTimer was based on 1/100th of a second, but CallWaitNetTimer
+    // is based on 1/1000th of a second, so multiply by 10
+    releasekbdblock(CallWaitNetTimer*10);
+  #endif
+}
