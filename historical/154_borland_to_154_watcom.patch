+#define  OPEN_DENYNONE 0x40     /* share mode: deny none                   */
+
+#define  OPEN_READ     0x00     /* open for read access                    */
+#define  OPEN_WRIT     0x01     /* open for write access                   */
+#define  OPEN_RDWR     0x02     /* open for read/write access              */
