+static bool _NEAR_ LIBENTRY updateclockstatus(void) {
+  char Temp[10];
+  long Time;
+
+  Time = gettimer(4);
+  if (Time < 0) {
+    tickdelay(ONESECOND);
+    return(TRUE);
+  }
+
+  sprintf(Temp,"%2ld",(Time/ONESECOND)+1);
+  fastprint(WritePos,18,Temp,ScrnColors->BarColor);
+
+  #ifndef __OS2__
+    if (timerexpired(2)) {
+      updatetime();
+      settimer(2,ONESECOND);
+    }
+  #endif
+
+  return(FALSE);
+}
