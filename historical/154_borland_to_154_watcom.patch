+    cVARVAL lVal(vtINTEGER);
+
+    sVal = *this;
+    lVal = strLen;
+    pVal = sVal.values.vBIGSTR.len-lVal.values.vINTEGER+1;
+
+    return sVal.mid(pVal,lVal);
+}
