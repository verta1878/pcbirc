+#include "model.h"
+#endif
+
+
+#include <string.h>
+#include "dosfunc.h"
+#ifdef DEBUG
+#include <memcheck.h>
+#endif
+
+char OpenFileNames[MAXHANDLES+1][MAXNAMELEN];
