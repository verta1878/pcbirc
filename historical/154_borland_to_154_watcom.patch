+#ifndef _CONSTREAM_H_COMPAT
+#define _CONSTREAM_H_COMPAT
+#ifdef __WATCOMC__
+#include <stdio.h>
+#include <string.h>
+
+
+/* iostream manipulators for constream */
+struct _constream_hex_t {};
+struct _constream_dec_t {};
+static _constream_hex_t _cs_hex;
+static _constream_dec_t _cs_dec;
+#define hex _cs_hex
+#define dec _cs_dec
+#define setw(n) n
+#define setfill(c) c
+
+/* ios::uppercase compat â€” Watcom old-style iostream may not expose it */
+#ifndef _CONSTREAM_IOS_COMPAT
+#define _CONSTREAM_IOS_COMPAT
+namespace _pcb_ios { enum { uppercase = 0x0200 }; }
+#define ios _pcb_ios
+#endif
+/* Minimal constream stub â€” outputs to stdout */
+/* endl for constream */
+static const char _endl_char = '\n';
+#define endl _endl_char
+class constream {
+public:
+    constream() {}
+    constream& operator<<(const char *s) { if(s) fputs(s, stdout); return *this; }
+    constream& operator<<(char c) { putchar(c); return *this; }
+    constream& operator<<(int n) { printf("%d", n); return *this; }
+    constream& operator<<(unsigned n) { printf("%u", n); return *this; }
+    constream& operator<<(long n) { printf("%ld", n); return *this; }
+    constream& operator<<(unsigned long n) { printf("%lu", n); return *this; }
+    constream& operator<<(void *p) { printf("%p", p); return *this; }
+    constream& operator<<(_constream_hex_t) { return *this; }
+    constream& operator<<(_constream_dec_t) { return *this; }
+    void clrscr() {}
+    void window(int,int,int,int) {}
+    void setf(int) {}
+    void unsetf(int) {}
+};
+
+/* setxy / setattr manipulators for constream << setxy(x,y) << setattr(a) */
+struct _setxy_t { int x, y; };
+struct _setattr_t { int a; };
+inline _setxy_t setxy(int x, int y) { _setxy_t s; s.x=x; s.y=y; return s; }
+inline _setattr_t setattr(int a) { _setattr_t s; s.a=a; return s; }
+inline constream& operator<<(constream& cs, _setxy_t) { return cs; }
+inline constream& operator<<(constream& cs, _setattr_t) { return cs; }
+
+/* Borland conio screen save/restore stubs */
+inline int gettext(int,int,int,int,void*) { return 1; }
+inline int puttext(int,int,int,int,const void*) { return 1; }
+inline void heapfillfree(unsigned int) {}
+
+/* Borland conio â€” Watcom equivalents */
+#include <conio.h>
+
+/* conbuf stub for files that reference it directly */
+class conbuf {
+public:
+    conbuf() {}
+    int do_sputn(const char *s, int n) { for(int i=0;i<n;i++) putchar(s[i]); return n; }
+};
+
+#else
+/* Borland: use native constrea.h */
+#endif
+#endif
