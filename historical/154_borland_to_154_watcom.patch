+
+FAIL, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f, 0x20,
+0x21, 0x22, 0x23, 0x24, 0x25, 0x26, 0x27, 0x28,
+0x29, 0x2a, 0x2b, 0x2c, 0x2d, 0x2e, 0x2f, 0x30,
+0x31, 0x32, 0x33, FAIL, FAIL, FAIL, FAIL, FAIL,
+
+FAIL, FAIL, FAIL, FAIL, FAIL, FAIL, FAIL, FAIL,
+FAIL, FAIL, FAIL, FAIL, FAIL, FAIL, FAIL, FAIL,
+FAIL, FAIL, FAIL, FAIL, FAIL, FAIL, FAIL, FAIL,
