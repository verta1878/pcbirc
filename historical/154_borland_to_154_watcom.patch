+
+#define MULTIPLIER  0x015A4E35L
+#define INCREMENT   1
+
+static long LSeed = 1;
+
+void slrand(unsigned long lseed)
+{
+    LSeed = lseed;
+}
+
+signed long int lrand(void)
+{
+    LSeed = MULTIPLIER * LSeed + INCREMENT;
+    LSeed = (LSeed << 1) + ((LSeed & 0x80000000L) ? 1 : 0);
+    return (LSeed & 0x7FFFFFFFL);
+}
