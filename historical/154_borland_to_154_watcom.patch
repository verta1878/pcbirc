+static void _NEAR_ LIBENTRY givecredits(void) {
+  char        Str[80];
+  pcbtexttype Buf;
+
+  if (Status.EnteringMessage)
+    return;
+
+  if (XferVars.SuccessfulUpldFiles != 0) {
