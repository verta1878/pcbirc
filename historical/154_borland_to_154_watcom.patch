+void LIBENTRY tickdelay(int Ticks) {
+  #ifdef __OS2__
+    mydelay(Ticks/10);  // under OS/2 Ticks=1/1000th of a second
+  #else
+    /* under DOS Ticks=1/18.2 of a second */
+    settimer(3,Ticks);
+    while (! timerexpired(3)) {
+      #ifdef COMM
+        turnonxmit();
+      #endif
+      if (Control.WatchSessionClock && gettimer(5) <= THREEMINUTES)
+        checktime();
+      giveup();
+    }
+  #endif
+}
