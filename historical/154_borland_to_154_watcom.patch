+  if (checkforalternatelist(DirList,Status.CurConf.DirNameLoc,sizeof(dirlisttype2)) == -1)
+    NumDirs = 0;
+  else
+    NumDirs = numrandrecords(DirList,sizeof(dirlisttype2));
