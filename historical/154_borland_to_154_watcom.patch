+  if (InBytes == 0)
+    return(-1);
+
+  Byte = (char) OSBuffer[OSTailPtr++];
+  OSTailPtr &= (OSINBUFSIZE-1);         /* wrap the pointer if necessary */
+  updateinbytes(-1);
+//OSInBytes--;
+  return(Byte);
+}
