+
+static int _NEAR_ LIBENTRY lastline(void) {
+  int       X;
+  msgbuffer *p;
+
+  checkstack();
+  for (X = MaxMsgLines-1, p = &Msg[X]; p->Line[0] == 0 && X; p--, X--);
+  return(X+1);
+}
