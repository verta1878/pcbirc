+      SysDate->Day       = r.h.dl;
+      SysDate->Year      = r.w.cx;
+      SysDate->DayOfWeek = r.h.al + 1;
+    }
+  #else
+    #ifdef _MSC_VER
+      char  _AL,_DL,_DH;
+      short _CX;
+    #endif
