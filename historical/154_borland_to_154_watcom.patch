+    if (Key.B.LoB == 27)
+      break;
+
+    if (Key.B.LoB == 'A')
+      setkbdstatus(0);
+
+    printf("Key = %04X, %3d / %3d.  Shift = %d\n",Key.W,Key.B.HiB,Key.B.LoB,getkbdstatus());
