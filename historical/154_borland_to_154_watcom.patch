+#include <stdio.h>
+
+void main(int argc, char **argv) {
+  char Value[5];
+
+  /* NOTE:  argv[1] needs to be in uppercase letters */
+  soundex(Value,argv[1]);
+  puts(Value);
+}
+#endif
