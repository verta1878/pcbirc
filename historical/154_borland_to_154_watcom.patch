+int cFILEBASE::printf ( const char * fmt, ... )
+{
+    char buf [ 1024 + 1 ];
+
+    #ifdef DEBUG
+      mc_register(buf,sizeof(buf));
+    #endif
+
+    va_list args;
+    va_start(args,fmt);
+    vsprintf(buf,fmt,args);
+    va_end(args);
+
+    int rv = puts(buf);
+
+    #ifdef DEBUG
+      mc_unregister(buf);
+    #endif
+
+    return rv;
+}
