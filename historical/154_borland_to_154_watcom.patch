+                  break;
+    case F4     : Status.PageBell = (bool) (! Status.PageBell);
+                  redisplaystatusline();
+                  makepcboardsys();
+                  #ifdef __OS2__
+                    updatelinesnow();
+                  #endif
+                  break;
