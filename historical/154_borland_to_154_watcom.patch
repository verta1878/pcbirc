+/****************************************************************************/
+/* Global Vars.                                                             */
+
+static _FAR_ HELLO_T                  OurHello;           // Our hello structure
+static _FAR_ HELLO_T                  RemoteHello;        // remote hello structure
+static _FAR_ Emsi                     emsi;
+
