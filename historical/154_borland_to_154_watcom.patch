+                                        //  asm mov es, ax
+  _DI = FP_OFF ((void far *) &Fossil);  //  asm mov di, offset Fossil
+  _DX = Port;                           //  asm mov dx, Port
+  _AH = 0x1b;                           //  asm mov ah, 1Bh
