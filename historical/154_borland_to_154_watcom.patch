+
+char * LIBENTRY readStr(DOSFILE * fs, bool & re, bool & me)
+{
+    char * p = NULL;
+
+    if (re || me) return p;
+
+    char buf[256+1];
+    re = (dosfgets(buf,256+1,fs) == -1);
+
+    int len = strlen(buf);
+    if ((len > 0) && !re)
+    {
+        p = (char *) bmalloc(len+1);
+        me = (p == NULL);
+        if (!me) memcpy(p,buf,len+1);
+    }
+
+    return p;
+}
+
+    /*--------------------------------------------------------------------*/
+
+int LIBENTRY readInt(DOSFILE * fs, bool & re, bool & me)
+{
+    int i = 0;
+
+    if (re || me) return i;
+
+    char * p = readStr(fs,re,me);
+    if (p != NULL)
+    {
+        i = atoi(p);
+        bfree(p);
+    }
+
+    return i;
+}
