+	  char buf[MAXBUF];
+	  unsigned short crc;
+
+	  if( argc > 1 )
+	  {
+			if( (fd = open( argv[1], O_RDONLY )) < 0 )
+			{
+				  perror( argv[1] );
+				  exit( -1 );
+			}
+	  }
+	  crc = 0;
+	  while( (nr = read( fd, buf, MAXBUF )) > 0 )
+			crc = updcrc( crc, buf, nr );
+	  printf( "%04x\n", crc );
+	  if( nr != 0 )
+			perror( "reading" );
+}
