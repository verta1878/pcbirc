+int LIBENTRY FOSSIL_comminkey(void) {
+  char Byte;
+
+  #ifdef DEBUG
+    if (FosBuffer == NULL) {
+      writedebugrecord("call to FOSSIL_comminkey() while closed");
+      return(-1);
+    }
+  #endif
+
+  if (InBytes == 0)
+    return(-1);
+
+  FosInBytes--;
+  Byte = (char) FosBuffer[FosTailPtr++];
+  FosTailPtr &= (FOSINBUFSIZE-1);         /* wrap the pointer if necessary */
+  return(Byte);
+}
