+void * operator new(unsigned size)
+{
+    if (size == 0) size = 1;
+
+    void * ptr;
+
+    void (*cur_new_handler)(void) = set_new_handler(NULL);
+
+    do {
+        ptr = malloc(size);
+        unsigned long int i = mc_alloc_count();
+        if(i == 6365)
+          i = 0;
+        if (ptr != NULL) break;
+
+        if (cur_new_handler != NULL)
+            cur_new_handler();
+        else
+            break;
+
+    } while (ptr == NULL);
+
+    set_new_handler(cur_new_handler);
+    return ptr;
+}
