+  for (; *Str; Str++) {
+    if (*Str == '^' && *(Str+1) >= 'A' && *(Str+1) <= '[') {
+      Str++;
+      stuffbuffer(*Str - '@');
+    } else
+      stuffbuffer(*Str);
+  }
+}
