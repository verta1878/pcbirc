+static void _NEAR_ LIBENTRY removeinsidespaces(char *Str) {
+  char *p;
+  char Ch;
+
+  checkstack();
+  stripleft(Str,' ');
+  stripright(Str,' ');
+
+  while (1) {
+    if ((p = strstr(Str,"  ")) == NULL)
+      break;
+
+    if (p != Str) {
+      Ch = *(p-1);
+      if (Ch == '.' || Ch == ':' || Ch == '?' || Ch == '!') {
+        Str = p + 1;
+        continue;
+      }
+    }
+    strcpy(p,p+1);
+    Str = p;
+  }
+}
