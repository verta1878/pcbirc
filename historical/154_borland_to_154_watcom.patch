+void LIBENTRY closepcbtext(void) {
+  if (PcbTextHandle > 0) {
+    dosclose(PcbTextHandle);
+    if (PcbTextHandle == SystemHandle)  /* if we're sharing the file then */
+      SystemHandle = 0;                 /* don't try to close it twice    */
+    PcbTextHandle = 0;
+  }
+  if (SystemHandle > 0) {
+    dosclose(SystemHandle);
+    SystemHandle = 0;
+  }
+  #ifndef LIB
+  if (PcbTextBuffer != NULL) {
+    PcbTextLoaded = FALSE;
+    free(PcbTextBuffer);
+    PcbTextBuffer = NULL;
+  }
+  #endif
+}
