+		  while(*bptr != '-' && *bptr != ' ' && *bptr != '\x0') bptr++;
+
+		  // if it is a range, get the hi number of the range
+		  if(*bptr == '-')
+		  {
+			hi = atoi(++bptr);
+			while(isdigit(*bptr) && *bptr != '\x0') bptr++;
+		  }
+		  // if it was just a single number, set hinum = lonum
+		  else if(*bptr == ' ' || *bptr == '\x0') hi = lo;
