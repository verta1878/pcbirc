+
+/******************************************************************************/
+
+// Included Files
+
+#include    <stdio.h>
+#include    <stdlib.h>
+#include    <string.h>
+
+#if defined(LIB)
+#include    <pcbtools.h>
+#undef bool
+#undef TRUE
+#undef FALSE
+#else
