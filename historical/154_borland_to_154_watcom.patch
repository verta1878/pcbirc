+void LIBENTRY stuffpplbuffer(char *Str) {
+  int C;
+
+  for (; *Str; Str++) {
+    if (*Str == '^' && *(Str+1) >= 'A' && *(Str+1) <= '[') {
+      Str++;
+      C = *Str - '@';
+    } else
+      C = *Str;
+
+    PPLBuffer[PPLHeadPtr] = (short) C;
+    PPLHeadPtr++;   /* it's a char - automatically rolls over to 0 after 255 */
+    PPLBufCount++;
+  }
+}
