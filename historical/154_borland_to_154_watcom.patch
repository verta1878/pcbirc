+                  break;
+    #endif
+    case ALTX   : Status.SysopFlag = (Status.SysopFlag == 'X' ? ' ' : 'X');
+                  redisplaystatusline();
+                  makepcboardsys();
+                  #ifdef __OS2__
+                    updatelinesnow();
