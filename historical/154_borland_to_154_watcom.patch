+
+#ifdef  ___COMP___
+    if (lineNum != -1)
+    {
+        if (handNum > 0)
+        {
+            char * p = strrchr(OpenFileNames[handNum],'\\');
+            p = (p ? ++p : OpenFileNames[handNum]);
+            scriptErr(0,-1,warnFlag ? SCR_WRN_LINNUM : SCR_ERR_LINNUM,
+                "file %s, line %d",p,lineNum);
