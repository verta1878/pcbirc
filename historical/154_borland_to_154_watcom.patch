+    /*--------------------------------------------------------------------*/
+
+int pascal cSCRIPT::argCount(char * s, int funcstyle)
+{
+    if (s == NULL) s = "";
+
+    int qStat = FALSE;
+    int pCount = 0;
+    int cCount;
+
+    if (funcstyle)
+        cCount = ((*s == ')') ? 0 : 1);
+    else if (strlen(s) > 0)
+        cCount = 1;
+    else
+        cCount = 0;
+
+    while ((*s != '\0') && (!funcstyle || (funcstyle && (pCount >= 0))))
+    {
+        if (*s == '\"')
+            qStat = !qStat;
+        else if (!qStat && (*s == '('))
+            ++pCount;
+        else if (!qStat && (*s == ')'))
+            --pCount;
+        else if (!qStat && (pCount < 1) && (*s == ','))
+            ++cCount;
+        ++s;
+    }
+
+    if (funcstyle && (pCount != -1))
+        return -1;
+    else if (funcstyle)
+        *(--s) = '\0';
+
+    return cCount;
+}
