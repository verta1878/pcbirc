+        settimer(2,THIRTYSECONDS);
+      }
+      Status.OldStatLine = Status.StatLine;
+      return;
+    }
+  #endif
+
+  #ifdef COMM
+    if (Status.StatLine == Status.OldStatLine) {
+      if (Status.StatLine != NAME && timerexpired(2)) {
+        Status.StatLine = Status.OldStatLine = NAME;
