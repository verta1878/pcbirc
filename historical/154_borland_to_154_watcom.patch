+void LIBENTRY showmessage(int TextNum) {
+  #ifndef LIB
+  char OldX;
+  char OldY;
+  #endif
+  char OldColor;
+
+  checkstack();
+  OldColor = curcolor();
+
+  #ifndef LIB
+    if (Status.FullScreen) {  /* are we in the Full Screen Editor? */
