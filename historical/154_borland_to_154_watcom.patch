+int LIBENTRY cPCBMSGS::open ( const char * name )
+{
+    char tmp [ 128 + 1 ];
+
+    strcpy(tmp,name);
+    if (cMSG::open(tmp) != 0) return -1;
+
+    strcat(tmp,".IDX");
+    if (cMSGIDX::open(tmp,OPEN_RDWR|OPEN_DENYNONE) != 0) return -1;
+
+    setStart(lowMsgNum());
+
+    return 0;
+}
+
+void LIBENTRY cPCBMSGS::close ( void )
+{
+    cMSGIDX::close();
+    cMSG::close();
+}
