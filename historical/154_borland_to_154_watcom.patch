+
+  showactivity(ACTSUSPEND);
+  printdefcolor();
+  yymmddtostr(Date,p->LastDateOn);
+  countrydate(Date);
+  sprintf(Str,"%25.25s %24.24s  %8.8s  %5.5s",p->Name,p->City,Date,p->LastTimeOn);
+  stripright(Str,' ');
