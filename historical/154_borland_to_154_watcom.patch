+
+#include    <types.hpp>
+
+/******************************************************************************/
+
+// Clear Buffer Functions
+
+template <class T>
+inline void clearBuffer ( T & t )
+{
+    memset(&t,NUL,sizeof(t));
+}
+
+inline void clearBuffer ( void * p, unsigned s )
+{
+    memset(p,NUL,s);
+}
