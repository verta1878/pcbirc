+unsigned long LIBENTRY HexDec (char _FAR_ *string)
+{
+	int len = strlen (string)-1;
+	int x;
+	unsigned char value;
+	unsigned long spot;
+	unsigned long num=0;
+
+	spot=1;
+	for (x=len; x>=0; x--) {
+		value = toupper (*(string+x));
+		if (value>='A' && value<='F')
+			num+=(10+(value-'A'))*spot;
+		else
+			num+=(value-'0')*spot;
+		spot<<=4;
+	}
+	return (num);
+}
