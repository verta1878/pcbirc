+int pascal cSCRIPT::legalName(char * s)
+{
+    stripSpaces(s);
+    if (!(isascii(*s) && isalpha(*s))) return FALSE;
+    ++s;
+
+    char * t = strchr(s,'(');
+    if (t != NULL)
+    {
+        char * p = t;
+        t = strdup(p);
+        *p = '\0';
+    }
+
+    char * o = s;
+    while (*s != '\0')
+        if (!(isascii(*s) && isalnum(*s)) && (strchr("_$#@›œú",*s) == NULL))
+        {
+            if (t) free(t);
+            return FALSE;
+        }
+        else
+            ++s;
+
+    if (strlen(--o) > MAX_LAB_NAME_SIZE)  o[MAX_LAB_NAME_SIZE] = '\0';
+    if (t != NULL)
+    {
+        strcat(o,t);
+        free(t);
+    }
+
+    if (isConst(o)) return FALSE;
+
+    return TRUE;
+}
