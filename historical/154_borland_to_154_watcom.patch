+int LIBENTRY FOSSIL_checkcomm(void) {
+  #ifdef _MSC_VER
+    int AXreg;
+  #endif
+  int NumBytes;
+
+  NumBytes = InBytes;
+  if (NumBytes == 0)
+    return(0);
+
+  _AH = 0x0c;                           //  asm mov ah,0Ch
+  _DX = Port;                           //  asm mov dx,Port
+  geninterrupt (0x14);                  //  asm int 14h
+
+  #ifdef _MSC_VER
+    asm mov AXreg,ax
+    switch(AXreg) {
+      case 11:
+      case 19:
+      case 24: return(AXreg);
+    }
+  #else
+    switch(_AL) {
+      case 11:
+      case 19:
+      case 24: return(_AX);
+    }
+  #endif
+  return(0);
+}
