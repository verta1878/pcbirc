+// Keystroke Input Functions
+
+cVARVAL LIBENTRY inkeysub(int LIBENTRY (*f)(void))
+{
+    char buf[80+1] = "BADKEY";
+
+    int key = f();
+
+    if ((key >= 0) && (key <= 255))
+    {
+        buf[0] = key;
+        buf[1] = '\0';
+    }
+    else if ((key >= 1000) && (key <= 1255) && inkeyText[key-1000])
+        strcpy(buf,inkeyText[key-1000]);
+
+    return cVARVAL(vtSTRING,buf);
+}
