+			/*----------------------------------------------------*/
+
+		putUserFunc(ALIAS, 0,ptrUData->Alias,					 25,setnewalias(ptrUData,strupr(s),lastUserGot));  //lint !e534
+
+			/*----------------------------------------------------*/
+
