+char * LIBENTRY xlateFidoText(char * s, char HighAsciiSetting)
+{
+
+
+
+	char * p = s;
+
+	while (*s)
+	{
+		if (*s > 127)
+			switch (HighAsciiSetting)
+			{
+				case 'S':
+					strcpy(s,s+1);
+					continue;
+
+				case 'R':
+					*s = '.';
+					break;
+
+				case 'C':
+					*s = lookup[*s-127];
+					break;
+			}
+
+		++s;
+	}
+
+	return p;
+}
