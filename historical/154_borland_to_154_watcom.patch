+  test("xxx @X07 yyy");
+  test("xxx @XF0 yyy");
+  test("xxx @X78 yyy");
+  test("xxx @Xa8 yyy");
+  test("xxx @X8a yyy");
+  test("xxx @ENV=PHONE:10@ yyy");
+  test("[@POS:15@]");
+  test("[              ]");
+}
