+
+    char buf[2];
+    buf[0] = '*';
+    buf[1] = '\0';
+
+    tVal = *this;
+
+    if (tVal.values.vINTEGER < 0)
+        tVal.values.vINTEGER = 0;
+    else if (tVal.values.vINTEGER > 255)
+        tVal.values.vINTEGER = 255;
+
+    *buf = char(tVal.values.vINTEGER);
+    dVal.pokeBuf(buf,1);
+
+    return dVal;
+}
