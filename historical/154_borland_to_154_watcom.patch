+int LIBENTRY isATX(char * s)
+{
+    return ((*(s++) == '@') && (*(s++) == 'X') &&
+        (isdigit(*s) || isupper(*s)) && isxdigit(*(s++)) &&
+        (isdigit(*s) || isupper(*s)) && isxdigit(*s));
+}
