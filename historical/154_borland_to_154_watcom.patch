+	/*------------------------------------------------------------------*/
+
+void LIBENTRY cSCRIPT::writeChan(int chan, char * strBuf, int size)
+{
+	if (!fileArr[chan].inUse)
+	{
+		fileArr[chan].errStat = TRUE;
+		return;
+	}
+
+	size = dosfwrite(strBuf,size,&fileArr[chan].hand);
+
+	if (size < 0) fileArr[chan].errStat = TRUE;
+}
