+void LIBENTRY dispatch(char *Cmd, int SecLvlReq, int NumTokens, void LIBENTRY (*func)(int NumTokens)) {
+  if (seclevelokay(Cmd,SecLvlReq)) {
+    displaycmdfile(Cmd);
+    startdisplay(NOCHANGE);
+    func(NumTokens-1);
+    checkdisplaystatus();
+  }
+}
