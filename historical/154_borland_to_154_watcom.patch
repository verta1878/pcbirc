+  Fields[ 2].Text = (PcbData.ParallelPortNum > 0 ? (Status.PrintLog ? Text[16].Str : Text[4].Str) : Text[15].Str);
+  Fields[ 7].Text = (Status.PageBell ? Text[18].Str : Text[6].Str);
