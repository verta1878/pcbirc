+*/
+
+static bool _NEAR_ LIBENTRY longlines(void) {
+  int       Num;
+  msgbuffer *p;
+
+  checkstack();
+  for (Num = 0, p = Msg, HighNum = lastline(); Num < HighNum; Num++, p++) {
+    if (strlen(p->Line) > 72)
+      return(TRUE);
+  }
+  return(FALSE);
+}
