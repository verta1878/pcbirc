+char * LIBENTRY meganum(int Num) {
+  char static MegaNums[37] = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
+  char static Buf[3];
+  int  Tens;
+
+  if (Num >= 36) {
+    Tens = Num / 36;
+    Num -= (Tens * 36);
+    Buf[0] = MegaNums[Tens];
+  } else
+    Buf[0] = '0';
+
+  Buf[1] = MegaNums[Num];
+  Buf[2] = 0;
+  return(Buf);
+}
