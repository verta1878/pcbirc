+void LIBENTRY savepath(void) {
+  OldDrive = dosgetcurdrive();
+  dosgetcurpath(OldDrive,OldPath,sizeof(OldPath));
+}
+
+
+void LIBENTRY restorepath(void) {
+  dossetcurdrive(OldDrive);
+  chdir(OldPath);
+}
