+        if (argv[i][0] == '/' || argv[i][0] == '-') {
+            /* switches are accepted for command-line compatibility only */
+            continue;
+        }
+        rc |= upgrade_pcbtext(argv[i]);
+        filecount++;
+    }
+
+    if (filecount == 0) {
+        fputs("No PCBTEXT files specified.\n", stdout);
+        return 1;
+    }
