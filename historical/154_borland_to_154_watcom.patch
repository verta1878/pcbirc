+void LIBENTRY deletechar(int X, int Y, char C, int Len) {
+#ifdef __OS2__
+  char *p = (char *) Scrn_Buf;
+
+  for (p += (Y*160 + X*2); Len != 0; Len--, p += 2)
+    *p = *(p+2);
