+char * LIBENTRY formattedLine(char * l)
+{
+    static char line[40*2+1];
+    sprintf(line,"%-*.*s%s",(strlen(l) > 40) ? 37 : 40,
+        (strlen(l) > 40) ? 37 : 40, l, (strlen(l) > 40) ? "..." : "");
+    stripleft(line,' ');
+    stripright(line,' ');
+    return line;
