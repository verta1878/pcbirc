+    if (aliasThis.seek(0L,SEEK_SET)            != 0L)             return -1;
+    if (aliasThis.read(&tmpHMN,sizeof(tmpHMN)) != sizeof(tmpHMN)) return -1;
+    aliasThis.pos(pos);
+    return tmpHMN;
+}
