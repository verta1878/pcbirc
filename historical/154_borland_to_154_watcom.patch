+extern int DebugLevel;
+
+void debugLog(int level, char * fmt, ...)
+{
+    if (DebugLevel >= level)
+    {
+        char buf[80+1];
+        va_list args;
+
+        va_start(args,fmt);
+        vsprintf(buf,fmt,args);
+        va_end(args);
+
+        writelog(buf,SPACERIGHT);
+    }
+}
