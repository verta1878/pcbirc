+    #ifdef __OS2__
+      turndisplayon(FALSE);
+      PauseUpdate = FALSE;
+    #else
+      updatetime();
+      turndisplayon(FALSE);
+    #endif
+    #ifdef PCBSTATS
+      if (! Status.LocalStats && checkstats(&Stats,FALSE))
+        updatestatus();
+    #endif
+    setcursor(CUR_BLANK);  /* turn it BACK OFF */
+  }
