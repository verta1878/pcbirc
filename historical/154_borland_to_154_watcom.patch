+void pascal procArgs(void)
+{
+	for (int i = 1; i < _argc; ++i)
+	{
+		char * arg = _argv[i];
+		if ((*arg == '/') || (*arg == '-'))
+		{
+			++arg;
+			if		(memicmp(arg,"DISARR",6) == 0)
+			{
+				disArrSubChk = TRUE;
+			}
+			else if (memicmp(arg,"NOUVAR",6) == 0)
+			{
+				autoUVar	 = FALSE;
+			}
+			else if (memicmp(arg,"NODISP",6) == 0)
+			{
+				dispStat = FALSE;
+			}
+		}
+		else
+		{
+			strupr(strcpy(name,arg));
+			char * p = strrchr(name,'\\');
+			p = (p ? ++p : name);
+			if (strchr(p,'.') == NULL) strcat(p,".PPS");
+		}
+	}
