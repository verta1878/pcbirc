+#ifndef printpaddedline
+static void _NEAR_ LIBENTRY printpaddedline(char *Buffer) {
+  int Num;
+  int Tabs;
+
+  if (UseAnsi && ! Status.Capture) {
+    for (Num = 0; *Buffer == ' '; Num++, Buffer++);
+    Tabs = Num / 8;
+    Num -= Tabs * 8;
+    for (; Tabs; Tabs--)
+      print("\t");
+    for (; Num; Num--)
+      Buffer--;
+  }
+  printit(Buffer);
+}
