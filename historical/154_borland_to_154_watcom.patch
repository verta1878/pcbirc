+				makeusersys();
+				*Status.DoorName = '\0';
+#endif
+				break;
+
+			case TOK_NEWPWD:	 // ... TOK_NEWPWD EXPR VAR ...
+				EVAL(tmpString,r,nullErrBreak);
+
+				d = getVarSubPtr();
+				nullErrBreak(d);
+
+                tmpBoolean = (int) !setnewpassword(ptrUData,
+					strupr(nul2mty(tmpString)));
