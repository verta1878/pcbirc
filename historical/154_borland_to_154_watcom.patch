+struct s
+{
+    int a;
+
+    int operator == (s & S) { return a == S.a; }
+    int operator != (s & S) { return !(*this == S); }
+    int operator <  (s & S) { return a < S.a; }
+    int operator <= (s & S) { return (*this < S) || (*this == S); }
+    int operator >  (s & S) { return a > S.a; }
+    int operator >= (s & S) { return (*this > S) || (*this == S); }
+
+};
