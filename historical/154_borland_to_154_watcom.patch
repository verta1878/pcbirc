+void scriptErr(int handNum, int lineNum, int textNum, char * format, ...)
+{
+#ifdef  ___COMP___
+    char warnFlag = FALSE;
+
+    if (textNum < 0)
+    {
+        warnFlag = TRUE;
+        textNum *= -1;
+    }
+#endif
+
+    int dispFlag = TRUE;
+
+#ifdef  ___EXEC___
+    if ((textNum != SCR_ERR_CUSR) && (textNum != SCR_ERR_EUSR) &&
+        (Status.CurSecLevel < PcbData.SysopSec[SEC_SYSOPLEVEL]))
+        dispFlag = FALSE;
