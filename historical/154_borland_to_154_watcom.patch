+	/*------------------------------------------------------------------*/
+
+void LIBENTRY cSCRIPT::seekChan(int chan, long pos, char meth)
+{
+	if (!fileArr[chan].inUse)
+	{
+		fileArr[chan].errStat = TRUE;
+		return;
+	}
+	long off = dosfseek(&fileArr[chan].hand,pos,meth);
+	if (off < 0L)
+		fileArr[chan].errStat = TRUE;
