+    int386(0x16, &r, &r);
+    return (r.w.cflag & 0x40) ? 0 : 1;
+  }
+  r.h.ah = Option;
+  int386(0x16, &r, &r);
+  return r.w.ax;
+#else
+asm   Cmp   byte ptr Option,1
+asm   Jne   GetKey
+asm   Mov   Ah,1
+asm   Int   16h
+asm   Jnz   GotOne
+      return(0);
+GotOne:
+      return(1);
+
+GetKey:
+asm  Mov    Ah,Option
+asm  Int    16h
+     return(_AX);
+#endif
