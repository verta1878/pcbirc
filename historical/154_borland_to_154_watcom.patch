+  //  Tags an area in the Scrollback Buffer by reversing the video attributes
+  //  (taken from the following C code:)
+
+  X1 = (X1 << 1);
+  X2 = (X2 << 1);
+
+//Ofs = Yoffsets[Y];
+  p = ScrlOfsArray[Y];
+
+  for (X = X1; X <= X2; ) {
+//  *Str++ = ((char *) Scrn_Buf)[Ofs + X++];
+//  ((char *) Scrn_Buf)[Ofs + X++] = Attr;
+    *Str++ = p[X++];
