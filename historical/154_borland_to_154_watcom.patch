+void LIBENTRY shelltodos(void) {
+  long     StartTime;
+  long     StopTime;
+  char     Str[10];
+
+  StartTime = gettimer(6);
+
+  #ifndef LIB
+  writeusernetstatus(OUTINDOS,NULL);
+  #endif
+
+  #ifndef __OS2__ // don't use environment size for OS/2 shells
+  if (PcbData.EnvSize != 0)
+    sprintf(Str,"/e:%d",PcbData.EnvSize);
