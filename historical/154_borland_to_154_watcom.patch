+/*!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!*/
+
+
+#ifdef __BORLANDC__
+  #include <alloc.h>
+#else
+  #include <malloc.h>
+#endif
+
+#ifndef __OS2__
+  #include "model.h"
+#endif
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "misc.h"
+#include "dosfunc.h"
+#include "pcb.h"
