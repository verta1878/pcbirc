+long LIBENTRY cMSG::lowMsgNum(void)
+{
+    cBSREAL tmpLMN;
+    long pos = aliasThis.pos();
+    if (aliasThis.seek(4L,SEEK_SET)            != 4L)             return -1;
+    if (aliasThis.read(&tmpLMN,sizeof(tmpLMN)) != sizeof(tmpLMN)) return -1;
+    aliasThis.pos(pos);
+    return tmpLMN;
+}
