+static void _NEAR_ LIBENTRY removegarbage(char *Str) {
+  char *p;
+
+  if (! PcbData.DisableEdits) {
+    for (p = Str; *p != 0; ) {
+      if ((*p < 'A' && strchr(" -,.'0123456789&",*p) == NULL) || *p > 'Z')
+        memmove(p,p+1,strlen(p));
+      else
+        p++;
+    }
+  }
+  stripall(Str,'\xFF');
+  stripright(Str,' ');
+  stripleft(Str,' ');
+}
