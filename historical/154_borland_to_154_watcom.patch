+int LIBENTRY cSCRIPT::redimArray(cSCRIPT & obj, int num)
+{
+	static cVAR * vp   = NULL;
+	static int	  dims = 0;
+	static int	  cd   = 0;
+	static int	  md   = 0;
+	static int	  vd   = 0;
+
+	int * ip = NULL;
+
+	checkstack();
+	switch (num)
+	{
+		case 0:
+			vp = obj.getVarPtr();
+			dims = 0;
+			cd = 0;
+			md = 0;
+			vd = 0;
+			if (vp == NULL) return TRUE;
+			break;
+
+		case 1:
+			ip = &vd;
+			break;
+
+		case 2:
+			ip = &md;
+			break;
+
+		case 3:
+			ip = &cd;
+			break;
+	}
+
+	if (num > 0)
+	{
+		++dims;
+
+		cVARVAL * v = obj.evalArg();
+		if (v == NULL) return TRUE;
+
+		obj.tmpInteger = *v;
+		*ip = int(obj.tmpInteger.values.vINTEGER);
+	}
+
+	if (vp->redimArray(dims,vd,md,cd)) return TRUE;
+
+	return FALSE;
+}
