+
+#pragma argsused
+int pascal cSCRIPT::tokenVARS(cSCRIPT & obj, sKEYWORD & inf, char * args,
+    int line, int pass)
+{
+    return obj.doVariable(-1*inf.tokenVal,args,line,pass);
+}
