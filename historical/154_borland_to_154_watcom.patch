+void LIBENTRY cSCRIPT::closeChan(int chan)
+{
+	if (!fileArr[chan].inUse || (dosfclose(&fileArr[chan].hand) != 0))
+		fileArr[chan].errStat = TRUE;
+
+	fileArr[chan].inUse = FALSE;
+}
