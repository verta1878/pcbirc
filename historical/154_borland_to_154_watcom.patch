+#ifndef LIB
+bool LIBENTRY seclevelokay(char *Cmd, int SecLvlReq) {
+  if (Status.CurSecLevel < SecLvlReq) {
+    bell();
+    freshline();
+    maxstrcpy(Status.DisplayText,Cmd,sizeof(Status.DisplayText));
