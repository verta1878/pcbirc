+/* checkReject() return codes. */
+#define REJECT_NONE     0    /* sender allowed â€” deliver normally */
+#define REJECT_DROP     1    /* sender rejected â€” silently drop */
+#define REJECT_BOUNCE   2    /* sender rejected â€” bounce (email only) */
