+static void _NEAR_ LIBENTRY updatescreen(xfertype XferType) {
+  int  static OldErrors;
+  int  Mark;
+  long Time;
+  char Str[80];
+
+  if (Errors != OldErrors) {
+    OldErrors = Errors;
+    if (Errors == 0) {
+      fastprint(13,5,"0 ",XferColors->Numbers);
+      if (XferType == UPLOAD)
+        fastprint(15,5,"                   ",XferColors->Numbers);
