+int LIBENTRY COMMDRV_inbytes(void) {
+#ifdef OLDARNET
+  ser_rs232_getpacket(Port,32767,NULL);     /*lint !e534 */
+#else
+  if (pcb.cardtype == CARD_DIGCXI)
+    ser_rs232_getpacket(Port,32767,NULL);   /*lint !e534 */
+#endif
+  return(pcb.opcb->inbuf_count);
+}
