+#pragma pack(1)
+struct UMWF_RECORD
+{
+    char     name [ 25 ];
+    uint     conf;
+};
+#pragma pack()
+
+const int maxUMWFListSize = 32767U / sizeof(UMWF_RECORD); // 65535U / sizeof(UMWF_RECORD);
+
+// static UMWF_RECORD _FAR_ umwfList [ maxUMWFListSize ];
+
+static UMWF_RECORD * umwfList = NULL;
+
+static int umwfSize = 0;
