+    asm Xchg Al,Ah
+    asm Stosw
+
+    asm Mov  Al,':'
+    asm Stosb
+
+    asm Mov  Al,SysTime.Minutes
+    asm Aam
+    asm Or   Ax,3030h
+    asm Xchg Al,Ah
+    asm Stosw
+
+    asm Mov  Al,':'
+    asm Stosb
+
+    asm Mov  Al,SysTime.Seconds
+    asm Aam
+    asm Or   Ax,3030h
+    asm Xchg Al,Ah
+    asm Stosw
+
+    asm Xor  Ax,Ax
+    asm Stosb
+  #endif /* ifdef __OS2__ */
+
+  return(TStr);
+}
