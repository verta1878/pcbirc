+void LIBENTRY doCMD(bool tryCmdList, char * cmdLine)
+{
+    char tokLine [ 256 + 1 ];
+
+    strcpy(tokLine,cmdLine);
+
+    int toks = tokenize(tokLine);
+    if (toks > 0)
+    {
+        int tries = 0;
+        char * cmd = getnexttoken();
+        doCommand(!tryCmdList,cmd,toks,tries,tokLine,sizeof(tokLine),cmdLine);
+    }
+}
