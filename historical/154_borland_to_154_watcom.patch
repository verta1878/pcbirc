+  asm  Xor  Ax,Ax
+  asm  Mov  Bx,Ax
+  asm  Mov  Al,Y2            /*                                              */
+  asm  Mov  Dl,Al            /*                                              */
+  asm  Sub  Dl,Y1            /* Dl = number of lines (Y2-Y1)                 */
+  asm  Mov  Bl,80            /*                                              */
+  asm  Mul  Bl               /*                                              */
+  asm  Add  Al,X1            /*                                              */
+  asm  Adc  Ah,0             /*                                              */
+  asm  Shl  Ax,1             /*                                              */
+  asm  Add  Di,Ax            /* Di = pointer to Y2*160 + X1*2                */
+  asm  Mov  Si,Di            /*                                              */
+  asm  Sub  Si,160           /* Si = pointer to (Y2-1)*160 + X1*2            */
+  asm  Mov  Bl,X2            /*                                              */
+  asm  Sub  Bl,X1            /*                                              */
+  asm  Inc  Bl               /* Bl = X2-X1+1 = number of words to move       */
+
+  asm  Cmp  Bl,80            /* are we doing a full length line?             */
+  asm  Jne  partline         /*   no, use the loop method                    */
+
+fullline:
+  asm  Mov  Al,Dl            /*                                              */
+  asm  Mul  Bl               /*                                              */
+  asm  Mov  Cx,Ax            /* Cx = 80*Dl = number of words to move         */
+  asm  Rep  Movsw            /* move all of the bytes in one fell swoop      */
+  asm  Jmp  short blankline  /*                                              */
+
+partline:
+  asm  Mov  Ax,160
+  asm  Sub  Ax,Bx
+  asm  Sub  Ax,Bx
+loop:
+  asm  Mov  Cx,Bx
+  asm  Rep  Movsw
+  asm  Add  Di,Ax
+  asm  Add  Si,Ax
+  asm  Dec  Dl
+  asm  Jnz  loop
+
+blankline:
+  asm  Mov  Al,' '
+  asm  Mov  Ah,Color
+  asm  Mov  Cx,Bx
+  asm  Rep  Stosw
+
+  asm  Cld
+  asm  Pop  Ds
+
+  NEEDSEGPOPDS;
+#endif  /* ifdef BIOS */
+#endif  /* ifdef __OS2__ */
+}
