+
+/********************************************************************
+ *
+ *  Function:  stripright()
+ *
+ *  Strips character Ch's from the right side of Str[]
+ */
+
+char * LIBENTRY stripright(char *StrPtr, char SrchChar) {
+#if defined(__OS2__) || defined(__WATCOMC__)
+  char *p;
+
+  for (p = &StrPtr[strlen(StrPtr)-1]; *p == SrchChar && p >= StrPtr; p--);
+  *(++p) = 0;
+
+#else  /* ifdef __OS2__ */
+
+#ifdef LDATA
+  asm   les  si,StrPtr
+#else
+  asm   mov  ax,ds
+  asm   mov  es,ax
+  asm   mov  si,StrPtr
+#endif
+
+asm   mov   di,si
+asm   xor   ax,ax
+asm   mov   cx,-1
+asm   repne scasb
+asm   not   cx
+asm   dec   cx
+
+asm   jcxz skip
+asm   dec  cx
+
+asm   mov  di,si
+asm   add  di,cx
+asm   mov  al,SrchChar
+
+asm   std
+asm   scasb
+asm   jne  skip
+asm   repe scasb
+asm   jz   j1
+asm   inc  di
+j1:
+asm   inc  di
+j2:
+
+asm   mov  al,ah
+asm   stosb
+
+skip:
+  asm   cld
+#endif  /* ifdef __OS2__ */
+
+  return(StrPtr);
+}
