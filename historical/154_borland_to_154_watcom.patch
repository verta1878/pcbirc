+  #ifndef PCB_DEMO
+//  fastputc(XY,collect());  XY += 2;
+  #endif
+
+  if (DisableAnswer)     // Intel SatisFAXtion requires the "ATA\r" be
+    AnswerStr[0] = 0;    // disabled in order for FAX and DATA to be supported
+  else {
+    strcpy(AnswerStr,PcbData.ModemAns);
+    addchar(AnswerStr,'\r');
+  }
+
+  #ifndef PCB_DEMO
+//  fastputc(XY,collect());  XY += 2;
+  #endif
