+unsigned LIBENTRY averagecps(long Bytes, trntype TranType) {
+  int      X;
+  qint     Temp;
+  qint     Total;
+  spectype File;
+
+  for (X = 0, Total = 0; X < NumFiles; X++) {
+    if (getfilespec(X,&File) == -1)
+      break;
+    if (File.Success == TranType) {
+      Temp   = File.CPS;
+      Temp  *= File.Size;
+      Total += Temp;
+    }
+  }
+  return((unsigned) (Total / (qint) Bytes));
+}
