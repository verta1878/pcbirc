+
+  strcpy(Str,"This is a test");
+  padstr(Str,'.',20);
+  printf("%s!\n",Str);
+
+  strcpy(Str,"This is a test");
+  padstr(Str,'.',5);
+  printf("%s!\n",Str);
+}
