+static void _NEAR_ LIBENTRY callupdate(char *UpdatedLines) {
+  int FirstY = 255;
+  int LastY  = 0;
+  int Y;
+
+  for (Y = 0; Y <= MaxRow; Y++) {
+    if (UpdatedLines[Y]) {
+      if (Y < FirstY)
+        FirstY = Y;
+      if (Y > LastY)
+        LastY = Y;
+      UpdatedLines[Y] = 0;
+    }
+  }
+
+  updatelines(UPDATE_MIXED,FirstY,LastY);
+}
