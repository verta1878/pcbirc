+
+void LIBENTRY packusers(int NumTokens) {
+  if (Status.UserRecNo != 1) {
+    displaypcbtext(TXT_NOTRECNUMONE,NEWLINE);
+    return;
+  }
+  pack(NumTokens,TXT_PACKTHEUSERSFILE,USRFILE);
+}
