+  checkstack();
+  wsmovecursor(48,PageLen+4,ABSOLUTE);
+  if (Insert)
+    displaypcbtext(TXT_INSFOROVERWRITE,DEFAULTS);
+  else
+    displaypcbtext(TXT_INSFORINSERT,DEFAULTS);
+  cleareol();
+  printdefcolor();
+}
