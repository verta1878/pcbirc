+int LIBENTRY inputfieldint(int Default, char *Prompt, int Color, int MaxLen, DISPLAYTYPE DisplayCtrl, int HelpNum) {
+  return((int) inputfieldlong(Default,Prompt,Color,MaxLen,DisplayCtrl,HelpNum));
+}
