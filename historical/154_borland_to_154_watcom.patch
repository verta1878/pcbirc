+/****************************************************************************/
+/* Wait for a byte to come into the modem buffer.						 */
+
+static bool _NEAR_ LIBENTRY gotabyte(int Ticks)
+{
+	settimer(4,Ticks);
+	while(1)
+	{
+		if(InBytes!=0)
+		return(TRUE);
+		if(timerexpired(4))
+		return(FALSE);
+		#ifndef __OS2__
+		giveup();
+		#endif
+	}
+}
