+/****************************************************************************/
+/* Add polls																*/
+
+static void _NEAR_ LIBENTRY add_freqs(char *freq_list)
+{
+char		*ptr,*p;
+char		addr[35];
+char		tmpBuf[81];
+cNEWQ	Q;
+
+
+	maxstrcpy(tmpBuf,freq_list,sizeof(tmpBuf));
+	p=ptr=tmpBuf;
+
+	if((p=strchr(ptr,','))!=NULL)
+	{
+		p++;
+		if((ptr=strtok(p," "))!=NULL)
+		{
+			maxstrcpy(addr,ptr,sizeof(addr));
+			if((ptr=strtok(NULL," "))!=NULL)
+				Q.addFREQ(addr,ptr);
+		}
+	}
+}
