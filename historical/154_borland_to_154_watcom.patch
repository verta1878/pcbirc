+	 assert(strlen(emsi.addr) < sizeof(emsi.addr));
+  }
+  else if(RemoteHello.my_zone==0 && RemoteHello.my_point==0)
+  {
+	 sprintf(emsi.addr,"%u/%u",RemoteHello.my_net,RemoteHello.my_node);
+	 assert(strlen(emsi.addr) < sizeof(emsi.addr));
