+                nrec.point = rec.point;
+                nrec.pkt_type = rec.pkt_type;
+                nrec.archiver_index = rec.archiver_index;
+
+                fwrite(&nrec,sizeof(nrec),1,afile);
+        }
+        fclose(afile);
+}
