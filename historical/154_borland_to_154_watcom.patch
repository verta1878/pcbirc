+                int putnln  ( const char * str = NULL ) { int rv = puts(str);
+                                                          if (rv == 0)
+                                                              rv = putch(NUL);
+                                                          return rv; }
+
+        // Functions for formatted input/output
+        int scanf  ( const char * fmt, ... );
