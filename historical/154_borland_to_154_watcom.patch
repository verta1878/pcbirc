+uint KbdShiftStatus;
+static bool ShiftMonitorEnabled = FALSE;
+static bool ScrollLockEnabled = FALSE;
+
+static uint  KbdHandle = 0;  // default to system kbd handle
+
+
+void LIBENTRY openkbdhandle(void) {
+//KbdOpen(&KbdHandle);
