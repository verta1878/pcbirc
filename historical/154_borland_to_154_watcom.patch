+unsigned long LIBENTRY crc32buf(char *buf, unsigned len) {
+  unsigned long c;
+
+  if (len == 0)
+    return(0);
+
+  for (c = 0xFFFFFFFFL; len > 0; len--, buf++)
+    c =  (crc32tab[((unsigned int)c ^ *buf) & 0xFF] ^ ((c >> 8) & 0x00FFFFFFL));
+
+  return(~c);
+}
+
+
+unsigned long LIBENTRY crc32file(char *file) {
+  unsigned long  c;
+  unsigned       BytesRead;
+  char          *p;
+  DOSFILE        File;
+  char           buf[CRCBUFSIZE];
+
+  if (file[0] == 0)
+    return(0);
+
+  if (dosfopen(file,OPEN_READ|OPEN_DENYNONE,&File) == -1)
+    return 0;
+
+  c = 0xFFFFFFFFL;
+  while (1) {
+    if ((BytesRead = dosfread(buf,CRCBUFSIZE,&File)) <= 0)
+      break;
+
+    for (p = buf; BytesRead > 0; BytesRead--, p++)
+      c = (crc32tab[((unsigned int)c ^ *p) & 0xFF] ^ ((c >> 8) & 0x00FFFFFFL));
+  }
+
+  dosfclose(&File);
+  return(~c);
+}
