--- PCBSRCV/019/MAIN/SOURCE/UTIL/PCBSM/EXTRAOBJ/SCROLLUP.C	1970-01-01 00:00:00.000000000 +0000
+++ PCBSRC/MAIN/SOURCE/UTIL/PCBSM/EXTRAOBJ/SCROLLUP.C	2026-07-30 13:17:17.266096797 +0000
@@ -0,0 +1,17 @@
+/*  SCROLLUP.C â€” plain-C replacement for Clark's inline-asm scrollup.        */
+/*  Uses BIOS INT 10h AH=06 to scroll a rectangular region.                  */
+/*  hexadecimal, v0.032.                                                    */
+
+#include <dos.h>
+
+void pascal scrollup(int X1, int Y1, int X2, int Y2, unsigned char Color) {
+    union REGS r;
+    r.h.ah = 0x06;      /* scroll up */
+    r.h.al = 0x01;      /* one line */
+    r.h.bh = Color;
+    r.h.ch = (unsigned char)Y1;
+    r.h.cl = (unsigned char)X1;
+    r.h.dh = (unsigned char)Y2;
+    r.h.dl = (unsigned char)X2;
+    int86(0x10, &r, &r);
+}
