+void LIBENTRY cls(void) {
+  #ifdef __OS2__
+    int X;
+    unsigned long *p;
+    p = (unsigned long *) Scrn_Buf;
+    for (X = 0; X < Scrn_Size32; X++, p++)
+      *p = 0x07200720;
