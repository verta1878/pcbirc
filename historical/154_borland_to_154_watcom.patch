+  return(msgbasestats(&Stats) == -1 ? 0 : Stats.LowMsgNum);
+}
+
+long LIBENTRY highmsgnum(void) {
+  msgbasestattype Stats;
+  return(msgbasestats(&Stats) == -1 ? 0 : Stats.HighMsgNum);
+}
