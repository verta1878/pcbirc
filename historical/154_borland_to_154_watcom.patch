+        case 1:
+            ti = a[0];    // MM-DD-YY -> DD-MM-YY
+            a[0] = a[1];
+            a[1] = ti;
+            break;
+
+        case 2:
+            ti = a[0];    // MM-DD-YY -> YY-MM-DD
+            a[0] = a[2];
+            a[2] = a[1];
+            a[1] = ti;
+            break;
+    }
