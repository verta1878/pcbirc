+static void _NEAR_ LIBENTRY showignore(void) {
+  bool FirstTime;
+  int  X;
+  char Str[10];
+
+  for (X = 1, FirstTime = TRUE; X < NUMNODES; X++) {
+    if (isset(IgnoreNodes,X)) {
+      if (FirstTime) {
+        displaypcbtext(TXT_IGNORINGNODES,LFBEFORE);
+        FirstTime = FALSE;
+      } else {
+        print(", ");
+      }
+      ascii(Str,X);
+      print(Str);
+    }
+  }
+
+  if (! FirstTime)
+    newline();
+}
