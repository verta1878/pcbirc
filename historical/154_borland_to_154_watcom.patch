+
+#define  OPEN_PRIVATE  0x80     /* file should be PRIVATE; no-inheritance  */
+
+#define  OPEN_DENYRDWR 0x10     /* share mode: deny read/write (exclusive) */
+#define  OPEN_DENYWRIT 0x20     /* share mode: deny write access           */
