+char * LIBENTRY slowdrive(char *SlowDrives, char DriveLetter) {
+  char *p;
+
+  for (p = SlowDrives; *p > 0; p++) {
+    if (*p > ' ') {
+      if (*p == DriveLetter)
+        return(p);
+
+      if (*p == '-' && p != SlowDrives) {
+        if (*(p-1) < DriveLetter && *(p+1) >= DriveLetter)
+          return(p-1);
+      }
+    }
+  }
+  return(NULL);
+}
