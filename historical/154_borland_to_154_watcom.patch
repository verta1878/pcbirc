+void LIBENTRY removeqwkfiles(bool All) {
+  static char *Types[8] = {"MESSAGES.DAT","CONTROL.DAT","PCBQWK.LST","NETFLAGS.DAT","ATTACHED.LST","*.NDX","*.QWK","*.REP"};
+  int  X;
+  int  Last;
+  char *p;
+  char Temp[66];
+
+  checkstack();
+  strcpy(Temp,PcbData.TmpLoc);
+  p = &Temp[strlen(Temp)];
+
+  Last = (All ? 8 : 6);
+
+  for (X = 0; X < Last; X++) {
+    strcpy(p,Types[X]);
+    deletefiles(Temp);
+  }
+}
