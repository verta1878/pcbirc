+
+void LIBENTRY cSCRIPT::flushChan(int chan)
+{
+	if (!fileArr[chan].inUse)
+	{
+		fileArr[chan].errStat = TRUE;
+		return;
+	}
+
+	if (dosflush(&fileArr[chan].hand) != 0)
+		fileArr[chan].errStat = TRUE;
+}
