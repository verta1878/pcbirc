+
+char static OldSec;
+
+char pascal timechanged(void) {
+#ifdef __WATCOMC__
+  union REGS r;
+  r.h.ah = 0x2C;
+  int386(0x21, &r, &r);
+  if (r.h.dh != OldSec) {
+    OldSec = r.h.dh;
+    return 1;
+  }
+  return 0;
+#else
+  asm Mov Ah,2Ch
+  asm Int 21h
+  asm Xor Ax,Ax
+  asm Cmp Dh,OldSec
