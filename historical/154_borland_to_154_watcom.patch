+void LIBENTRY cSCRIPT::putChan(int chan, char * str)
+{
+	if (!fileArr[chan].inUse)
+	{
+		fileArr[chan].errStat = TRUE;
+		return;
+	}
+
+	if (dosfputs(str,&fileArr[chan].hand) != 0)
