+void LIBENTRY unhidescreen(void) {
+  HideScreen = FALSE;
+  updatelines(UPDATE_25LINES,0,0);
+  VioSetCurPos(Scrn_Y,Scrn_X,0);
+  updatelinesnow();
+}
