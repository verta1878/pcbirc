+static void _NEAR_ LIBENTRY addkeytooutbuf(char Key) {
+  CharsInBuffer++;
+  ChatOutBuf[WritePtrInMemory] = Key;
+
+  WritePtrInMemory++;
+  if (WritePtrInMemory >= BUFSIZE)
+    WritePtrInMemory = 0;
+}
