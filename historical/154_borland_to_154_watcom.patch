+    { "\x0A""STK_LIMIT",      STACK_CEILING + 1024 },
+    { "\x05""S_DB",           0x03     },
+    { "\x05""S_DN",           0x00     },
+    { "\x05""S_DR",           0x01     },
+    { "\x05""S_DW",           0x02     },
+    { "\x0A""TIME_BANK",      0x0A     },
+    { "\x05""TRUE",           0x01     },
+    { "\x07""UPCASE",         0x00008L },
+    { "\x0A""WARNLEVEL",      0x0E     },
+    { "\x09""WORDWRAP",       0x00200L },
+    { "\x06""YESNO",          0x04000L }
+};
