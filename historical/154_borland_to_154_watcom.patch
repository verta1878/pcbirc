+int LIBENTRY cMSG::readHdr(long off)
+{
+    msgHdrOff = -1;
+
+    if (off < 0) return -1;
+
+    if (cDOSFILE::seek(off,SEEK_SET)           != off)            return -1;
+    if (cDOSFILE::read(&msgHdr,sizeof(msgHdr)) != sizeof(msgHdr)) return -1;
+
+    msgHdrOff = off;
+
+    return 0;
+}
