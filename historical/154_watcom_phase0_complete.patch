+  getsmconfig(&smConfig,ConfName);
+  ALLDATE[ALLDATE[0]] = Country.DateSep[0];
+
+/*  _fmode      = O_BINARY; */
+  setupscale(15,177,5);
+
+  #ifdef DEMO
+    strcpy(Str1,"Use w/PCB ");
+    strcat(Str1,PCBVer);
+    strcat(Str1," DEMO");
+  #else
+    strcpy(Str1,"Use w/ PCB ");
+    strcat(Str1,PCBVer);
