+typedef struct  {
+  char   Verb[20];
+  char   Params[45];
+} verbtype;
+
+#define NUMVERBS 8
+
+static char Verbs[NUMVERBS][20] = {"Allow-Human-Callers",
+                                   "Allow-Route-To",
+                                   "Poll",
+                                   "Hold",
+                                   "Crash",
+                                   "Route-To",
+                                   "FREQ",
+                                   "SEND"};
