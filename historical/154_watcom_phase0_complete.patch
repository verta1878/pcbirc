-char * pascal getparm(char *s)
-{
-    static char *tmps = NULL;
-
-    if (s == NULL) s = tmps;
-
-    if (s == NULL) return s;
-
-    char *rv = s;
-
-    if (*rv == '\"') ++rv;
-
-    tmps = strchr(rv,(rv != s) ? '\"' : ' ');
-
-    if (tmps != NULL)
-    {
-        *tmps = NUL;
-        ++tmps;
-    }
-
-    return rv;
-}
