-static unsigned long near pascal getBlockDate(const char * line)
-{
-char * ptr;
-char   buf[20];
-unsigned int mo,da,yr,hr,min;
-
-
-  ptr = (char *) line;
-  mo = atoi(ptr);
-
-  while(*ptr != '-' && *ptr != '\x0') ptr++;
-  da = atoi(++ptr);
-
-  while(*ptr != '-' && *ptr != '\x0') ptr++;
-  yr = atoi(++ptr);
-
-  while(*ptr != '(' && *ptr != '\x0') ptr++;
-  hr = atoi(++ptr);
-
-  while(*ptr != ':' && *ptr != '\x0') ptr++;
-  min = atoi(++ptr);
-
-  sprintf(buf,"%02d%02d%02d%02d%02d",mo,da,yr,hr,min);
-  return atol(buf);
-}
