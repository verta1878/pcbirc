+					if(found!=TRUE)
+					{
+						genResponseMsg(user,FREQFAIL,"Requesting node not found in nodelist");
+						return;
+					}
+					break;
+
+		case	'L':  done=FALSE;
+					found=FALSE;
+					first=TRUE;
+					tptr=ptr=nodestr;
+
+					while(done!=TRUE)
+					{
+						if((ptr=strchr(tptr,' '))!=NULL)
+						{
+							first=FALSE;
+							tmp=*ptr;
