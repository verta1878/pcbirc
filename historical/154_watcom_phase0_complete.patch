+// ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ
+int  sortname(const void *l, const void *r)
+{
+   manufdatatype *lp = (manufdatatype *) l;
+   manufdatatype *rp = (manufdatatype *) r;
