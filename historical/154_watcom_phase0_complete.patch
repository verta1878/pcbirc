-void fnNewRecNum ( unsigned *iNdx1 ) {
- unsigned NewNum;
- unsigned Num;
-
-  clsbox(1,8,20,8,Colors[QUESTION]);
-  NewNum = Num = *iNdx1;
-  inputnum(  1, 8, 3, "Record Number", &NewNum, vINT, 0 );
-  if (KeyFlags != ESC) {
-    if (NewNum < 1)
-      Num = 1;
-    else if (NewNum > TEXT_ARRAY-1)
-      Num = TEXT_ARRAY-1;
-    else
-      Num = NewNum;
-  }
-  dosfseek(&fptOut, Num * 80L , SEEK_SET);
-  *iNdx1 = Num;
-  KeyFlags = NOTHING;
-}
