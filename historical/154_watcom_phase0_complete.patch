+// C++ class for implementing editing functions using VMData
+
+#ifndef __EDITCLASS__
+#define __EDITCLASS__
+
+#ifndef H_SCREEN
+#include <screen.h>
+#endif
+
+#ifndef H_DOSFUNC
+#include <dosfunc.h>
+#endif
+
+#ifndef H_SCRNIO
+#include <scrnio.h>
+#endif
