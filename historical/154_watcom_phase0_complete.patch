+#ifndef DEMO
+void  processdirfile(unsigned BoardNumber, unsigned DirNumber, bool ScanDlPath, char *ApplyRulesName) {
+  unsigned       HighNum;
+  unsigned       NumTextDirs;
+  loadflagstype  LoadFlags;
