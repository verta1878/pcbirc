+class cBSREAL
+{
+
+    public:
+
+        cBSREAL                 ( long i = 0 ) { *this = i; }
+        cBSREAL & operator =    ( long i )     { longtobassngl(bs,i);
+                                                 return *this; }
+                  operator long ( void )       { return bassngltolong(bs); }
+
+    protected:
+
+        bassngl bs;
+
+};
