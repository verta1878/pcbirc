-
-static int bsearchcomp(const void *a, const void *b) {
-  const IndexType *bRec;
-  bRec = (IndexType *) b;
-  return(memcmp(a,bRec->UserName,sizeof(bRec->UserName)));
-}
-
-static int bsearchcomp2(const void *a, const void *b) {
