-         if (SHORT1FROMMP(mp1) == OPEN_COVERPAGE) {
-           hws.pfnwp = WinSubclassWindow(HWNDFROMMP(mp2),(PFNWP)HelpFrameSubProc);
-           WinSetWindowULong(HWNDFROMMP(mp2),QWL_USER,(ULONG)&hws);
-           return(0);
