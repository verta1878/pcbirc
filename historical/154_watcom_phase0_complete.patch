+  asm xor   al,dl
+  asm mov   cl,bl
+  asm add   cl,dl
+  asm rol   ax,cl
+  asm stosw
+  asm mov   bx,ax
+  asm dec   dx
+  asm jmp   short top
+
+done:
+  asm test  word ptr Len,1
+  asm jz    exit
+  asm lodsb
+  asm rol   al,cl
+  asm xor   al,bl
+  asm stosb
+
+exit:;
+#ifdef LDATA
