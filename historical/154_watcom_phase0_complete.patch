-#define USERNETFLAGSIZE ((Header.NumOfNodes+7)/8)
-#define USERNETSTART    (sizeof(usernethdrtype) + (USERNETFLAGSIZE*2))
-#define USERNETFLAGS    (sizeof(usernethdrtype) + USERNETFLAGSIZE)
