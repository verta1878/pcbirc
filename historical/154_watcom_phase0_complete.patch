+void  checkfsec(char *Name) {
+  char    Buf[256];
+  char    Tmp[100];
+  char    Path[100];
+  DOSFILE TextFile;
+  char    CurDrive;
+  int     Exist;
+
+  if (dosfopen(Name,OPEN_READ|OPEN_DENYNONE,&TextFile) != -1) {
+    sprintf(Tmp,"\r\nChecking for existence of paths in %s:\r\n",Name);
+    dosfputs(Tmp,&prn);
+
+    while (dosfgets(Buf,256,&TextFile) != -1) {
