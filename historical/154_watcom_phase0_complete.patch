+void pascal cMSGINFO::sort ( void )
+{
+    sMSGINFO buf [ 112 ];
+    if (recCount() > 0)
+    {
+        cVMDATA::sort(sizeof(sMSGINFO),1,recCount(),VM_FALSE,cmpMsgInfo,
+            (VMSortFunc *) qsort, buf, sizeof(buf));
+    }
+}
