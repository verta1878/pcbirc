+Example 1 â€” Birthday greeter
+â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
+Greet users on their birthday when they log in.
+
+    ; BDAYGRT.PPS â€” Birthday Greeter
+    ; Runs from PCBTEXT record 87 (login banner)
+    STRING  today, bd
+    LET today = STRIP(DATE(),"/")           ; MMDDYY
+    LET bd = U_BIRTHDATE
+    IF (LEN(bd) = 6) THEN
+      IF (LEFT(bd,4) = LEFT(today,4)) THEN
+        PRINTLN "@X0EHappy Birthday, ",U_NAME(),"!  @X07"
+        NEWLINE
+      ENDIF
+    ENDIF
+
+Example 2 â€” Email harvester for sysop maintenance
+â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
+Print a list of all users with a set email address.  Sysop-only.
+
+    ; EMAILLST.PPS â€” dump users with email
+    INTEGER rec, n
+    STRING  em
+    LET n = U_RECNUM()
+    FOR rec = 1 TO n
+      GETUSER
+      LET em = U_EMAIL
+      IF (LEN(em) > 0) THEN
+        PRINTLN U_NAME()," <",em,">"
+      ENDIF
+      INC rec
+    NEXT
