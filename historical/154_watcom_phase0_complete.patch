+
+static void near pascal popup(char *Str1, char *Str2) {
+  memset(&MsgData,0,sizeof(MsgData));
+  MsgData.AutoBox = TRUE;
+  MsgData.Color1  = Colors[HEADING];
+  MsgData.Color2  = Colors[HEADING];
+  MsgData.Msg1    = Str1;
+  if (Str2 == NULL) {
+    MsgData.Line1 = 18;
+  } else {
+    MsgData.Line1 = 17;
+    MsgData.Line2 = 18;
+    MsgData.Msg2  = Str2;
+  }
+  showmessage();
+}
