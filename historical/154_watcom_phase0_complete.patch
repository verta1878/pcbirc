+/********************************************************************
+*
+*  Function: moveback()
+*
+*  Desc    : Copies the string from *Srce to *Dest, padding with spaces
+*/
+
+static void near pascal moveback(char *Dest, char *Srce, int Size) {
+  for (; *Srce; Size--, Dest++, Srce++)
+    if (Size)
+      *Dest = *Srce;
+    else
+      return;
+
+  for (; Size; Size--, Dest++)
+    *Dest = ' ';
+}
