+  asm  Lds  Si,Num
+#endif
+  asm  Mov  Ax,[Si]
+  asm  Aam
+  asm  Or   Ax,'00'
+  asm  Xchg Al,Ah
+  asm  Cmp  Al,'0'
+  asm  Jne  End
+  asm  Mov  Al,' '
+End:
+  asm  Mov  [Si],Ax
+#ifndef SDATA
+  asm  Pop  Ds
+#endif
+}
