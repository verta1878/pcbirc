+SCR6:
+    int row, col;
+    for (row = 0; row < 16; ++row)
+    {
+        for (col = 0; col < 8; ++col)
+        {
+            setXY(col*10+3,row+2);
+            int ch = col*16+row;
+            fastprintf("%3d %c",ch,
+                (strchr("\x07\x08\x09\x0A\x0C\x0D\x1A\x1B",ch) == NULL) ?
+                (char) ch : ' ');
+        }
+    }
+
+    ch = getKey();
+    cls();
+
+    switch (ch)
+    {
+        case PGUP: goto SCR5;
+        case ESC: goto EXIT;
+    }
+
+SCR7:
+    for (row = 0; row < 16; ++row)
+    {
+        for (col = 0; col < 8; ++col)
+        {
+            setXY(col*10+3,row+2);
+            int ch = (col+8)*16+row;
+            fastprintf("%3d %c",ch,
+                (strchr("\x07\x08\x09\x0A\x0C\x0D\x1A\x1B",ch) == NULL) ?
+                (char) ch : ' ');
+        }
+    }
+
+    ch = getKey();
+    cls();
+
+    switch (ch)
+    {
+        case PGUP: goto SCR6;
+        case ESC: goto EXIT;
+    }
+
+EXIT:
+    setWin(1,1,80,MAX_ROWS);
+    cls();
+    dispCurs();
+}
