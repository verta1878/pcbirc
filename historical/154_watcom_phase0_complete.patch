-bool LIBENTRY lastChar(char * s, char c)
-{
-    // If no string was passed in return immediately
-    if ((s == NULL) || (*s == '\0')) return FALSE;
-
-    // Return TRUE if c is the last character in s, FALSE otherwise
-    return (s[strlen(s)-1] == c);
-}
