+static void pascal near initcfgfields(FldType *P) {
+  addquest(P, 0,vUPSTR,FIDOAREACFG+0,ALLCHAR      , 2, 7,54,"Fido Area Name      ", Fido_Conference.AreaTag,        NOCLEARFLD,NULL);
