+
+!if $d(DEBUG)
+CODEOPT=-DDEBUG
+!endif
+
+!if $d(TD)
+CODEOPT = $(CODEOPT) -v
+ASMOPT  = $(ASMOPT) /v
+LINKOPT = $(LINKOPT) /v
+!endif
+
+COPT = -c
+
+!if $d(BC50)
+#leave out -Oe due to a bug in Borland C 4.0 thru 5.0
+COPT = $(COPT) -Obglmptv
+!elif $d(TC30)
+#leave out all of the extra -Oxxx switches for TC 3.0 because they aren't valid
+!elif $d(BC31)
+COPT = $(COPT) -Oebglmptv
+!endif
+
+ASMOPT = /m /mx /t /D__$(MDL)__                 # Assembler options
+
+LINKOPT = /x /c
+
+!if $d(TD)
+COPT    = $(COPT) -v
+ASMOPT  = $(ASMOPT) /v
+LINKOPT = $(LINKOPT) /v
+!endif
+
+
