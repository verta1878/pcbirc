+Example 7 â€” MD5LOGIN fast-path
+â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
+Skip password prompt for callers whose terminal sent a valid MD5.
+
+    ; MD5FAST.PPS â€” called from BOARD.PPE or LOGIN.PPE
+    STRING hash, computed
+    LET hash = GETENV("MD5LOGIN")
+    IF (LEN(hash) = 32) THEN
+      ; caller's terminal computed MD5(secret + timestamp) â€” validate
+      LET computed = COMPUTEMD5(U_PWD + TIMESTAMP())
+      IF (hash = computed) THEN
