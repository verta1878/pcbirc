+static bool near pascal findpsa(char *Str) {
+  psatype *p;
+
+  for (p = PSAs; p < &PSAs[TOTALPSAS]; p++)
+    if (strcmp(p->Name,Str) == 0)
+      return(TRUE);
+
+  return(FALSE);
+}
