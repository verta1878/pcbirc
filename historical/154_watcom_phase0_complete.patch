-void pascal showfileinusernet(char Mode, char *Name, long FileSize) {
-  char *p;
-  char Time[30];
-  char Size[30];
-  char Operation[80];
-
-  for (p = Name; *p != 0; p++)      /* skip over drive letter and path */
-    if (*p == '\\' || *p == ':')
-      Name = p + 1;
-
-  sprintf(Operation,"(%c) %s (ZM) %s  - %s",
-          Mode,
-          Name,
-          comma(Size,FileSize),
-          downloadtime(FileSize,Time));
-  writeusernetstatus('T',Operation);
-}
