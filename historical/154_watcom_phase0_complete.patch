+#define FF(a,b,c,d,x,s,ac) { (a) += F((b),(c),(d)) + (x) + (unsigned long)(ac); (a) = ROTLEFT((a),(s)); (a) += (b); }
+#define GG(a,b,c,d,x,s,ac) { (a) += G((b),(c),(d)) + (x) + (unsigned long)(ac); (a) = ROTLEFT((a),(s)); (a) += (b); }
