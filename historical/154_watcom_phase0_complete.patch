+VM_SHINT comparedupes(const void *Rec1, const void *Rec2) {
+  dupestype *p = (dupestype *)Rec1;
+  dupestype *q = (dupestype *)Rec2;
+  int RetVal;
+
+  if ((RetVal = strcmp(p->FName,q->FName)) != 0)
+    return(RetVal);
+
+  if (p->ParentPos > q->ParentPos)
+    return(1);
+  if (q->ParentPos > p->ParentPos)
+    return(-1);
+  return(0);
+}
