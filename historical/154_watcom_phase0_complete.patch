+PROGNAME = PCBSM
+
+ROOT     = \PCBSRC
+SOURCE   = SOURCE
+OBJDIR   = $(BCCOMPILER)
+LIBROOT  = $(ROOT)\LIB
+LIBH     = $(LIBROOT)\H
+LIBLIB   = $(LIBROOT)\BCDOS\$(BCCOMPILER)
+
