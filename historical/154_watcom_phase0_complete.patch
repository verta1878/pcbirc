-  FileName = Name;
-  if (fileexist(FileName) != 255) {
-    if (dosfopen(FileName,OPEN_READ|OPEN_DENYNONE,&File) == -1)
-      return(-1);
-
-    loadrecords(&File);
-    dosfclose(&File);
-  }
-
-  if (TotalRecs == 0) {
-    newrecord(SaveRec);
-    addrecord(SaveRec);
-  }
-
-  return(0);
