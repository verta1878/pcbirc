+class cBDREAL
+{
+
+    public:
+
+        cBDREAL                 ( long i = 0 ) { *this = i; }
+        cBDREAL & operator =    ( long i )     { longtobasdble(bd,i);
+                                                 return *this; }
+                  operator long ( void )       { return basdbletolong(bd); }
+
+    protected:
+
+        basdble bd;
+
+};
