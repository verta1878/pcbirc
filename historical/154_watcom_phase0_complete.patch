+static void _NEAR_ LIBENTRY showrec(int LineNum, cnamesidxtype *IdxRec, bool Highlight) {
+  char Temp[80];
+
+  sprintf(Temp,"%5u) %s",IdxRec->Num,IdxRec->Name);
+  padstr(Temp,' ',66);
+  fastprint(7,LineNum,Temp,Colors[(Highlight ? MENUBAR : MENUSELECT)]);
+}
