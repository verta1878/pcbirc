+static bool _NEAR_ LIBENTRY getrangeparams(char *Params) {
+  char *p;
+
+  if ((p = strchr(Params,'-')) == NULL)
+    return(FALSE);
+
+  *p = 0;
+  RangeLowMsg  = atol(Params);
+  RangeHighMsg = atol(p+1);
+  *p = '-';
+
+  if (RangeHighMsg < RangeLowMsg ||
+      RangeLowMsg  <= 0          ||
+      RangeHighMsg <= 0)
+    return(FALSE);
+
+  return(TRUE);
+}
