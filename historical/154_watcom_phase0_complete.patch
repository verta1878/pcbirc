+void  fileErr(char * s, char * f)
+{
+    // Error display info
+    int    ld  = FALSE;
+    char * ptr = f;
+    if (strlen(ptr) > 40)
+    {
+        ld  = TRUE;
+        ptr = ptr+strlen(ptr)-37;
+    }
+
+    editErr("%s (%s%s)",s,ld ? "..." : "",ptr);
+}
