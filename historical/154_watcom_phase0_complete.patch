+
+int  boundschecking(unsigned Selection, unsigned *Offset) {
+  if (Selection == 65535U)
+    return(-1);
+
+  if (Selection < *Offset || Selection > *Offset + 41) {
+    *Offset = ((Selection / 3) * 3);
+    makeconfmenu(*Offset + 1);
+  }
+  return(0);
+}
