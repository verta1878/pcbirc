+
+  if ((QwkConfFlags = (char far *) farmalloc(PcbData.NumAreas * sizeof(char))) == NULL)
+    errorexittodos("insufficient memory for QWK/Net flags");
+
+  memset(QwkConfFlags,0,PcbData.NumAreas * sizeof(char));
