-    dosfclose(&Idx);
-    return(-2);
-  }
-
-  makefilespec(FileName);
-  setsearchlimits(&Hdr);
-
-  RetVal = binarysearch(&Buf,Hdr.NumFiles);
-
-  dosfclose(&Idx);
-  return(RetVal);
