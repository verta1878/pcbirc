+
+static void near  makeconfmenu(int Offset) {
+  pcbconftype Conf;
+  char *q;
+  unsigned t;
+  unsigned x;
+  unsigned y;
+
+  x = Menu[CONFMENU].First;
+  y = x + 42;
+  q = MenuList[x];
+
+  for (t = Offset;  x < y; q+=36, x++, t++) {
+    if (t <= PcbData.NumConf) {
+      getconfrecord(t,&Conf);
+      MenuAvail[x] = TRUE;
+      sprintf(q,"%u) %-13.13s",t,Conf.Name);
+    } else {
+      MenuAvail[x] = FALSE;
+      sprintf(q,"%u)",t);
+    }
+  }
+}
