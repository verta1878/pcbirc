+
+    public:
+
+        cMOD_UFTD ( char * name, int flags ) :
+            cUNIX_FTD(name,flags)
+        {
+        }
+
+        void pascal unfmt ( void ) { def_unfmt(':'); }
+        void pascal fmt   ( void ) { def_fmt  (':'); }
+
+    protected:
+
+    private:
+
+};
