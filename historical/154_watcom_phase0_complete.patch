+char * LIBENTRY getfilenamewithoutpath(char *FileName) {
+  char *p;
+
+  if ((p = strrchr(FileName,'\\')) != NULL || (p = strrchr(FileName,':')) != NULL)
+    return(p+1);
+  return(FileName);
+}
