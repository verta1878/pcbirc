+void pascal interact(void) {
+  arraytype ColorsArray[25];
+  char Ch;
+  char Ext;
+  int  X;
+  int  Y;
+
+  clscolor(0);
+  box(0,0,79,24,0,DOUBLE);
+  showscreen(ScreenLines,NUMLINES);
+
+  Init = TRUE;
+  paint(ColorsArray);
+  Init = FALSE;
+  paint(ColorsArray);
+
+  instructcolors();
+
+  X = 39;
+  Y = 15;
+
+  while(1) {
+    gotoxy(X,Y);
+    setcursor(CUR_BLOCK);
+    Ch = inkey(&Ext,CLOCK);
+    if (! Ext) {
+      if (Ch == 27)
+        break;
+      if (Ch == 13)
+        changecolors(X,Y,ColorsArray);
+    } else {
+      if (Ch == 59)
+        showhelp(COLORSELECT);
+      else
+        movepointer(Ch,0,24,0,79,&X,&Y);
+    }
+  }
+}
