+int  confirm(char * s, void  (* func)(void), char key)
+{
+    setXY(1,statOn ? MAX_ROWS-1 : MAX_ROWS);
+    setAttr(statAttr);
+    wrStr(s);
+    cle();
+
+    int ch = toUPPER(getKey());
+
+    if ((func != NULL) && (ch == key))
+    {
+        func();
+        ch = 'Y';
+    }
+
+    return (ch == 'Y');
+}
