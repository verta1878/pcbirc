-          p->Fields.Days    = atoi(&Str[46]);
-          p->Fields.Keep    = (Str[52] == 'M' ? MOVE : COPYONLY);
-        }
-        X++;
-      }
-    }
-  }
-
-exit:
-  dosfclose(&In);
-//if (! BatchMode)
-    restorescreen(&Screen);
