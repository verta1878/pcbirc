+static int pascal decode_base64( char *LineIn, char *LineOut ) {
+  char *p;
+  int i;
+  int l;
+  int x;
+  int left;
+  unsigned long octchar;
+
+  /* Exit on empty input */
+  if (LineIn == NULL || LineIn[0] == '\0')
+    return (FAIL);
+
+  /* Initialize working pointers */
+  p = LineIn;
+
+  l = 0;
+  octchar = 0L;
+  x = 0;
+  left = strlen(LineIn);    // length of text to decode
+
+  // Process entire inbuf.
+  while (left != 0) {
+      left--;
+      i = (int) fromb64[(unsigned char)*p];
+
+      switch(i) {
+          case FAIL:
+             return (FAIL);
+          case SKIP:
+             break;
+          default:
+             octchar = (octchar << 6) | (0x3f & i);
+             l++;
+             break;
+      }
+
+      if (l == 4 || left == 0) {
+         switch(l) {
+             case 2:
+                octchar = octchar >> 4;
+                break;
+             case 3:
+                octchar = octchar >> 2;
+                break;
+             default:
+             break;
+         }
+
+         for (l  -= 2; l >= 0; l--) {
+            LineOut[x] = (0xff & (octchar >> (l * 8)));
+            x++;
+         }
+
+         octchar = 0L;
+         l = 0;
+      }
+
+      p++;
+  }
+
+  return (x);
+}
