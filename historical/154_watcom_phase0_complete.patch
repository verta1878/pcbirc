-         break;
-
-    case WM_INITMENU:
-         InitMenu(mp1, mp2);
-         break;
-
-    case HM_QUERY_KEYS_HELP:
-         return (MRESULT)PANEL_HELPKEYS;   /* return id of key help panel */
-
-    case TM_THREADINITFAILED:
-        /*  The message is received if the background thread
