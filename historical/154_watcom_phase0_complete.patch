+/********************************************************************
+ *
+ *  Function:  timechanged()
+ *
+ *  Returns TRUE if the time has changed since the last call
+ */
+
+char static OldSec;
+
+char pascal timechanged(void) {
+  asm Mov Ah,2Ch
+  asm Int 21h
+  asm Xor Ax,Ax
+  asm Cmp Dh,OldSec
+  asm Je  exit
+  asm Mov OldSec,Dh
+  asm Mov Al,1
+exit:;
+  return(_AL);
+}
