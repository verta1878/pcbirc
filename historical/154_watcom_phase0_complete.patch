+/****************************************************************************/
+/* Add polls																*/
+
+static void _NEAR_ LIBENTRY add_polls(char * poll_list)
+{
+char		*ptr,*p;
+char		tmpBuf[81];
+cNEWQ	Q;
+
+	maxstrcpy(tmpBuf,poll_list,sizeof(tmpBuf));
+	p=ptr=tmpBuf;
+
+	if((p=strchr(ptr,','))!=NULL)
+	{
+		p++;
+		if((ptr=strtok(p," "))!=NULL)
+				Q.addPoll(ptr,FALSE);
+		else if(*(++p)!=NULL)
+		{
+			Q.addPoll(p,FALSE);
+			return;
+		}
+
+		while((ptr=strtok(NULL," "))!=NULL)
+				Q.addPoll(ptr,FALSE);
+	}
+}
