-//clsbox(LeftSide,TopLine,RightSide,TopLine+CurNumLines-1,Colors[OUTBOX]);
-
-  LineNum = TopLine;
-  RecNum  = TopRec;
-  s       = Screen;
-
-  for (X = 0; X < CurNumLines; X++, LineNum++, RecNum++, s++) {
