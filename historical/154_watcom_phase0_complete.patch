-	  if(field==0) tptr=strtok(logline," ");
-	  else		   tptr=strtok(NULL," ");
-		}
-
-	if(tptr)
-		{
-	  //maxstrcpy(filename,tptr,sizeof(filename));
-	  maxstrcpy(filename,tptr,sizeof(filename));
