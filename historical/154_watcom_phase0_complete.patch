+  unsigned char   RotVal;
+  unsigned short  Seed;
+  unsigned short  Temp;
+  unsigned short *p;
+  int             X;
+
+  Seed = 0xDB24;
+  for (p = (unsigned short *) Str, X = Len >> 1; X > 0; X--, p++) {
+    Temp = (unsigned short) ((X & 0xFF) + ((X & 0xFF) << 8));
+    RotVal = (char) ((char) Seed + (char) X);
+    *p = srotl(((*p ^ Seed) ^ Temp),RotVal);
+    Seed = *p;
+  }
+
+  if (Len & 1) {
+    Str = (char *) p;
+    *Str = (char) (crotl(*Str,RotVal) ^ Seed);
