-int pascal getKey(void)
-{
-    unsigned ch;
-    if (buf != NULL)
-    {
-        ch = *(bufPtr++);
-        if (*bufPtr == 0)
-        {
-            delete buf;
-            buf = bufPtr = NULL;
-        }
-    }
-    else
-    {
-     // if ((ch = getch()) == 0)
-     //     ch = getch() + 256;
-        ch = bgetkey(0);
-        if ((ch & 0x00FF) == 0)
-            ch = ((ch >> 8) + 256);
-        else
-            ch = (ch & 0x00FF);
-    }
-    return ch;
-}
