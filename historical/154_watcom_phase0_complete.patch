+static void dosversion(void)
+{
+  static char Major;
+
+#ifdef __OS2__
+  Major = 20;   /* OS/2 â€” no DOS version needed */
+#elif defined(__WATCOMC__)
+  {
+    union REGS r;
+    r.h.ah = 0x30;
+    int386(0x21, &r, &r);
+    Major = r.h.al;
+  }
+#else
+  asm {
+    mov ah, 30h
+    int 21h
+    mov Major, al
+  }
+#endif
+
+  if (Major >= 20)
+    PcbData.OS2Driver = 1;
+  else
+    PcbData.OS2Driver = 0;
+}
