-typedef struct {
-  char Status;            /* D=already deleted, F=flagged, T=truncated  */
-  long RecNo;             /* User Record Number                         */
-  char Name[26];          /* User Name                                  */
-  long ReplaceRecNo;      /* Replacement User Record Number             */
-  char ReplaceName[26];   /* Replacement User Name                      */
