+static inline ubyte _NEAR_ LIBENTRY crotl(ubyte Val, uint RotVal) {
+  #ifdef __BORLANDC__
+    return(_crotl(Val,RotVal));
+  #else
+    uint ShortVal = Val;
+    ShortVal = _rotl(ShortVal,(RotVal & 7));
+    Val = (ShortVal & 0xFF) | ((ShortVal & 0xFF00) >> 8);
+    return(Val);
+  #endif
+}
