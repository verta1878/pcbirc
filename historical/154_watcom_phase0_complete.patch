+static void near pascal updatepsa(psatype *p) {
+  char CommandLine[40];
+
+  UpdatingPSAs = TRUE;
+
+  if (AddingPSAs) {
+    sprintf(CommandLine,"/ADDTPA;%s;%d;%d;%d;",p->Name,p->Version,p->RecSize,p->ConfSize);
+    parsepaths(CommandLine);  //lint !e534
+    BatchMode = TRUE;
+    updatetpa();
+    BatchMode = FALSE;
+  } else {
+    strcpy(PSAName,p->Name);
+    removetpa();
+  }
+
+  KeyFlags = ESC;
+  UpdatingPSAs = FALSE;
+  setpsaorder();
+}
