+void pascal cTMPMSG::resetLine(void)
+{
+    lastLine = 0;
+}
+
+char * pascal cTMPMSG::getLine(void)
+{
+    return ((lastLine+1 <= msgData.recCount()) ?
+        (((char *) msgData.recIdxGet(++lastLine)) + sizeof(int)) :
+        NULL);
+}
