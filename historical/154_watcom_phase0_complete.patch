+/* twodig: Convert a byte value (0-99) to two ASCII digits at *Num.
+   Leading zero is replaced with space. */
+
+#ifdef __WATCOMC__
+
+void pascal twodig(char *Num) {
+  unsigned char val = (unsigned char)*Num;
+  char hi = (val / 10) + '0';
+  char lo = (val % 10) + '0';
+  if (hi == '0') hi = ' ';
+  Num[0] = hi;
+  Num[1] = lo;
+}
