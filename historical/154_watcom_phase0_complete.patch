-
-       if(unet.open(PcbData.NetFile,OPEN_READ | OPEN_DENYNONE) != 0) return 0;
-       unet.seek(2,SEEK_SET);
-       unet.read(&maxnodes,sizeof(maxnodes));
-       return maxnodes;
-}
