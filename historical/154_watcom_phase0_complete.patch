+                else
+                {
+                    cacheLine();
+                    strcpy(tmpLine,curLine);
+                    commitLine();
+
+                    strcpy(tmpLine,tmpLine+startBlockOff);
+                    wrText(hand,tmpLine,errFlag);
+
+                    for (slOff = startBlockLine+1;
+                        (slOff <= (endBlockLine-1)) && !errFlag;
+                        ++slOff)
+                    {
+                        cacheLine();
+                        wrText(hand,curLine,errFlag);
+                        commitLine();
+                    }
+
+                    if (!errFlag)
+                    {
+                        slOff = endBlockLine;
+                        cacheLine();
+                        strcpy(tmpLine,curLine);
+                        commitLine();
+
+                        tmpLine[endBlockOff+1] = NUL;
