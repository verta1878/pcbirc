+
+inline char decodeChar ( unsigned char c )
+{
+    c -= ' ';
+    return ((c > 0100) ? 0100 : (c & 0077));
+}
+
+void pascal decodeLine ( char * i, char * o, int & s )
+{
+    int n = decodeChar(*(i++));
+
+    int ilen = strlen(i);
+    if ((n > 45) || (n < 1) ||
+        (n > (ilen*3/4+1)) || ((n+3) < (ilen*3/4+1)) ||
+        (ilen > 61))
+    {
+        s = 0;
+        return;
+    }
+
+    s = n;
+    while (n > 0)
+    {
+        char a = decodeChar(*(i++));
+        char b = decodeChar(*(i++));
+        char c = decodeChar(*(i++));
+        char d = decodeChar(*(i++));
+        if ((a == 0100) || (b == 0100) || (c == 0100) || (d == 0100))
+        {
+            s = 0;
+            break;
+        }
+        if (n-- > 0) *(o++) = ((a<<2)|(b>>4));
+        if (n-- > 0) *(o++) = ((b<<4)|(c>>2));
+        if (n-- > 0) *(o++) = ((c<<6)|(d));
+    }
+}
