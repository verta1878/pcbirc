+char * pascal maxstr(char * s, int l)
+{
+    const int max = 256;
+    static char buf [ max + 1 ];
+    if (l > max) return s;
+    memcpy(buf,s,l);
+    buf[l] = NUL;
+    return buf;
+}
+
+    /*--------------------------------------------------------------------*/
+
+unsigned pascal dstrlen(char * s)
+{
+    unsigned len = 0;
+    while (*s)
+    {
+        if (*s == '\x09') // if it is a tab
+            len = ((len/8)+1)*8;
+        else
+            ++len;
+        ++s;
+    }
+    return len;
+}
+
+    /*--------------------------------------------------------------------*/
+
+void pascal dstrcpy(char * d, char * s, unsigned l)
+{
+    unsigned len = 0;
+    while (*s && (len < l))
+    {
+        *d = *(s++);
+        if (*d == '\x09') // if it is a tab
+        {
+            unsigned tmp = ((len/8)+1)*8;
+            if (tmp > l) break;
+            len = tmp;
+        }
+        else
+            ++len;
+        ++d;
+    }
+    d[0] = NUL;
+
+}
