+void pascal cFID_DFTD::unfmt ( void )
+{
+    stripleft(line,' ');
+
+    memcpy(field[0],line,20);
+    field[0][20] = NUL;
+    char * ptr = strchr(field[0],' ');
+    if (ptr) *ptr = NUL;
+
+    ptr = strchr(line,' ');
+    strcpy(field[1], ptr ? ptr : "");
+    stripboth(field[1],' ');
+
+    for (int i = 2; i < MAX_FIELDS; ++i) field[i][0] = NUL;
+}
