+void  wrText(int hand, char * ptr, int & errFlag)
+{
+    int len = strlen(ptr);
+    errFlag = ((errFlag)                                           ||
+               (writecheck(hand,&len,sizeof(len)) == unsigned(-1)) ||
+               (writecheck(hand,ptr,len)          == unsigned(-1)));
+}
