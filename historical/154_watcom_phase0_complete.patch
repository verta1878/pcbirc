+					if(found!=TRUE)
+					{
+						done=FALSE;
+						found=FALSE;
+						first=TRUE;
+						tptr=ptr=nodestr;
+
+						while(done!=TRUE)
+						{
+							if((ptr=strchr(tptr,' '))!=NULL)
+							{
+								first=FALSE;
+								tmp=*ptr;
+								*ptr=NULL;
+				fido_nodestr_to_int(tptr,zone,net,node,point);
