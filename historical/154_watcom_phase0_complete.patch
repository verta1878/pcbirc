+            }
+            else
+            {
+            }
+        }
+        else if (msg[0] == 'R')
+        {
+            if (memicmp(rmsg,"RY",2)  == 0)
+            {
+                rv = receiveFile(file,TRUE,rmsg);
+            }
+            else if (stricmp(rmsg,"RN2") == 0)
