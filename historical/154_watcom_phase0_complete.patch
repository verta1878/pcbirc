+static bool near pascal confirm(char * msg)
+{
+        //allHit = FALSE;
+
+        char a;
+
+        cout << endl << msg << "?  ";
+        cin >> a;
+
+        if (toupper(a) == 'A')
+        {
+                allHit = TRUE;
+                a = 'Y';
+        }
+
+        return (toupper(a) == 'Y');
+}
