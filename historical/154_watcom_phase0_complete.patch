+unsigned pascal dateparam(char *Param) {
+  unsigned Date;
+
+  if ((Param = strchr(Param,':')) != NULL) {
+    Date = datetojulian(++Param);
+    if (Date != 0 && Date < DateLimit)
+      Date = DateLimit;
