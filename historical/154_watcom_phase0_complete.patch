+int cFILEBASE::scanf ( const char * fmt, ... )
+{
+    char buf [ 1024 + 1 ];
+
+    int rv = getln(buf,sizeof(buf));
+
+    if (rv == 0)
+    {
+        va_list args;
+        va_start(args,fmt);
+
+        vsscanf(buf,fmt,args);
+
+        va_end(args);
+    }
+
+    return rv;
+}
