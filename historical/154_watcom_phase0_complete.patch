-    UMWF_RECORD * rr = (UMWF_RECORD *) r;
-
-    int cmp = memcmp(lr->name,rr->name,sizeof(lr->name));
-
-    if (cmp == 0) cmp = lr->conf - rr->conf;
-
-    return cmp;
-}
