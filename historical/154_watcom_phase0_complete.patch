-long LIBENTRY get_event_info(char *zonenetnodestr)
-{
-	DOSFILE sts;
-	const  char COMMA		= ',';
-			char * fname	 = "PCBFIDO.STS";
-			long allowBits = 0;
-			char inputBuf[80 + 1];
-			char * tmp2 = NULL;
-			char tBuf[20];
-
-
-	assert(stackavail() > 500);
-	// Open file PCBFIDO.STS
-	if(fileexist(fname) == 255) return 0;
