-int pascal validFileName(char *f)
-{
-    int i;
-    for (i = 0; i < strlen(f); ++i)
-        if (!isALNUM(f[i]) && (strchr("\\.:!@#$^&()~`-_{}'",f[i]) == NULL))
-            break;
-
-    return (i == strlen(f));
-}
