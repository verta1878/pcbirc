+static void near pascal openerror(void) {
+  memset(&MsgData,0,sizeof(MsgData));
+  MsgData.AutoBox = TRUE;
+  MsgData.Msg1    = "ERROR!  All nodes need to be down before proceeding!";
+  MsgData.Line1   = 18;
+  MsgData.Color1  = Colors[HEADING];
+  showmessage();
+}
