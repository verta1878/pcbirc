+static bool near pascal confirm(char * msg)
+{
+    allHit = FALSE;
+
+    char a;
+
+    cout << endl << msg << "?  ";
+    a = getche();
+
+    if (toupper(a) == 'A')
+    {
+        allHit = TRUE;
+        a = 'Y';
+    }
+
+    return (toupper(a) == 'Y');
+}
