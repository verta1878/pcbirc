-  dossetbuf(&In,32768U);
-  MoveCount = 0;
-  Start = 0;
-
-  // scan for all matches for this conf+dir, count up a total of the
-  // matches, and record the offset where the first entry for this
-  // conf+dir begins
-  while (dosfgets(Str,sizeof(Str),&In) >= 0) {
