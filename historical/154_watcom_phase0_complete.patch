+unsigned long updblkcrc32(char *block, int blklength, unsigned long precondition) {
+  unsigned long c = precondition;
+
+  for (; blklength > 0; blklength--, block++)
+    c =  (crc32tab[((unsigned int)c ^ *block) & 0xFF] ^ ((c >> 8) & 0x00FFFFFFL));
+
+  return(c);
+}
