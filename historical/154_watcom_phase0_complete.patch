+  Temp[0] = (p->MakeDoorSys ? 'Y' : 'N');
+  fastprint(LEFTSIDE+37,LineNum,Temp   ,Colors[ANSWER]);
+
+  Temp[0] = p->Shell;
+  fastprint(LEFTSIDE+43,LineNum,Temp   ,Colors[ANSWER]);
+
+  Temp[0] = (p->Os2 ? 'Y' : 'N');
+  fastprint(LEFTSIDE+48,LineNum,Temp   ,Colors[ANSWER]);
