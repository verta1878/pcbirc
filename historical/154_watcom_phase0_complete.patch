+  char BatchCommands[] = "REMODAYSSINCEXPDKEEPLOCKPRIN";
+
+  gets(Str);
+  strupr(Str);
+  printf("%s = %d\n",Str,findfour(BatchCommands,Str));
+}
+#endif
