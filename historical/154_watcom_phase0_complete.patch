+        if ((line[0] != ' ') && (line[0] != '\t'))
+            lastMatch = hdrMatch(line);
+        msg.addLine(line,llen,((line[0] != NUL) && !lastMatch));
+
+        if (line[0] == NUL) break;
+
+        hdr.getInfo(line);
+    }
+*/
+    unsigned actual;
+    while (1) {
+       llen = readline(txt,line,lsize,actual);
+
+       if (llen == -1) break;
+       read += (long) actual;
+
+       if ((line[0] != ' ') && (line[0] != '\t'))
+          lastMatch = hdrMatch(line);
+       msg.addLine(line,llen,((line[0] != NUL) && !lastMatch));
+
+       if (! llen) break;
+
+       hdr.getInfo(line);
+    }
+
+    return read;
+}
