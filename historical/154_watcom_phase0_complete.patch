+
+.PATH.obj = $(OBJDIR)
+.PATH.asm = $(SOURCE)
+.PATH.c   = $(SOURCE);EXTRAOBJ
+.PATH.cpp = $(SOURCE);EXTRAOBJ
+
+#=============================================================
+
+.c.obj:
+  $(COMPILER) +$(CFG) $(COPT) $(CODEOPT) {$< }
+
+.cpp.obj:
+  $(COMPILER) +$(CFG) $(COPT) $(CODEOPT) {$< }
+
+.asm.obj:
+  tasm $(ASMOPT) $(.PATH.asm)\$.,$(.PATH.obj)\$&
+
