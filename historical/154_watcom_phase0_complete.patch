+void  indexchanged(void) {
+  char Temp[80];
+  char Buffer[100];
+
+  if (openchangeread() == -1)
+    return;
+
+  while (dosfgets(Buffer,sizeof(Buffer),&DosChangedList) != -1) {
+    sprintf(Temp,"Indexing  : %s",Buffer);
+    printscroll(Temp,Colors[QUESTION]);
+
+    createdirindex(Buffer);
+
+    if (checkuserabort()) {
+      Aborted = TRUE;
+      break;
+    }
+  }
+
+  dosfclose(&DosChangedList);
+}
