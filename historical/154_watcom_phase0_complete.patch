+static int pascal printline(char *Str, bool PerformHeadCheck) {
+  if (print(Str) == -1)
+    return(-1);
+
+  LineNum++;
+  if (PerformHeadCheck)
+    if (LineNum > 58)
+      return(printheading(FALSE));
+  return(0);
+}
