+fonttype LIBENTRY getfont(void) {
+  #ifdef __OS2__
+    if (Scrn_Adapter < VID_VGA)
+      return(BIGFONT);
+
+    return(getviolines() == 25 ? BIGFONT : SMALLFONT);
+
+  #else  /* ifdef __OS2__ */
+    struct text_info Info;
+
+    if (Scrn_Adapter < VID_VGA)
+      return(BIGFONT);
+
+    gettextinfo(&Info);
+    return(Info.currmode == C4350 ? SMALLFONT : BIGFONT);
+  #endif
+}
