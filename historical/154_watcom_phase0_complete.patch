-  ENTERMESSAGE='E',GROUPCHAT='G',HANDLEMAIL='H',LOGOFFPENDING='L',
-  NODEMESSAGE='M',RUNNINGEVENT='N',LOGINTOSYSTEM='O',PAGINGSYSOP='P',
-  RECYCLEBBS='R',ANSWERSCRIPT='S',TRANSFER='T',UNAVAILABLE='U',
