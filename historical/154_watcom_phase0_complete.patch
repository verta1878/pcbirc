+ */
+
+void LIBENTRY scrolldn(char X1, char Y1, char X2, char Y2, char Color) {
+#ifdef __OS2__
+  short *p = (short *) Scrn_Buf;
+  int    Len;
+  int    Y;
+  short  Value;
+  scrnupdttype ScrnUpdate;
+
+  Len = (X2 - X1 + 1) << 1;
+  Value = (short) (((short) Color << 8) + (short) ' ');
+
+  for (Y = Y2, p += (Y2*80 + X1); Y > Y1; Y--, p -= 80)
+    memcpy(p,p-80,Len);
+
+  for (; Len > 0; Len -= 2, p++)
+    *p = Value;
+
+  ScrnUpdate = UPDATE_MIXED;
+  if (Y1 == 0) {
+    if (Y2 == 24)
+      ScrnUpdate = UPDATE_25LINES;
+    else if (Y2 == 49)
+      ScrnUpdate = UPDATE_50LINES;
+  }
+
+  updatelines(ScrnUpdate,Y1,Y2);
+
+#elif defined(__WATCOMC__)
+  {
+    union REGS r;
+    r.h.ah = 0x07;
+    r.h.al = 1;       /* scroll 1 line */
+    r.h.bh = Color;
+    r.h.ch = Y1;
+    r.h.cl = X1;
+    r.h.dh = Y2;
+    r.h.dl = X2;
+    int386(0x10, &r, &r);
+  }
+#else  /* ifdef __OS2__ */
+
+#ifdef BIOS
+  char Str[162];
+  int  Len;
+  char *p;
+
