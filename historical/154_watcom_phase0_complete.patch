-void pascal editclass::addidx(long NewPos) {
-  long *p;
-
-  TotalIdx++;
-
-  if (TotalRecs > VMRecordCount(&Idx))
-    p = (long *) VMRecordCreate(&Idx,sizeof(long),NULL,NULL);
-  else
-    p = (long *) VMRecordGetByIndex(&Idx,TotalIdx,NULL);
-
-  *p = NewPos;
-  VMRecordChanged(&Idx);
