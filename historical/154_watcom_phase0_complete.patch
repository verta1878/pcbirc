+		if(tptr && deny_list && strcmpi(tptr,deny_list[i].nodestr)==0)
+				{
+					done=TRUE;
+					found=TRUE;
+				}
+				*ptr=tmp;
+				tptr=++ptr;
+			}
+			else if(first==TRUE)
+			{
+				first=FALSE;
+		if(tptr && deny_list && strcmpi(tptr,deny_list[i].nodestr)==0)
+				{
+					done=TRUE;
+					found=TRUE;
