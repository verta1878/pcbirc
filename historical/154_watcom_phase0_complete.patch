-
-  sprintf(Temp,"%-*s: %s\r\n",ColSize1,Desc,(Str[0] == 0 ? "(blank)" : Str));
-  if (sendtoprinter(Temp) == -1) {
-    #ifdef DEBUG
-      mc_unregister(Temp);
-    #endif
-    return(-1);
-  }
-
-  #ifdef DEBUG
-    mc_unregister(Temp);
-  #endif
-  return(0);
-}
-
-
