+static char * near pascal xlateText(char * s)
+{
+    if (PcbData.uucpHighAscii == 'N') return s;
+
+    char * p = s;
+
+    while (*s)
+    {
+        if (*s > 127)
+            switch (PcbData.uucpHighAscii)
+            {
+                case 'S':
+                    strcpy(s,s+1);
+                    continue;
+
+                case 'R':
+                    *s = '.';
+                    break;
+
+                case 'C':
+                    *s = lookup[*s];
+                    break;
+            }
+
+        ++s;
+    }
+
+    return p;
+}
