+/********************************************************************
+*
+*  Function: readusersfile()
+*
+*  Desc    : Reads the record pointed to by RecNum into the UsersRead buffer.
+*/
+
+int pascal readusersfile(long RecNo) {
+  RecNo--;
+  doslseek(UsersFile,RecNo * sizeof(URead),SEEK_SET);
+  return(readusersrecord());
+}
