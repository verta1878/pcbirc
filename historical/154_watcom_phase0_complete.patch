+bool  alreadyinlist(char *FileName) {
+  bool Found;
+  int  Len;
+  char Temp[80];
+
+  dosrewind(&DosChangedList);
+  Found = FALSE;
+
+  while (dosfgets(Temp,80,&DosChangedList) != -1) {
+    if (Temp[0] != '-' && Temp[0] != '=' && Temp[0] > 0) {
+      Len = strlen(Temp)-2;
+      if (Temp[Len-1] == '*')
+        Temp[Len-6] = 0;
+      else
+        Temp[Len] = 0;
+      if (strcmp(Temp,FileName) == 0) {
+        Found = TRUE;
+        break;
+      }
+    }
+  }
+  dosfseek(&DosChangedList,0,SEEK_END);
+  return(Found);
+}
