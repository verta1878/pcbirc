+    }
+
+#ifdef DEBUG
+    mc_startcheck(NULL);
+#endif
+
+    initPrg();
+    mainLoop();
+    restPrg();
+
+#ifdef DEBUG
+    mc_endcheck();
+#endif
+
+    clrscr();
+    cprintf("PCBEdit is a copyrighted program produced for "
+            "PCBoard customers use only.\r\n");
+    cprintf("If you are interested in purchasing a copy of "
