+
+  Y = Loc / 160;
+  X = (Loc - (Y * 160)) >> 1;
+  ansi_save();
+  ansi_color(Color);
+  gotoxy(X,Y);
+  putchar(C);
+  ansi_rest();
+
+#else  /* ifdef BIOS */
+
+  asm  Les  Di,dword ptr Scrn_Addr
+  asm  Add  Di,Loc
+  asm  Mov  Bl,C
+  asm  Mov  Bh,Color
+
+  asm  Cmp  Scrn_Rtrc,0
+  asm  Je   J2
+  asm  Mov  Dx,03DAh       /* Store port addr in Dx */
+J1:
+  asm  In   Al,Dx          /*   get raster status       */
+  asm  Test Al,01          /*   if not 1                */
+  asm  Jz   J1             /*     then J1               */
+J2:
+  asm  Mov Es:[Di],Bx      /* Store Char and Color in scrn buffer */
+#endif  /* ifdef BIOS */
