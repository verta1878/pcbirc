+int LIBENTRY FOSSIL_cdstillup(void) {
+  int X;
+
+  if (VerifyCDLoss) {
+    for (X = 0; X < 15; X++) {
+      if (online())
+        return(TRUE);  /* cd is up */
+      settimer(4,3);
+      while (! timerexpired(4))
+        giveup();
+    }
+    goto cdoff;
+  }
+
+  if (online())
+    return(TRUE);
+
+cdoff:
+  clearoutbuf();
+  return(FALSE);
+}
