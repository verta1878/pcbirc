+      addbackslash(Work.SubstNew,sizeof(Work.SubstNew)-1);
+    }
+    for (Counter = 0; Counter < 6; Counter++) {
+      stripright(Work.View[Counter].Ext,' ');
+      stripright(Work.View[Counter].Cmd,' ');
+    }
+    savedefaults();
+  }
+  freeanswers(DefFields2,NUMFIELDS2);
+  KeyFlags = NOTHING;
+}
