+void pascal checkforretry(int argc, char *argv[]) {
+  for (argc--; argc > 0; argc--) {
+    if (argv[argc][0] == '/') {
+      strupr(argv[argc]);
+      if (findfour("RETR",&argv[argc][1]) == 1)
