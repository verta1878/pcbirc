+cTMPMSG::cTMPMSG(char _all, char _stat, cNETHDR * _hdr, char * _spath) :
+    msgAll(_all),
+    msgStat(_stat),
+    nhdr(_hdr),
+    isEncoded(FALSE),
+    beginFound(FALSE),
+    endFound(FALSE),
+    lastLine(0)
+{
+    strcpy(spath,_spath);
+    msgData.initRecVarIdxSet(recSizeFunc,8,idxBuf,sizeof(idxBuf));
+}
