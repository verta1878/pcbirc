+
+/******************************************************************************/
+
+// Included Files
+
+#pragma hdrfile "pcbedit.sym"
+
+#include    <conio.h>
+#include    <dos.h>
+#include    <stdarg.h>
+#include    <stdio.h>
+#include    <stdlib.h>
+#include    <string.h>
+#include    <values.h>
+
