+static bool near  isuploaddir(int CnfNum, int DirNum) {
+  static int  SaveCnfNum;
+  static int  SaveDirNum;
+  static bool SaveStatus;
+  pcbconftype Conf;
+
+  if (DirNum == 0)
+    return(TRUE);
+
+  if (CnfNum == SaveCnfNum && DirNum == SaveDirNum)
+    return(SaveStatus);
+
+  SaveCnfNum = CnfNum;
+  SaveDirNum = DirNum;
+
+  getconfrecord(CnfNum,&Conf);
+  if (DirNum > numrandrecords(Conf.DirNameLoc,sizeof(DirListType2)))
+    SaveStatus = TRUE;
+  else
+    SaveStatus = FALSE;
+
+  return(SaveStatus);
+}
