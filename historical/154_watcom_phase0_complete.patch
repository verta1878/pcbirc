+#elif defined(__WATCOMC__)
+  {
+    union REGS r;
+    r.h.ah = 0x11;
+    r.h.al = (Font == FONT_8x8) ? 0x12 : 0x14;
+    r.h.bl = 0;
+    int386(0x10, &r, &r);
+  }
+#else
+  if (Font == FONT_8x8) {
+    asm mov ax,1112h
+    asm mov bl,0
+    asm int 10h
+  }
+  else {
+    asm mov ax,1114h
+    asm mov bl,0
+    asm int 10h
+  }
+#endif
+}
