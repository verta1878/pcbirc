-          if(strstr(line,"Ending mail run") || strstr(line,"Handshake Error"))
-          {
-            ffile.putln(line);
-            ffile.putln("END LOG BLOCK");
-            break;
-          }
-        }
-      }
-
-      if(strstr(line,"Beginning NETMAIL export.") )
-      {
-        datetime = getBlockDate(line);
