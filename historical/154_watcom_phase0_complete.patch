+    /*--------------------------------------------------------------------*/
+
+int  copyAttr(int abort = FALSE)
+{
+    static int attr = -1;
+    if (abort)
+    {
+        attr = -1;
+        return FALSE;
+    }
+    if (attr == -1)
+    {
+        attr = attrList[tlOff+slOff];
+        char *p = curLine;
+        int plen = strlen(p);
+        while ((p < curLineChar) && (plen > 0))
+        {
+            int code = doIsATCode(p);
+            if (code == ATXCODE)
+            {
+                attr = getATX(p,attr,tlOff+slOff);
+                atSize = 4;
+            }
+            if (code)
+            {
+                p += atSize;
+                plen -= atSize;
+            }
+            else
+            {
+                ++p;
+                --plen;
+            }
+        }
+        return TRUE;
+    }
+    else
+    {
+        if (strlen(curLine)+4 <= MAX_LINE_SIZE)
+        {
+            memmove(curLineChar+4,curLineChar,strlen(curLineChar)+1);
+            *(curLineChar++) = '@';
+            *(curLineChar++) = 'X';
+            *(curLineChar++) = hexDigits[attr >> 4];
+            *(curLineChar++) = hexDigits[attr & 0x0F];
+            textChanged = TRUE;
+            udLine();
+            llcOff = -1;
+        }
+        attr = -1;
+        return FALSE;
+    }
+}
+
+    /*--------------------------------------------------------------------*/
+
+void  stripAttrs(int clOff, int off, int plen)
+{
+    commitLine();
+    chkAttrs();
+    slOff = clOff;
+    cacheLine();
+    char *p = curLine+off;
+    while (plen > 0)
+    {
+        int code = doIsATCode(p);
+        if (code == ATXCODE)
+        {
+            strcpy(p,p+4);
+            plen -= 4;
+        }
+        else if (code)
+        {
+            p += atSize;
+            plen -= atSize;
+        }
+        else
+        {
+            ++p;
+            --plen;
+        }
+    }
+}
