+} tcantype;
+
+
+
+void pascal editftcnclass::loadrecords(DOSFILE *File) {
+  tcantype  Rec;
+  char      Buf[256];
+
+  while (dosfgets(Buf,sizeof(Buf),File) != -1) {
+    newrecord(&Rec);
+    maxstrcpy(Rec.Name,Buf,sizeof(Rec.Name));
+    addrecord(&Rec);
+  }
+}
+
+
+void pascal editftcnclass::saverecords(DOSFILE *File) {
+  long      X;
+  tcantype *p;
+  char      Temp[100];
+
+  for (X = 1; X <= TotalRecs; X++) {
+    p = (tcantype *) getrecord(X);
+    stripright(p->Name,' ');
+    sprintf(Temp,"%s\r\n",p->Name);
+    if (dosfputs(Temp,File) == -1)
+      break;
+  }
+}
+
+
+void pascal editftcnclass::displayrecord(long RecNum, int LineNum, void *Rec) {
+  tcantype *p = (tcantype *) Rec;
+  char      Temp[21];
+
+  sprintf(Temp,"%3ld)",RecNum);
+  fastprint(LEFTSIDE+ 1,LineNum,Temp   ,Colors[ANSWER]);
+  fastprint(LEFTSIDE+ 6,LineNum,p->Name,Colors[ANSWER]);
+}
+
+
+void pascal editftcnclass::showheaders(void) {
+  fastprint(LEFTSIDE+6,TOPLINE-2,"Trashcan Names",Colors[DISPLAY]);
+  fastprint(LEFTSIDE+6,TOPLINE-1,"ÍÍÍÍÍÍÍÍÍÍÍÍÍÍ",Colors[DISPLAY]);
+//fastprint(LEFTSIDE,Scrn_BottomRow-1,"  ESC=Exit   Alt-R=Repeat a Line   Alt-I=Insert a Line   Alt-D=Delete a Line  ",Colors[DESC]);
+}
+
+
+void pascal editftcnclass::editrecord(void *Rec) {
+  tcantype *p = (tcantype *) Rec;
+
+  inputstr(LEFTSIDE+6,LineNum,12,"",p->Name,p->Name,ALLTEXT,INPUT_CAPS|INPUT_CLEAR,0);
+  stripright(p->Name,' ');
+}
