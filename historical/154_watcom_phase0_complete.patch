-static int pascal adjustconfsub(URead *p) {
-  if (p->SecurityLevel >= Conf.Low && p->SecurityLevel <= Conf.High) {
-    if (FullUpdate) {
-      convertreadtoconfandmsgptrs(p,ConfReg);
-      if (Ins) {
