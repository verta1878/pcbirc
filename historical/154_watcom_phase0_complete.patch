+
+static char * near  lastspace(char *Str, int LastColumn) {
+  int X;
+  for (X = LastColumn, Str += LastColumn; *Str != ' ' && X; X--, Str--);
+  if (X == 0)
+    return(NULL);
+  return(Str);
+}
