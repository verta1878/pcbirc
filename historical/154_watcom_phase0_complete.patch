-static int bscompare(const void *Name, const void *B) {
-  long         *b = (long *) B;
-  filelisttype *Rec2;
-
-  Rec2 = (filelisttype *) VMRecordGetByPos(&Files,*b);
-  return(stricmp((char *)Name,Rec2->Name));
-}
