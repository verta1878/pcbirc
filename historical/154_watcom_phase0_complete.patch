-
-static int near pascal searchidxforfiles(char *IdxName, char *FileName) {
-  int        RetVal;
-  pathtype   Buf;
-  idxhdrtype Hdr;
-
-  stripright(IdxName,'\\');
-  if (dosfopen(IdxName,OPEN_READ|OPEN_DENYNONE,&Idx) == -1)
