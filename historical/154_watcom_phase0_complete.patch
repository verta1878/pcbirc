-editclass::~editclass(void) {
-  int          X;
-  scrnrectype *p;
-
-  if (SaveRec != NULL) {
-    free(SaveRec);
-    SaveRec = NULL;
-  }
-
-  if (Screen != NULL) {
-    for (X = 0, p = Screen; X < MaxScrnLines; X++, p++) {
-      if (p->Rec != NULL) {
-        free(p->Rec);
-        p->Rec = NULL;
-      }
-    }
-    free(Screen);
-    Screen = NULL;
-  }
-
-  if (SaveKeyNum != NULL) {
-    memcpy(ExitKeyNum,SaveKeyNum,NumExitKeys * sizeof(char));
-    free(SaveKeyNum);
-    SaveKeyNum = NULL;
-  }
-
-  if (SaveKeyFlag != NULL) {
-    memcpy(ExitKeyFlag,SaveKeyFlag,NumExitKeys * sizeof(int));
-    free(SaveKeyFlag);
-    SaveKeyFlag = NULL;
-  }
-
-  if (KeyDesc != NULL) {
-    free(KeyDesc);
-    KeyDesc = NULL;
-  }
-
-  if (Allocated) {
-    VMDone(&DataSet);
-    VMDone(&Idx);
-    restorescreen(&ScrnBuf);
-  }
