-  if ((UserNetFile = dosopencheck(FileName,OPEN_RDWR|OPEN_DENYNONE)) == -1) {
-    MessageBox(hwndMain,IDMSG_CANNOTOPENUSERNETFILE,0,MB_OK|MB_ERROR,FALSE);
-    UserNetFile = 0;
