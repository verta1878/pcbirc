+
+  sprintf(Mask,"%s%s.*",PcbData.EventFiles,Name,".*");
+
+  if (findfirst(Mask,&ffblk,0) != -1) {
+    do {
+      if ((p = strrchr(ffblk.ff_name,'.')) == NULL || atoi(p+1) > 0) {
