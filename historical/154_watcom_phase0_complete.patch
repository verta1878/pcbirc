+         // rec.NoPrivateMsgs    = FALSE;
+         // rec.RetReceiptLevel  = 255;
+         // rec.RecordOrigin     = FALSE;
+            rec.PromptForRouting = TRUE;
+         // rec.AllowAliases     = FALSE;
+         // rec.ShowIntroOnRA    = FALSE;
