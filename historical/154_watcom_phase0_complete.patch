+/********************************************************************
+*
+*  Function: padname()
+*
+*  Desc    : Pads the right end of the string Name[] with spaces to fill out
+*            a length of 25 as used by PCBoard.
+*/
+
+static void near pascal padname(char Name[]) {
+  char *p;
+
+  for (p = &Name[strlen(Name)]; p < &Name[25]; p++)
+    *p = ' ';
+}
