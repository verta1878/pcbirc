+      inputstr(4,13,1,"Set FILE DATE when moving files (T=Today,O=Oldest,R=Recent,N=No)",Ans,Ans,TONAR,INPUT_CAPS,DEFAULTS+8);
+      SetFileDate = Ans[0];
