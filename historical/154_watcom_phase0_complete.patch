+
+		case	'N':  done=FALSE;
+					found=FALSE;
+					first=TRUE;
+					tptr=ptr=nodestr;
+
+					while(done!=TRUE)
+					{
+						if((ptr=strchr(tptr,' '))!=NULL)
+						{
+							first=FALSE;
