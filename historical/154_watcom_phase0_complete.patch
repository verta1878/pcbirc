-                        goto Abort;
-                    }
-                }
-            }
-
-            LastNum         = MsgNum;
-            Index.Num       = MsgNum;
-            Index.Offset    = (Header.ActiveFlag == MSG_ACTIVE) ? Offset : -Offset;
