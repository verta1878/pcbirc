-        }
-
-    sGPKTHDR hdr = { DLE, k, 0, 0, tf|xf|yf, 0 };
-
-    if (k != kCP)
-    {
-        pktWin[xf>>3].acked = FALSE;
-        pktWin[xf>>3].hdr = hdr;
-        pktWin[xf>>3].data = (char *) malloc(kDBSTable[k]);
-        if (pktWin[xf>>3].data) memcpy(pktWin[xf>>3].data,ds,kDBSTable[k]);
-    }
-
-    return sendPacket(hdr,ds);
