-int pascal numtextrecords(char *FileName) {
-  char    Buffer[256];
-  DOSFILE Input;
-  int     NumRecs;
-
-  if (fileexist(FileName) == 255)
-    return(0);
-
-  if (dosfopen(FileName,OPEN_READ|OPEN_DENYNONE,&Input) == -1)
-    return(0);
-
-  NumRecs = 0;
-  while (dosfgets(Buffer,256,&Input) != -1)
-    NumRecs++;
-  dosfclose(&Input);
-
-  return(NumRecs);
