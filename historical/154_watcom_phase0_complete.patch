+char *  makebitarray(char *Str) {
+  bool      Found;
+  unsigned  Begin;
+  unsigned  End;
+  unsigned  X;
+  char     *Buffer;
+  char     *p;
+
+  X = ((PcbData.NumAreas + 7) / 8) + 1;
+
+  if ((Buffer = (char *) malloc(X)) == NULL)
+    return(NULL);
+
+  memset(Buffer,0,X);
+
+  for (p = Str, Begin = End = 0xFFFF, Found = FALSE; TRUE; p++) {  //lint !e506 ;DOUBLE CHECK - maybe TRUE should be *p != 0 and remove *p == 0 from bottom
+    if (*p < '0' || *p > '9') {
+      X = atoi(Str);
+      if (Begin == 0xFFFF)
+        Begin = X;
+      End = X;
+      Str = p + 1;
+
+      if (Begin > PcbData.NumConf)
+        Begin = PcbData.NumConf;
+
+      if (End > PcbData.NumConf)
+        End = PcbData.NumConf;
+
+      if (*p != ' ' && *p != '-') {
+        Found = TRUE;
+        for (X = Begin; X <= End; X++)
+          setbit(Buffer,X);
+        Begin = End = 0xFFFF;
+      }
+
+      if (*p == 0)
+        break;
+    }
+  }
+
+  if (! Found) {
+    free(Buffer);
+    return(NULL);
+  }
+
+  return(Buffer);
+}
