+void pascal editdays(char *Name) {
+  editdaysclass Days("Holiday Editor",sizeof(daytype),TOPLINE,BOTTOM,LEFTSIDE,RIGHTSIDE,0,0);
+
+  if (Days.load(Name) == -1)
+    return;
+
+  Days.edit();
+}
