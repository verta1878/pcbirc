+Example 4 â€” Rename messages sent to old sysop handle
+â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
+If your board changed sysop names, rewrite the To field on messages
+addressed to the old name.
+
+    ; RENAME.PPS â€” sysop-only maintenance script
+    DOUBLE msg, lo, hi
+    STRING to
+
+    IF (U_SEC < 100) THEN
+      PRINTLN "Sysop only."
+      END
+    ENDIF
+
+    LET conf = CURCONF()
+    LET lo = LOMSGNUM()
+    LET hi = HIMSGNUM()
+    FOR msg = lo TO hi
+      LET to = GETMSGHDR(conf,msg,7)
+      IF (RTRIM(to," ") = "OLD SYSOP") THEN
+        SETMSGHDR(conf, msg, 1, "NEW SYSOP")   ' field 1 in SET = To
+      ENDIF
+    NEXT
