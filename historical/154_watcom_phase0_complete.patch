-            else if (rmsg[0] == 'R')
-            {
-                sendMessage("RN2");
-            }
-            else if (rmsg[0] == 'H')
-            {
-                break;
-            }
-        }
-
-        if (abortObj()) continue;
-
-        conout << endl << endl << "Hanging Up ...";
-        sendMessage("HY");
-        receiveMessage(rmsg);
