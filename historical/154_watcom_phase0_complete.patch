+#ifndef ___CLEARBUF_HPP___
+
+#define ___CLEARBUF_HPP___
+
+/******************************************************************************/
+
+// Included Files
+
+#include    <mem.h>
+
+#include    <types.hpp>
+
+/******************************************************************************/
+
+// Clear Buffer Functions
+
+template <class T>
+inline void clearBuffer ( T & t )
+{
+    memset(&t,NUL,sizeof(t));
+}
+
+inline void clearBuffer ( void * p, unsigned s )
+{
+    memset(p,NUL,s);
+}
+
+/******************************************************************************/
+
+#endif // ___CLEARBUF_HPP___
