-
-  dosrewind(File);
-  if (ExeFile)
-    dosfseek(File,0x1A58,SEEK_SET);
-
-
-  while (1) {
-    if (readfile(&Header,sizeof(Header),File) == -1)
-      return(0);
-    if (Header.Id != ARCHEADER_ID)
-      return(-1);
-    if (Header.Version == 0)
-      return(0);
-
-    if (! checkfilename(Header.Name))  {
-      if (Header.Date > Newest)
-        Newest = Header.Date;
-      if (Header.Date < Oldest)
