-int pascal getATX(char * s, int c, int o)
-{
-    // If s is a valid @X code...
-    if (isATX(s))
-    {
-//        printf("\ngetATX - %4.4s %02X %2d",s,c,o);
-
-        if (noatxFlag) return 0x07;
-
-        // Get value of @X code
-        int a = (hex2dec(s[2]) << 4) + hex2dec(s[3]);
-
-        if (a == 0x00)                       // If it is a save color code...
-            return c;
-        else if ((a == 0xFF) && (o != -1)) // If it is a restore color code...
-        {
-            int last00 = attrList[0];
-
-            for (int i = o-1; i >= 0; --i)
-                if (last00List[i] != -1)
-                {
-                    last00 = last00List[i];
-                    break;
-                }
-
-            if (last00List[o] != -1)
-            {
-                a = attrList[o];
-
-                char * p = lineList[o];
-                if ((o == tlOff+slOff) && (lineList[o] == NULL)) p = curLine;
-
-                int plen = strlen(p);
-                while ((plen > 0) && (p < s))
-                {
-                    int code = doIsATCode(p);
-                    if (code == ATXCODE)
-                    {
-                        if (memcmp(p,"@X00",4) == 0)
-                            last00 = a;
-                        else if (memcmp(p,"@XFF",4) == 0)
-                            a = last00;
-                        else
-                            a = getATX(p,a,o);
-                        atSize = 4;
-                    }
-                    if (code)
-                    {
-                        p += atSize;
-                        plen -= atSize;
-                    }
-                    else
-                    {
-                        ++p;
-                        --plen;
-                    }
-                }
-            }
-
-            a = last00;
-        }
-
-        // Return new color
-        return a;
-    }
-
-    // Return error code
-    return -1;
-}
