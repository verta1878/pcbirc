+*  Desc    : Reads the current record into the UsersRead buffer.
+*
+*/
+
+int pascal readdosusersrecord(void) {
+  if (dosfread((char *)&UsersRead,sizeof(URead),&DosUsersFile) != sizeof(URead))
+    return(-1);
+  #ifndef DEMO
+    decryptusersrec(&UsersRead);
+  #endif
+  return(0);
+}
