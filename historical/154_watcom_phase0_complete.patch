-static bool _NEAR_ LIBENTRY parse_log_line(char *logline, int direction)
-{
-
-int 				field = 0;
-char				*tptr = NULL;
-
-
-  if(!logline) return FALSE;
-
-	tptr=logline;
-
-  while(*tptr==0x20) tptr++;
-
-  if(*tptr == '\x0') return FALSE;
-
-  if(*tptr=='z' || *tptr=='Z')
-	{
-	for(field=0;field<11;field++)
