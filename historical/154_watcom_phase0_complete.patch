+    VMEMSStateSave();
+    system(cmd);
+    VMEMSStateRestore();
+    reinstallhandlers();
+
+    conout3 << setxy(ti.curx,ti.cury);
+    puttext(1,1,ti.screenwidth,ti.screenheight,buf);
+
+    return 0;
+}
