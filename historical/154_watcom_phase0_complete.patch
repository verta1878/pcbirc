+ *
+ *  Function:  wherex()
+ *
+ *  report cursor column position
+ */
+
+char LIBENTRY wherex(void) {
+#ifdef __OS2__
+  USHORT Row, Column;
+  VioGetCurPos(&Row,&Column,0);
+  Scrn_X = (char) Column;
+  return((char) Column);
+#else
+  asm  Mov  Ah,3
+  asm  Xor  Bh,Bh
+  asm  Int  10h
+  asm  Mov  Al,Dl
+/*  return(_AL);*/ /* return Dl in Al */
+#endif
+}
