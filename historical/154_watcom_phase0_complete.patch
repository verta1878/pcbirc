-    char * ptr = (char *) msgData.createRec(sizeof(len)+len+1);
-    memcpy(ptr,&len,sizeof(len));
-    ptr += sizeof(len);
-    if (hide) *(ptr++) = '\x01';
-    strcpy(ptr,line);
-
-    if (uucpDecode && !isEncoded && (line[0] == 'M') &&
-        ((len == 61) || (len == 62)))
-    {
-        char tbuf [ 45 ];
-        int tsize;
-        decodeLine(line,tbuf,tsize);
-        isEncoded = (tsize == 45);
-    }
-
-    if (!beginFound      &&
-        (line[0] == 'b') &&
-        (line[1] == 'e') &&
-        (line[2] == 'g') &&
-        (line[3] == 'i') &&
-        (line[4] == 'n') &&
-        (line[5] == ' '))
-        beginFound = TRUE;
