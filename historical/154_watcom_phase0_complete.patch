-void pascal stripAttrs(int clOff, int off, int plen)
-{
-    commitLine();
-    chkAttrs();
-    slOff = clOff;
-    cacheLine();
-    char *p = curLine+off;
-    while (plen > 0)
-    {
-        int code = doIsATCode(p);
-        if (code == ATXCODE)
-        {
-            strcpy(p,p+4);
-            plen -= 4;
-        }
-        else if (code)
-        {
-            p += atSize;
-            plen -= atSize;
-        }
-        else
-        {
-            ++p;
-            --plen;
-        }
-    }
-}
