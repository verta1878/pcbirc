+int jumpcnames(int Before) {
+  static char Old[66];
+  if (Before) {
+    stripright(PcbData.CnfFile,' ');
+    strcpy(Old,PcbData.CnfFile);
+    return(0);
+  }
+  stripright(PcbData.CnfFile,' ');
+  if (strcmp(Old,PcbData.CnfFile) != 0) {
+    beep();
+    showhelp(WARNCNAMES);
+  }
+  return(checkfiles8(Before));
+}
