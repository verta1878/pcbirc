-        char otext [ 1 + 60 + 1 ];
-        encodeLine(buf,rb,otext);
-        ofile.putuln(otext);
-    }
-
-    if (rb == 0)
-    {
-        ofile.putuln("`");
-        ofile.putuln("end");
-    }
-
-    sprintf(buf,"---END %s PART %d---------------------------------------"
-        "----------",fname,_encodePart+1);
-    ofile.putuln(buf);
-
-    ++_encodePart;
-
-    // return 0 for more or -1 for no more
-    return -(rb == 0);
-}
