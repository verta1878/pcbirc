+/***************************************************************************
+ *** Add an extension to a filename ****************************************/
+int LIBENTRY AddExtension(char *Filename, char *Ext) {
+    char    *ext,
+            *path;
+
+    path = Filename;
+    if ((path = strrchr(Filename, '\\')) != NULL) {
+        path++;
+        Filename = path;
+    }
+    if ((ext = strchr(Filename, '.')) != NULL)
+        *ext = 0;
+    strcat(Filename, ".");
+    strcat(Filename, Ext);
+
+    return 1;
+}
