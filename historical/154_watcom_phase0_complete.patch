-    // Deallocate memory used used by the lastLineEnd pointer
-    if (lastLineEnd != NULL) delete lastLineEnd;
-
-    if (exist("PCBEDIT.BLK")) unlink("PCBEDIT.BLK");
-    if (exist("PCBEDIT.$$$")) unlink("PCBEDIT.$$$");
