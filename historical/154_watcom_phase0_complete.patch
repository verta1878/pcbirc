+void  rdText(int hand, char * ptr, int & errFlag)
+{
+    memset(ptr,0,MAX_LINE_SIZE+1);
+    if (errFlag) return;
+
+    int len;
+    errFlag = (readcheck(hand,&len,sizeof(len)) != sizeof(len));
+    if (errFlag) return;
+
+    errFlag = (readcheck(hand,ptr,len) != len);
+}
