+static inline short _NEAR_ LIBENTRY srotl(uint Val, uint RotVal) {
+  #ifdef __BORLANDC__
+    return(_rotl(Val,RotVal));
+  #else
+    int LongVal = Val;
+    LongVal = _rotl(LongVal,RotVal);
+    Val = (LongVal & 0xFFFF) | (LongVal >> 16);
+    return(Val);
+  #endif
