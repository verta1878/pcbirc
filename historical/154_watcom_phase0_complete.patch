+void  removecodes(char *Str) {
+  char *p;
+
+  if (Str[0] == ' ' && ((p = strchr(Str,'|')) != NULL))
+    *p = ' ';
+
+  while ((p = strchr(Str,'@')) != NULL) {
+    if (p[1] == 'X' && isxdigit(p[2]) && isxdigit(p[3])) {
+      memcpy(p,p+4,strlen(p+4)+1);
+      Str = p;
+    } else Str = p + 1;
+  }
+}
