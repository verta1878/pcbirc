+static void near  getdirtoedit(int BoardNumber) {
+  bool FirstTime;
+
+  FirstTime = TRUE;
+  do {
+    TotalLines = 0;
+    TotalParents = 0;
+    setcursor(CUR_NORMAL);
+    clscolor(Colors[OUTBOX]);
+    generalscreen(MainHead1,"Directory Selection");
+    readregulardirs(BoardNumber,FirstTime);
+    FirstTime = FALSE;
+  } while (KeyFlags != ESC);
+}
+
+
+void  confgetdirtoedit(void) {
+  unsigned ConfSel;
+
+  ConfSel = MenuSelection + 1;
+  if (ConfSel > PcbData.NumConf) {
+    beep();
+    KeyFlags = ESC;
+    return;
+  }
+
+#ifdef DEMO
+  if (ConfSel != 1) {
+    beep();
+    memset(&MsgData,0,sizeof(MsgData));
+    MsgData.Save    = TRUE;
+    MsgData.AutoBox = TRUE;
+    MsgData.Line1   = 18;
+    MsgData.Msg1    = "In the DEMO version only the first conference is selectable";
+    MsgData.Color1  = Colors[HEADING];
+    showmessage();
+    KeyFlags = ESC;
+    return;
+  }
+#endif
+  getdirtoedit(ConfSel);
+}
+
+
+void  maingetdirtoedit(void) {
+  getdirtoedit(0);
+}
