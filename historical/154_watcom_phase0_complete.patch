+// C++ class for implementing routines that track a list of non-duplicate
+// items in an array.
+
+#ifndef __UNIQUELIST__
+#define __UNIQUELIST__
+
+#ifdef  VMDATA
+#ifndef VMDATA_INCLUDED
+#include <vmdata.h>
+#endif  // VMDATA_INCLUDED
+#endif  // VMDATA
