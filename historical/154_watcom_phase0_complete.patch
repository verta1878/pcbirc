-  char *p;
-  char *LastChar;
-
-  stripright(SrchCriteria,' ');
-  Len = strlen(SrchCriteria);
-  if (Len > 0 && Len < 12) {
-    LastChar = &SrchCriteria[Len-1];
-    if ((p = strchr(SrchCriteria,'.')) == NULL) {
-      if (Len < 8 && *LastChar != '*')
