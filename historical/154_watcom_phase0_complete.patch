+  #ifndef LIB
+    /* If the date of the PCBOARD.DAT file is less than 11/10/94 then lets  */
+    /* force the swap switch ON.  This is to help reduce tech support calls */
+    /* by upgrading older systems to SWAP=TRUE automatically.  In order for */
