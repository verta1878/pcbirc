+int  getText(char * s, char * buf)
+{
+    setXY(1,statOn ? MAX_ROWS-1 : MAX_ROWS);
+    setAttr(statAttr);
+    wrStr(s);
+    cle();
+
+    char cur[256+1];
+    strcpy(cur,buf);
+
+    if (getStr(cur,256,F_ALL))
+    {
+        strcpy(buf,cur);
+        return TRUE;
+    }
+
+    return FALSE;
+}
