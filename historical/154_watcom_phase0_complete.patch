+*  Returns :  The number of security levels found.
+*/
+
+int  getsecurity(char *Table) {
+  char    Buf[256];
+  DOSFILE TextFile;
+  int     X;
+
+  X = 0;
+  if (dosfopen(PcbData.PwdFile,OPEN_READ|OPEN_DENYNONE,&TextFile) != -1) {
+    while (dosfgets(Buf,256,&TextFile) != -1) {
+      parse(Buf);
+      *Table = atoi(parse(NULL));
+      Table++;
+      X++;
+    }
+    dosfclose(&TextFile);
+  }
+  return(X);
+}
