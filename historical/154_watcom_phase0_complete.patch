-void pascal noBlock(void)
-{
-    llcOff = -1;
-    startBlockLine = endBlockLine = -1;
-    startBlockOff  = endBlockOff  =  0;
-    startBlockLen  = endBlockLen  =  0;
-    blockType      = 0;
-}
