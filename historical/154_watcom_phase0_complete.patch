+static void near LIBENTRY dump(char *Buf, int NumBytes, char InOut) {
+  long Ticks;
+
+  Ticks = (getticks() & 0xFFFFFFL) + ((long) InOut << 24);
+
+  if (Buf == NULL)
+    dosfwrite(&Ticks,4,&FossilDump);
+  else {
+    for (; NumBytes > 0; NumBytes--, Buf++) {
