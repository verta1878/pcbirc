+static void near  substitutepath(char *Path) {
+  char Temp[60];
+
+  if (SubstLen == 0)
+    return;
+
+  if (memcmp(Path,Work.SubstOld,SubstLen) == 0) {
+    strcpy(Temp,Work.SubstNew);
+    strcat(Temp,&Path[strlen(Work.SubstOld)]);
+    strcpy(Path,Temp);
+  }
+}
