-/********************************************************************
-*
-*  Function: inrange()
-*
-*  Desc    : Scans the security level table for a match with the Security level
-*            passed to it (SecLevel).
-*
-*  Returns : TRUE if a match is found, FALSE otherwise.
-*/
-
-static bool near pascal inrange(int SecLevel, int Max) {
-  SecTableType *p;
