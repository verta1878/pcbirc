+/* Opaque structs â€” internal layout not needed by PCBoard code */
+typedef struct CODE4_s {
+    int  errorCode;
+    int  accessMode;
+    int  readOnly;
+    int  safety;
+    int  autoOpen;
+    int  exclusive;
+    char reserved[256];
+} CODE4;
