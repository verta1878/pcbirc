-static VOID LIBENTRY SetSysMenu(HWND hDlg)
-{
-    HWND     hSysMenu;
-    MENUITEM Mi;
-    ULONG    Pos;
-    MRESULT  Id;
-    SHORT    cItems;
-
-    /******************************************************************/
-    /*  We only want Move and Close in the system menu.               */
